---
interface Props {
  nom: string;
  specialite: string;
  description: string;
  expertiseHref: string;
  photo?: string;
}

const { nom, specialite, description, expertiseHref, photo } = Astro.props;
---

<article class="card" aria-label={`Profil de ${nom}`}>
  <div class="card-photo">
    {photo
      ? <img src={photo} alt={`Photo de ${nom}`} width="400" height="533" loading="lazy" />
      : (
        <>
          <svg viewBox="0 0 80 80" fill="none" aria-hidden="true">
            <circle cx="40" cy="30" r="16" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
            <path d="M 10,72 C 10,52 70,52 70,72" stroke="currentColor" stroke-width="1.5" opacity="0.4" fill="none" stroke-linecap="round"/>
          </svg>
          <span>Photo à venir</span>
        </>
      )
    }
  </div>
  <header>
    <h3>{nom}</h3>
    <p><strong>Droit Pénal</strong> — {specialite}</p>
  </header>
  <p>{description}</p>
  <a href={expertiseHref}>Voir le domaine</a>
</article>

<style>
  .card-photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: var(--fond);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--gris);
  }

  .card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .card-photo svg {
    width: 48px;
    height: 48px;
    color: var(--gris-clair);
  }

  .card-photo span {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gris-clair);
    font-weight: 600;
  }
</style>
