---
const nav = [
  { label: 'Accueil', href: '/custos-avocats/' },
  { label: 'Valeurs du cabinet', href: '/custos-avocats/les-valeurs-du-cabinet' },
  { label: 'Équipe', href: '/custos-avocats/equipe' },
  { label: "Domaines & Honoraires", href: '/custos-avocats/honoraires' },
];
---

<header>
  <a href="/custos-avocats/" class="logo-link" aria-label="Custos Avocats — Accueil">
    <img
      src="/custos-avocats/logo-header.png"
      alt="Custos Avocats"
      class="logo"
      width="113"
      height="64"
    />
  </a>

  <nav aria-label="Navigation principale">
    <ul>
      {nav.map(({ label, href }) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <a href="/custos-avocats/contact" class="cta" aria-label="Prendre rendez-vous">
    Nous contacter
  </a>
</header>

<style>
  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo {
    height: 64px;
    width: auto;
    display: block;
  }

  @media (max-width: 640px) {
    .logo { height: 48px; }
  }
</style>
