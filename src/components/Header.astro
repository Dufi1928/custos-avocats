---
const nav = [
  { label: 'Accueil', href: '/custos-avocats/' },
  { label: 'Les valeurs du cabinet', href: '/custos-avocats/les-valeurs-du-cabinet' },
  { label: 'Équipe', href: '/custos-avocats/equipe' },
  { label: "Domaine d'intervention", href: '/custos-avocats/expertises/droit-penal' },
  { label: 'Honoraires', href: '/custos-avocats/honoraires' },
  { label: 'Contact', href: '/custos-avocats/contact' },
];
---

<header>
  <a href="/custos-avocats/" class="logo-link" aria-label="Custos Avocats — Accueil">
    <img
      src="/custos-avocats/logo-emblem.png"
      alt=""
      class="logo-emblem"
      width="48"
      height="56"
      aria-hidden="true"
    />
    <span class="logo-nom">Custos Avocats</span>
  </a>

  <nav aria-label="Navigation principale">
    <ul>
      {nav.map(({ label, href }) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <a href="/custos-avocats/contact" class="cta" aria-label="Prendre rendez-vous">
    Nous contacter
  </a>
</header>

<style>
  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .logo-emblem {
    height: 52px;
    width: auto;
    display: block;
    flex-shrink: 0;
  }

  .logo-nom {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--texte);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .logo-emblem { height: 40px; }
    .logo-nom { font-size: 1.15rem; }
  }
</style>
