---
const expertises = [
  { label: 'Droit Pénal', href: '/expertises/droit-penal' },
  { label: 'Droit des Mineurs', href: '/expertises/droit-des-mineurs' },
  { label: 'Droit des Étrangers', href: '/expertises/droit-des-etrangers' },
  { label: 'Droit de la Famille', href: '/expertises/droit-de-la-famille' },
  { label: 'Droit Pénal des Affaires', href: '/expertises/droit-penal-des-affaires' },
  { label: 'Dommages Corporels', href: '/expertises/dommages-corporels' },
];
---

<footer>
  <section aria-label="Custos Avocats">
    <a href="/" class="footer-logo-link" aria-label="Custos Avocats — Accueil">
      <img
        src="/logo-emblem.png"
        alt="Emblème Custos Avocats"
        class="footer-emblem"
        width="48"
        height="56"
      />
    </a>
    <p>Cabinet d'avocats spécialisé en droit pénal. Disponible 24h/24 pour vous défendre.</p>
  </section>

  <nav aria-label="Plan du site — Domaine d'intervention">
    <h3>Domaine d'intervention</h3>
    <ul>
      {expertises.map(({ label, href }) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </nav>

  <nav aria-label="Plan du site — Cabinet">
    <h3>Cabinet</h3>
    <ul>
      <li><a href="/les-valeurs-du-cabinet">Les valeurs du cabinet</a></li>
      <li><a href="/equipe">Notre équipe</a></li>
      <li><a href="/honoraires">Honoraires</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
  </nav>

  <section aria-label="Informations légales">
    <p>
      <a href="/mentions-legales">Mentions légales</a>
    </p>
    <p>&copy; {new Date().getFullYear()} Custos Avocats — Tous droits réservés</p>
  </section>
</footer>

<style>
  .footer-logo-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-bottom: 0.75rem;
  }

  .footer-emblem {
    height: 56px;
    width: auto;
    flex-shrink: 0;
  }
</style>
