---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Contactez le cabinet Custos Avocats — Barreau de Lille.">
  <section aria-label="Coordonnées du cabinet" class="contact-intro">
    <img src="/custos-avocats/justice-audience2.png" alt="" aria-hidden="true" class="justice-audience-deco" />
    <div class="contact-intro-content">
    <h1>Contact</h1>
    <address>
      <p>
        <strong>Téléphone :</strong>
        <a href="tel:+33XXXXXXXXX">+33 X XX XX XX XX</a>
      </p>
      <p>
        <strong>Email :</strong>
        <a href="mailto:contact@custos-avocats.fr">contact@custos-avocats.fr</a>
      </p>
    </address>

    <div class="reseaux">
      <strong>Retrouvez-nous</strong>
      <ul class="reseaux-list">
        <li>
          <a href="https://www.linkedin.com/company/custos-avocats" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Custos Avocats">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.27c-.97 0-1.75-.79-1.75-1.76s.78-1.76 1.75-1.76 1.75.79 1.75 1.76-.78 1.76-1.75 1.76zm13.5 11.27h-3v-5.6c0-1.34-.03-3.07-1.87-3.07-1.87 0-2.16 1.46-2.16 2.97v5.7h-3v-10h2.88v1.36h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.6 2 3.6 4.59v5.61z"/></svg>
            LinkedIn
          </a>
        </li>
        <li>
          <a href="https://www.instagram.com/custos.avocats" target="_blank" rel="noopener noreferrer" aria-label="Instagram de Custos Avocats">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.334 3.608 1.308.975.975 1.246 2.242 1.308 3.608.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.062 1.366-.334 2.633-1.308 3.608-.975.975-2.242 1.246-3.608 1.308-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.062-2.633-.334-3.608-1.308-.975-.975-1.246-2.242-1.308-3.608-.058-1.266-.07-1.646-.07-4.85s.012-3.584.07-4.85c.062-1.366.334-2.633 1.308-3.608.975-.975 2.242-1.246 3.608-1.308 1.266-.058 1.646-.07 4.85-.07zm0-2.163c-3.259 0-3.667.014-4.947.072-1.52.069-2.948.41-4.024 1.486-1.076 1.076-1.417 2.504-1.486 4.024-.058 1.28-.072 1.688-.072 4.947s.014 3.667.072 4.947c.069 1.52.41 2.948 1.486 4.024 1.076 1.076 2.504 1.417 4.024 1.486 1.28.058 1.688.072 4.947.072s3.667-.014 4.947-.072c1.52-.069 2.948-.41 4.024-1.486 1.076-1.076 1.417-2.504 1.486-4.024.058-1.28.072-1.688.072-4.947s-.014-3.667-.072-4.947c-.069-1.52-.41-2.948-1.486-4.024-1.076-1.076-2.504-1.417-4.024-1.486-1.28-.058-1.688-.072-4.947-.072zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
            Instagram
          </a>
        </li>
      </ul>
    </div>
    </div>
  </section>

  <section aria-label="Formulaire de contact" class="form-section">
    <h2 class="form-titre">Nous écrire</h2>
    <div class="form-avec-plantes">
      <img src="/custos-avocats/plant-lierre.png" alt="" aria-hidden="true" class="form-plant form-plant-gauche" />
      <div class="form-cadre">
      <form method="POST" action="#" novalidate>
        <div>
          <label for="nom">Nom complet</label>
          <input type="text" id="nom" name="nom" autocomplete="name" required aria-required="true" />
        </div>
        <div>
          <label for="email">Adresse email</label>
          <input type="email" id="email" name="email" autocomplete="email" required aria-required="true" />
        </div>
        <div>
          <label for="telephone">Téléphone</label>
          <input type="tel" id="telephone" name="telephone" autocomplete="tel" />
        </div>
        <div>
          <label for="sujet">Objet de votre demande</label>
          <select id="sujet" name="sujet" required aria-required="true">
            <option value="">Sélectionner</option>
            <option value="garde-a-vue">Garde à vue</option>
            <option value="droit-des-mineurs">Droit des Mineurs</option>
            <option value="droit-des-etrangers">Droit des Étrangers</option>
            <option value="droit-de-la-famille">Droit de la Famille</option>
            <option value="droit-penal-des-affaires">Droit Pénal des Affaires</option>
            <option value="dommages-corporels">Dommages Corporels</option>
            <option value="autre">Autre</option>
          </select>
        </div>
        <div>
          <label for="message">Votre message</label>
          <textarea id="message" name="message" rows="6" required aria-required="true"></textarea>
        </div>
        <button type="submit">Envoyer le message</button>
      </form>
    </div>
      <img src="/custos-avocats/plant-lierre.png" alt="" aria-hidden="true" class="form-plant form-plant-droite" />
    </div>
  </section>

  <section aria-label="Localisation" class="localisation-section">
    <h2>Nous trouver</h2>
    <div class="localisation-grid">
      <div>
        <div class="adresse-bloc">
          <strong>Custos Avocats</strong>
          <address>
            [Numéro et nom de rue]<br />
            59100 Roubaix<br />
            France
          </address>
        </div>
      </div>
      <div class="maps-placeholder">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d40970.94!2d3.1221!3d50.6928!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c2d48de51a3889%3A0x40af13e8162bf10!2sRoubaix%2C%2059100!5e0!3m2!1sfr!2sfr!4v1699999999"
          width="100%"
          height="100%"
          style="border:0; border-radius: var(--radius);"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Localisation Custos Avocats — Roubaix"
        ></iframe>
      </div>
    </div>
  </section>
</Base>

<!-- ── Chatbot flottant (visuel) ── -->
<div class="chatbot-bubble" aria-label="Assistant virtuel" role="button" tabindex="0">
  <div class="chatbot-label">Un conseil ?</div>
  <div class="chatbot-btn">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <circle cx="8.5" cy="10.5" r="1" fill="currentColor"/>
      <circle cx="12" cy="10.5" r="1" fill="currentColor"/>
      <circle cx="15.5" cy="10.5" r="1" fill="currentColor"/>
    </svg>
  </div>
</div>

<style>
  .chatbot-bubble {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    z-index: 999;
    cursor: pointer;
  }

  .chatbot-label {
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-radius: 20px;
    padding: 0.4rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--texte);
    box-shadow: 0 2px 12px rgba(0,0,0,0.1);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
  }

  .chatbot-bubble:hover .chatbot-label,
  .chatbot-bubble:focus .chatbot-label {
    opacity: 1;
    transform: translateY(0);
  }

  .chatbot-btn {
    width: 54px;
    height: 54px;
    background: var(--vert);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(74, 93, 78, 0.45);
    transition: background 0.25s, transform 0.2s;
    color: #F4F5F2;
  }

  .chatbot-btn svg {
    width: 22px;
    height: 22px;
  }

  .chatbot-bubble:hover .chatbot-btn {
    background: #3a4a3e;
    transform: scale(1.06);
  }
</style>

<style>
  .contact-intro {
    position: relative;
    overflow: hidden;
  }

  .contact-intro-content {
    position: relative;
    z-index: 1;
  }

  .justice-audience-deco {
    position: absolute;
    bottom: -10px;
    right: -10px;
    width: 420px;
    opacity: 0.22;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* ── Section formulaire ── */
  .form-section {
    overflow: visible;
  }

  .form-titre {
    text-align: center;
  }

  .form-avec-plantes {
    display: grid;
    grid-template-columns: 200px 1fr 200px;
    align-items: stretch;
    gap: 2rem;
  }

  .form-plant {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top center;
    opacity: 0.75;
    pointer-events: none;
    user-select: none;
  }

  .form-plant-droite {
    transform: scaleX(-1);
  }

  @media (max-width: 760px) {
    .form-avec-plantes {
      grid-template-columns: 1fr;
    }
    .form-plant { display: none; }
  }

  /* ── Cadre formulaire ── */
  .form-cadre {
    position: relative;
    border: 1px solid var(--gris-clair);
    border-left: 3px solid var(--vert);
    border-radius: var(--radius);
    padding: 2rem 2rem 2rem 2.25rem;
    background: var(--blanc);
  }

  .form-cadre::before,
  .form-cadre::after {
    content: '';
    position: absolute;
    left: -3px;
    width: 3px;
    background: var(--vert);
    opacity: 0.25;
  }

  .form-cadre::before {
    top: 0;
    height: 30%;
  }

  .form-cadre::after {
    bottom: 0;
    height: 30%;
  }

  .form-cadre form {
    max-width: 100%;
    margin-top: 0;
  }

  .reseaux {
    margin-top: 1.5rem;
  }

  .reseaux strong {
    display: block;
    font-size: 0.825rem;
    color: var(--gris);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .reseaux-list {
    display: flex;
    flex-direction: row !important;
    gap: 1rem !important;
    margin-top: 0 !important;
  }

  .reseaux-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    color: var(--vert);
    text-decoration: none;
    font-weight: 500;
    border: none;
    padding: 0;
    transition: color 0.25s;
  }

  .reseaux-list a:hover {
    color: var(--vert-vif);
    background: none;
  }

  .localisation-section h2 { margin-bottom: 1.5rem; text-align: center; }

  .localisation-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    align-items: start;
    max-width: 820px;
    margin-inline: auto;
  }

  .maps-placeholder {
    min-height: 220px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--gris-clair);
  }

  @media (max-width: 640px) {
    .localisation-grid { grid-template-columns: 1fr; }
  }

  .adresse-bloc {
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-left: 3px solid var(--vert);
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem;
    display: block;
    width: 100%;
  }

  .adresse-bloc strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--texte);
    margin-bottom: 0.5rem;
  }

  .adresse-bloc address {
    font-size: 0.95rem;
    color: var(--anthracite);
    line-height: 1.8;
  }
</style>
