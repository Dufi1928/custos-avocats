---
import Base from '../../layouts/Base.astro';
import { avocatsRdv } from '../../data/avocats-rdv';

const joursNoms: Record<string, string> = {
  '1': 'lun.', '2': 'mar.', '3': 'mer.', '4': 'jeu.', '5': 'ven.', '6': 'sam.', '0': 'dim.',
};

const avocatsData = avocatsRdv.map(a => ({
  slug:      a.slug,
  titre:     a.titre,
  specialite: a.specialite,
  photo:     a.photo,
  jours:     Object.keys(a.schedule).sort().map(k => joursNoms[k]).join(' · '),
}));
---

<Base
  title="Prendre rendez-vous — Custos Avocats"
  description="Réservez un rendez-vous avec l'avocat de votre choix au cabinet Custos Avocats à Roubaix."
>
  <div id="rdv-page">

    <!-- ── Hero ── -->
    <section class="rdv-hero-index" aria-label="Prise de rendez-vous">
      <h1>Prendre rendez-vous</h1>
      <p class="rdv-hero-sub">Choisissez l'avocat avec lequel vous souhaitez consulter, ou continuez sans préférence pour voir toutes les disponibilités.</p>
    </section>

    <!-- ── Choix avocat ── -->
    <section class="rdv-chooser-section" aria-label="Choisir un avocat">
      <div class="rdv-chooser-grid">

        {avocatsData.map(a => (
          <a href={`/rdv/${a.slug}`} class="rdv-card" aria-label={`Prendre rendez-vous avec ${a.titre}`}>
            <div class="rdv-card-photo">
              <img src={a.photo} alt={a.titre} onerror="this.parentElement.classList.add('rdv-card-photo--empty')" />
            </div>
            <div class="rdv-card-body">
              <span class="rdv-card-specialite">Droit Pénal — {a.specialite}</span>
              <strong class="rdv-card-nom">{a.titre}</strong>
              <span class="rdv-card-jours">{a.jours}</span>
            </div>
          </a>
        ))}

        <!-- Card sans préférence -->
        <a href="/rdv/sans-preference" class="rdv-card rdv-card--sanspref" aria-label="Voir toutes les disponibilités">
          <div class="rdv-card-photo rdv-card-photo--icon">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.5291 7.77C17.4591 7.76 17.3891 7.76 17.3191 7.77C15.7691 7.72 14.5391 6.45 14.5391 4.89C14.5391 3.3 15.8291 2 17.4291 2C19.0191 2 20.3191 3.29 20.3191 4.89C20.3091 6.45 19.0791 7.72 17.5291 7.77Z"/>
              <path d="M20.7916 14.7004C19.6716 15.4504 18.1016 15.7304 16.6516 15.5404C17.0316 14.7204 17.2316 13.8104 17.2416 12.8504C17.2416 11.8504 17.0216 10.9004 16.6016 10.0704C18.0816 9.8704 19.6516 10.1504 20.7816 10.9004C22.3616 11.9404 22.3616 13.6504 20.7916 14.7004Z"/>
              <path d="M6.44016 7.77C6.51016 7.76 6.58016 7.76 6.65016 7.77C8.20016 7.72 9.43016 6.45 9.43016 4.89C9.43016 3.29 8.14016 2 6.54016 2C4.95016 2 3.66016 3.29 3.66016 4.89C3.66016 6.45 4.89016 7.72 6.44016 7.77Z"/>
              <path d="M6.55109 12.8506C6.55109 13.8206 6.76109 14.7406 7.14109 15.5706C5.73109 15.7206 4.26109 15.4206 3.18109 14.7106C1.60109 13.6606 1.60109 11.9506 3.18109 10.9006C4.25109 10.1806 5.76109 9.89059 7.18109 10.0506C6.77109 10.8906 6.55109 11.8406 6.55109 12.8506Z"/>
              <path d="M12.1208 15.87C12.0408 15.86 11.9508 15.86 11.8608 15.87C10.0208 15.81 8.55078 14.3 8.55078 12.44C8.56078 10.54 10.0908 9 12.0008 9C13.9008 9 15.4408 10.54 15.4408 12.44C15.4308 14.3 13.9708 15.81 12.1208 15.87Z"/>
              <path d="M8.87078 17.9406C7.36078 18.9506 7.36078 20.6106 8.87078 21.6106C10.5908 22.7606 13.4108 22.7606 15.1308 21.6106C16.6408 20.6006 16.6408 18.9406 15.1308 17.9406C13.4208 16.7906 10.6008 16.7906 8.87078 17.9406Z"/>
            </svg>
          </div>
          <div class="rdv-card-body">
            <span class="rdv-card-specialite">Tous les avocats</span>
            <strong class="rdv-card-nom">Sans préférence</strong>
            <span class="rdv-card-jours">Voir toutes les disponibilités</span>
          </div>
        </a>

      </div>
    </section>

  </div>
</Base>

<style is:global>
  #rdv-page > section {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 4rem var(--gap);
    border-bottom: 1px solid var(--gris-clair);
  }

  /* ── Hero ── */
  .rdv-hero-index h1 { margin-bottom: 0.75rem; }
  .rdv-hero-sub {
    font-size: 1rem;
    color: var(--anthracite);
    max-width: 52ch;
    margin: 0 !important;
  }

  /* ── Grille ── */
  .rdv-chooser-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  /* ── Card ── */
  .rdv-card {
    display: flex !important;
    flex-direction: row !important;
    background: var(--blanc);
    border: 1px solid var(--gris-clair) !important;
    border-radius: 0.75rem;
    padding: 0 !important;
    text-decoration: none !important;
    color: var(--texte) !important;
    transition: border-color 0.22s, box-shadow 0.22s, transform 0.22s;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  }

  .rdv-card:hover {
    border-color: var(--vert) !important;
    box-shadow: 0 6px 24px rgba(74,93,78,0.14);
    background: var(--blanc) !important;
    color: var(--texte) !important;
    transform: translateY(-3px);
    opacity: 1 !important;
  }

  /* Photo */
  .rdv-card-photo {
    flex: 0 0 33%;
    width: 33%;
    overflow: hidden;
    background: var(--fond);
    align-self: stretch;
  }

  .rdv-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.35s ease;
  }

  .rdv-card:hover .rdv-card-photo img { transform: scale(1.04); }

  /* Card sans préférence : icône centrée */
  .rdv-card-photo--icon {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(74, 93, 78, 0.06);
    min-height: 110px;
  }

  .rdv-card-photo--icon svg {
    width: 52px;
    height: 52px;
    color: var(--vert);
    opacity: 0.5;
  }

  .rdv-card--sanspref { border-style: dashed !important; }
  .rdv-card--sanspref:hover { border-style: solid !important; }

  /* Corps */
  .rdv-card-body {
    flex: 1;
    padding: 1.25rem 1.25rem 1.25rem 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.4rem;
    min-width: 0;
    border-left: 1px solid var(--gris-clair);
  }

  .rdv-card-specialite {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--vert);
  }

  .rdv-card-nom {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--texte);
    font-weight: 700;
    line-height: 1.2;
  }

  .rdv-card-jours {
    font-size: 0.7rem;
    color: var(--gris);
    margin-top: 0.1rem;
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    #rdv-page > section { padding: 2.5rem 1rem; }
    .rdv-chooser-grid { grid-template-columns: 1fr; }
    .rdv-hero-sub { font-size: 0.9rem; max-width: 100%; }
  }
</style>
