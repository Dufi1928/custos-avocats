---
import Base from '../../layouts/Base.astro';
---

<Base title="Suivi de mon dossier" description="Accédez en toute confidentialité au suivi de votre dossier grâce aux identifiants remis lors de votre premier rendez-vous.">

  <section class="suivi-hero" aria-label="Connexion espace client">
    <div class="suivi-card">

      <div class="suivi-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none">
          <rect x="8" y="20" width="32" height="24" rx="4" stroke="currentColor" stroke-width="2" fill="none"/>
          <path d="M16 20V14a8 8 0 0 1 16 0v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <circle cx="24" cy="32" r="3" fill="currentColor" opacity="0.7"/>
          <line x1="24" y1="35" x2="24" y2="39" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>

      <h1>Suivi de mon dossier</h1>
      <p class="suivi-intro">
        Accédez à l'avancement de votre affaire grâce aux identifiants
        confidentiels remis lors de votre premier rendez-vous.
      </p>

      <form class="suivi-form" id="suivi-form" autocomplete="off" novalidate>
        <div class="field">
          <label for="identifiant">Identifiant dossier</label>
          <input
            type="text"
            id="identifiant"
            name="identifiant"
            placeholder="ex : C-2025-0042"
            autocomplete="off"
            spellcheck="false"
            required
          />
        </div>
        <div class="field">
          <label for="code">Code confidentiel</label>
          <div class="code-wrap">
            <input
              type="password"
              id="code"
              name="code"
              placeholder="••••••"
              autocomplete="off"
              maxlength="12"
              required
            />
            <button type="button" class="toggle-pw" aria-label="Afficher le code" id="toggle-pw">
              <svg class="eye-open" viewBox="0 0 24 24" fill="none">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
              </svg>
              <svg class="eye-closed" viewBox="0 0 24 24" fill="none" style="display:none">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <line x1="1" y1="1" x2="23" y2="23" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        </div>

        <p class="error-msg" id="error-msg" role="alert" aria-live="polite"></p>

        <button type="submit" class="submit-btn">
          Accéder à mon dossier
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </form>

      <p class="suivi-note">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2"/>
          <line x1="8" y1="7" x2="8" y2="11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          <circle cx="8" cy="5" r="0.8" fill="currentColor"/>
        </svg>
        Vos identifiants vous ont été remis en main propre lors de votre premier
        entretien. En cas de perte, contactez directement le cabinet.
      </p>

    </div>
  </section>

</Base>

<style>
  .suivi-hero {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1rem;
  }

  .suivi-card {
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-radius: calc(var(--radius) * 1.5);
    box-shadow: 0 4px 40px rgba(0,0,0,0.07);
    padding: 3rem 2.5rem;
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .suivi-icon {
    width: 64px;
    height: 64px;
    background: #dde8de;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vert);
    margin-bottom: 1.5rem;
  }

  .suivi-icon svg {
    width: 30px;
    height: 30px;
  }

  .suivi-card h1 {
    font-size: 1.5rem;
    margin: 0 0 0.6rem;
    text-align: center;
  }

  .suivi-intro {
    font-size: 0.875rem;
    color: var(--anthracite);
    text-align: center;
    line-height: 1.65;
    max-width: 34ch;
    margin: 0 0 2rem;
  }

  .suivi-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--texte);
    letter-spacing: 0.02em;
  }

  .field input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--gris-clair);
    border-radius: var(--radius);
    font-size: 0.95rem;
    font-family: var(--font-sans);
    color: var(--texte);
    background: var(--fond);
    transition: border-color 0.2s, box-shadow 0.2s;
    max-width: none;
    margin: 0;
    box-sizing: border-box;
  }

  .field input:focus {
    outline: none;
    border-color: var(--vert);
    box-shadow: 0 0 0 3px rgba(74,93,78,0.12);
  }

  .field input.invalid {
    border-color: #c0392b;
  }

  .code-wrap {
    position: relative;
  }

  .code-wrap input {
    padding-right: 3rem;
  }

  .toggle-pw {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--gris);
    padding: 0.25rem;
    display: flex;
    transition: color 0.2s;
  }

  .toggle-pw:hover { color: var(--vert); }
  .toggle-pw svg { width: 18px; height: 18px; }

  .error-msg {
    font-size: 0.82rem;
    color: #c0392b;
    min-height: 1.2em;
    margin: 0;
    text-align: center;
    display: none;
  }

  .error-msg.visible { display: block; }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.85rem 1.5rem;
    background: var(--vert);
    color: #F4F5F2;
    border: none;
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.25s, transform 0.15s;
    margin-top: 0.4rem;
  }

  .submit-btn svg { width: 18px; height: 18px; }
  .submit-btn:hover { background: #3a4a3e; transform: translateY(-1px); }
  .submit-btn:active { transform: translateY(0); }

  .suivi-note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 1.75rem;
    font-size: 0.78rem;
    color: var(--gris);
    line-height: 1.6;
    text-align: left;
    max-width: none;
  }

  .suivi-note svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--vert);
  }

  @media (max-width: 480px) {
    .suivi-card {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  const form     = document.getElementById('suivi-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg') as HTMLElement;
  const togglePw = document.getElementById('toggle-pw') as HTMLButtonElement;
  const codeInput = document.getElementById('code') as HTMLInputElement;
  const eyeOpen   = togglePw.querySelector('.eye-open') as SVGElement;
  const eyeClosed = togglePw.querySelector('.eye-closed') as SVGElement;

  togglePw.addEventListener('click', () => {
    const isHidden = codeInput.type === 'password';
    codeInput.type = isHidden ? 'text' : 'password';
    eyeOpen.style.display   = isHidden ? 'none'  : '';
    eyeClosed.style.display = isHidden ? ''      : 'none';
    togglePw.setAttribute('aria-label', isHidden ? 'Masquer le code' : 'Afficher le code');
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const id   = (document.getElementById('identifiant') as HTMLInputElement).value.trim();
    const code = codeInput.value.trim();

    errorMsg.classList.remove('visible');
    errorMsg.textContent = '';

    if (!id || !code) {
      errorMsg.textContent = 'Veuillez renseigner votre identifiant et votre code.';
      errorMsg.classList.add('visible');
      return;
    }

    const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement;
    submitBtn.textContent = 'Connexion…';
    submitBtn.disabled = true;

    setTimeout(() => {
      sessionStorage.setItem('suivi-id', id);
      window.location.href = '/suivi/dossier';
    }, 700);
  });
</script>
