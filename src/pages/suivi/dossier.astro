        { titre: 'Conclusions finalisées',       done: true,  date: '15 avr. 2025' },
        { titre: 'Mise en état',                 done: true,  date: '02 mai 2025' },
        { titre: 'Transmission des pièces',      done: true,  date: '19 mai 2025' },
        { titre: 'En attente d\'audience',        done: false, active: true },
        { titre: 'Audience',                     done: false, date: '18 août 2026' },
        { titre: 'Décision',                     done: false },
      ],
      evenements: [
        { date: 'Mardi 19 mai 2025',    heure: '11h00', lieu: 'Cabinet Custos Avocats', titre: 'En attente de l\'audience fixée au 18 août 2026', encours: true, complement: [{ cle: 'Statut :', valeur: 'Dossier complet — audience fixée au 18 août 2026' }] },
        { date: 'Lundi 19 mai 2025',    heure: '09h30', lieu: 'Greffe du tribunal', titre: 'Transmission des pièces au greffe', complement: [{ cle: 'Commentaire :', valeur: 'Dossier complet transmis à la juridiction' }] },
        { date: 'Jeudi 02 mai 2025',    heure: '10h00', lieu: 'Cabinet Custos Avocats', titre: 'Mise en état du dossier', complement: [{ cle: 'Commentaire :', valeur: 'Vérification de la complétude des pièces' }] },
        { date: 'Mardi 15 avril 2025',  heure: '14h30', lieu: 'Cabinet Custos Avocats', titre: 'Conclusions finalisées et signées', complement: [{ cle: 'Commentaire :', valeur: 'Version définitive des conclusions de défense' }] },
        { date: 'Vendredi 28 mars 2025', heure: '16h00', lieu: 'Cabinet Custos Avocats', titre: 'Premier jet de conclusions', complement: [{ cle: 'Commentaire :', valeur: 'Rédaction des premières conclusions de défense' }] },
        { date: 'Lundi 03 mars 2025',   heure: '14h30', lieu: 'Cabinet Custos Avocats', titre: 'Premier rendez-vous', complement: [{ cle: 'Avocat :', valeur: 'Maître Rachel ROETYNCK' }, { cle: 'Commentaire :', valeur: 'Analyse de la situation, remise des identifiants de suivi' }] },
      ],
    },
    mineurs: {
      label: 'Droit des mineurs',
      etapes: [
        { titre: '1er rendez-vous',   done: true,  date: '10 avr. 2025' },
        { titre: 'Analyse dossier',   done: true,  date: '18 avr. 2025' },
        { titre: 'Saisine du juge',   done: false, active: true },
        { titre: 'Audience',          done: false },
        { titre: 'Mesure / Décision', done: false },
      ],
      evenements: [
        { date: 'Lundi 22 avril 2025',  heure: '09h00', lieu: 'Cabinet Custos Avocats', titre: 'Préparation de la requête au juge des enfants', encours: true, complement: [{ cle: 'Statut :', valeur: 'Rédaction en cours' }] },
        { date: 'Vendredi 18 avril 2025', heure: '14h00', lieu: 'Cabinet Custos Avocats', titre: 'Analyse du dossier éducatif et pénal', complement: [{ cle: 'Pièces :', valeur: 'Rapports éducatifs et actes de procédure' }] },
