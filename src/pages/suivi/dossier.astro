      ],
    },
    famille: {
      label: 'Droit de la famille',
      etapes: [
        { titre: 'Consultation',       done: true,  date: '20 fév. 2025' },
        { titre: 'Assignation',        done: true,  date: '05 mars 2025' },
        { titre: 'Échange de pièces',  done: false, active: true },
