---
import Base from '../../layouts/Base.astro';
---

<Base title="Mon dossier" description="Suivi confidentiel de votre dossier — Custos Avocats.">

  <section class="dossier-page" aria-label="Suivi de dossier">

    <div class="dossier-header">
      <div class="dossier-meta">
        <span class="dossier-ref" id="dossier-ref">—</span>
        <span class="dossier-badge" id="dossier-proc-label">Procédure pénale</span>
      </div>
      <p class="dossier-cabinet">Cabinet Custos Avocats — Barreau de Lille</p>
    </div>

    <div class="proc-select-wrap" aria-label="Type de procédure">
      <p class="proc-select-label">Type de procédure</p>
      <div class="proc-tabs" role="tablist" id="proc-tabs">
        <button role="tab" aria-selected="true"  data-proc="penal"    class="proc-tab active">Pénal général</button>
        <button role="tab" aria-selected="false" data-proc="mineurs"  class="proc-tab">Droit des mineurs</button>
        <button role="tab" aria-selected="false" data-proc="famille"  class="proc-tab">Droit de la famille</button>
        <button role="tab" aria-selected="false" data-proc="affaires" class="proc-tab">Pénal des affaires</button>
        <button role="tab" aria-selected="false" data-proc="corporel" class="proc-tab">Dommages corporels</button>
        <button role="tab" aria-selected="false" data-proc="etranger" class="proc-tab">Droit des étrangers</button>
      </div>
    </div>

    <!-- Timeline horizontale -->
    <div class="timeline-wrap" id="timeline-wrap" aria-label="Étapes de la procédure">
      <div class="timeline-scroll">
        <div class="timeline" id="timeline"></div>
      </div>
    </div>

    <!-- Étape en cours -->
    <div class="next-step" id="next-step">
      <div class="next-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/>
          <polyline points="12,6 12,12 16,14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <p class="next-label">Étape en cours</p>
        <p class="next-titre" id="next-titre">—</p>
        <p class="next-desc" id="next-desc"></p>
      </div>
    </div>

    <!-- Barre de progression -->
    <div class="progress-wrap" aria-label="Avancement global">
      <div class="progress-bar-bg">
        <div class="progress-bar-fill" id="progress-fill"></div>
      </div>
      <span class="progress-pct" id="progress-pct">0 %</span>
    </div>

    <div class="dossier-contact">
      <p>Une question sur votre dossier ?</p>
      <a href="/contact" class="contact-btn">Contacter le cabinet</a>
    </div>

  </section>

</Base>

<style>
  .dossier-page {
    max-width: 860px;
    margin: 0 auto;
    padding-top: 3rem;
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .dossier-header {
    border-bottom: 1px solid var(--gris-clair);
    padding-bottom: 1.5rem;
  }

  .dossier-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }

  .dossier-ref {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--texte);
  }

  .dossier-badge {
    display: inline-block;
    background: #dde8de;
    color: var(--vert);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid #b8cebb;
  }

  .dossier-cabinet {
    font-size: 0.8rem;
    color: var(--gris);
    margin: 0;
    max-width: none;
  }

  /* ── Onglets procédure ── */
  .proc-select-wrap {
    background: var(--fond);
    border: 1px dashed var(--gris-clair);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }

  .proc-select-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--gris);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
    max-width: none;
  }

  .proc-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .proc-tab {
    background: var(--blanc);
    border: 1.5px solid var(--gris-clair);
    color: var(--texte);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .proc-tab:hover  { border-color: var(--vert); color: var(--vert); }
  .proc-tab.active { background: var(--vert); border-color: var(--vert); color: #F4F5F2; }

  /* ── Timeline horizontale ── */
  .timeline-wrap {
    width: 100%;
    overflow: hidden;
  }

  .timeline-scroll {
    overflow-x: auto;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--gris-clair) transparent;
  }

  .timeline {
    display: flex;
    align-items: flex-start;
    position: relative;
    min-width: max-content;
    padding: 1.5rem 0.5rem 0.5rem;
  }

  /* Ligne de fond */
  .timeline::before {
    content: '';
    position: absolute;
    top: calc(1.5rem + 20px);
    left: calc(0.5rem + 20px);
    right: calc(0.5rem + 20px);
    height: 2px;
    background: var(--gris-clair);
    z-index: 0;
  }

  /* Ligne de progression */
  .timeline-progress-line {
    position: absolute;
    top: calc(1.5rem + 20px);
    left: calc(0.5rem + 20px);
    height: 2px;
    background: var(--vert);
    z-index: 1;
    transition: width 0.8s cubic-bezier(.4,0,.2,1);
    width: 0%;
  }

  /* Chaque étape */
  .etape {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
    flex: 1;
    min-width: 110px;
    max-width: 150px;
    animation: fadeUp 0.35s ease both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .etape-dot {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 3;
    margin-bottom: 0.75rem;
  }

  .etape-dot svg { width: 18px; height: 18px; }

  .etape--done .etape-dot {
    background: var(--vert);
    border: 2px solid var(--vert);
    color: #F4F5F2;
  }

  .etape--active .etape-dot {
    background: #dde8de;
    border: 2.5px solid var(--vert);
    color: var(--vert);
    box-shadow: 0 0 0 5px rgba(74,93,78,0.12);
    animation: pulseRing 2s ease-in-out infinite;
  }

  @keyframes pulseRing {
    0%, 100% { box-shadow: 0 0 0 5px rgba(74,93,78,0.12); }
    50%       { box-shadow: 0 0 0 9px rgba(74,93,78,0.05); }
  }

  .etape--todo .etape-dot {
    background: var(--blanc);
    border: 2px solid var(--gris-clair);
    color: var(--gris-clair);
  }

  .etape-body {
    text-align: center;
    padding: 0 0.25rem;
  }

  .etape-titre {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--texte);
    line-height: 1.3;
    margin: 0 0 0.25rem;
  }

  .etape--todo .etape-titre { color: var(--gris); }

  .etape-date {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--vert);
    margin-top: 0.2rem;
  }

  .etape-en-cours {
    display: block;
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--vert);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-top: 0.2rem;
    animation: blink 1.8s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.45; }
  }

  /* ── Étape en cours ── */
  .next-step {
    display: flex;
    gap: 1rem;
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-left: 4px solid var(--vert);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1.25rem 1.5rem;
    align-items: flex-start;
  }

  .next-icon { color: var(--vert); flex-shrink: 0; margin-top: 2px; }
  .next-icon svg { width: 22px; height: 22px; }

  .next-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--vert);
    margin: 0 0 0.25rem;
    max-width: none;
  }

  .next-titre {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--texte);
    margin: 0 0 0.2rem;
    max-width: none;
  }

  .next-desc {
    font-size: 0.845rem;
    color: var(--anthracite);
    margin: 0;
    max-width: none;
  }

  /* ── Barre de progression ── */
  .progress-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .progress-bar-bg {
    flex: 1;
    height: 8px;
    background: var(--gris-clair);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--vert);
    border-radius: 999px;
    transition: width 0.8s cubic-bezier(.4,0,.2,1);
    width: 0%;
  }

  .progress-pct {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--vert);
    min-width: 3.5ch;
    text-align: right;
  }

  /* ── Contact ── */
  .dossier-contact {
    text-align: center;
    padding-top: 1rem;
    border-top: 1px solid var(--gris-clair);
  }

  .dossier-contact p {
    font-size: 0.875rem;
    color: var(--gris);
    margin-bottom: 0.75rem;
    max-width: none;
  }

  .contact-btn {
    display: inline-block;
    padding: 0.7rem 1.75rem;
    border: 1.5px solid var(--vert);
    color: var(--vert);
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .contact-btn:hover { background: var(--vert); color: #F4F5F2; }
</style>

<script>
  const procedures: Record<string, {
    label: string;
    etapes: { titre: string; desc: string; done?: boolean; active?: boolean; date?: string }[]
  }> = {
    penal: {
      label: 'Procédure pénale',
      etapes: [
        { titre: 'Premier entretien', desc: 'Analyse de votre situation et constitution du dossier.', done: true, date: '03 mars 2025' },
        { titre: 'Analyse des pièces', desc: 'Étude approfondie des pièces et des actes de procédure.', done: true, date: '14 mars 2025' },
        { titre: 'Préparation de la défense', desc: 'Élaboration de la stratégie et rédaction des conclusions.', done: false, active: true },
        { titre: 'Audience', desc: 'Plaidoirie devant le tribunal correctionnel.', done: false },
        { titre: 'Décision', desc: 'Rendu du jugement par le tribunal.', done: false },
      ],
    },
    mineurs: {
      label: 'Droit des mineurs',
      etapes: [
        { titre: 'Premier entretien', desc: 'Analyse de la situation du mineur et de sa famille.', done: true, date: '10 avr. 2025' },
        { titre: 'Analyse du dossier', desc: 'Examen des actes éducatifs et pièces de procédure.', done: true, date: '18 avr. 2025' },
        { titre: 'Saisine du juge', desc: 'Introduction de la procédure devant le juge des enfants.', done: false, active: true },
        { titre: 'Audience', desc: 'Audience devant le juge des enfants ou le tribunal pour enfants.', done: false },
        { titre: 'Mesure / Décision', desc: 'Prononcé de la mesure éducative ou de la sanction pénale.', done: false },
      ],
    },
    famille: {
      label: 'Droit de la famille',
      etapes: [
        { titre: 'Consultation initiale', desc: 'Évaluation de la situation et des enjeux juridiques.', done: true, date: '20 fév. 2025' },
        { titre: 'Assignation', desc: 'Introduction de la procédure devant le juge aux affaires familiales.', done: true, date: '05 mars 2025' },
        { titre: 'Échange de pièces', desc: 'Communication des pièces entre les parties et le tribunal.', done: false, active: true },
        { titre: 'Audience de conciliation', desc: 'Tentative de règlement amiable devant le juge.', done: false },
        { titre: 'Audience au fond', desc: 'Plaidoiries sur le fond du litige familial.', done: false },
        { titre: 'Jugement', desc: 'Rendu de la décision définitive.', done: false },
      ],
    },
    affaires: {
      label: 'Pénal des affaires',
      etapes: [
        { titre: 'Premier entretien', desc: 'Analyse de la situation et des risques pénaux.', done: true, date: '01 avr. 2025' },
        { titre: 'Analyse des actes', desc: 'Étude des actes d\'enquête, convocations et mises en cause.', done: true, date: '12 avr. 2025' },
        { titre: 'Audition / Enquête', desc: 'Assistance lors des auditions et suivi de l\'enquête préliminaire.', done: false, active: true },
        { titre: 'Mise en examen / Renvoi', desc: 'Gestion de la mise en examen ou du renvoi en jugement.', done: false },
        { titre: 'Audience', desc: 'Plaidoirie devant le tribunal correctionnel ou la cour.', done: false },
        { titre: 'Décision', desc: 'Rendu du jugement, voies de recours si nécessaire.', done: false },
      ],
    },
    corporel: {
      label: 'Dommages corporels',
      etapes: [
        { titre: 'Premier entretien', desc: 'Évaluation du préjudice et des voies d\'indemnisation.', done: true, date: '15 mars 2025' },
        { titre: 'Expertise médicale', desc: 'Assistance et suivi lors de l\'expertise médicale contradictoire.', done: true, date: '02 avr. 2025' },
        { titre: 'Consolidation', desc: 'Évaluation du préjudice définitif après consolidation de l\'état de santé.', done: false, active: true },
        { titre: 'Négociation / Saisine', desc: 'Négociation amiable ou introduction d\'une action en justice.', done: false },
        { titre: 'Audience', desc: 'Plaidoirie sur le montant de l\'indemnisation.', done: false },
        { titre: 'Indemnisation', desc: 'Versement de l\'indemnisation après décision ou accord.', done: false },
      ],
    },
    etranger: {
      label: 'Droit des étrangers',
      etapes: [
        { titre: 'Analyse du dossier', desc: 'Examen de la situation administrative et des voies de recours.', done: true, date: '01 avr. 2025' },
        { titre: 'Recours déposé', desc: 'Introduction du recours devant la juridiction compétente (TA, CNDA…).', done: true, date: '11 avr. 2025' },
        { titre: 'Instruction', desc: 'Échange de mémoires et pièces avec la juridiction.', done: false, active: true },
        { titre: 'Audience', desc: 'Plaidoirie devant le tribunal ou la cour.', done: false },
        { titre: 'Décision', desc: 'Rendu de la décision sur votre situation.', done: false },
      ],
    },
  };

  const dossierId = sessionStorage.getItem('suivi-id');
  const procFromSession = sessionStorage.getItem('suivi-proc');

  if (!dossierId) {
    window.location.href = '/suivi';
  }

  document.getElementById('dossier-ref')!.textContent = 'Dossier ' + (dossierId || '—');

  function renderProc(key: string) {
    const proc = procedures[key];
    if (!proc) return;

    document.getElementById('dossier-proc-label')!.textContent = proc.label;

    const timeline = document.getElementById('timeline')!;
    timeline.innerHTML = '';

    const etapes = proc.etapes;
    const doneCount = etapes.filter(e => e.done).length;
    const activeIndex = etapes.findIndex(e => e.active);
    const totalSegments = etapes.length - 1;

    // Largeur de la ligne de progression
    // Si activeIndex > 0, ligne va jusqu'au milieu de l'étape active
    let progressRatio = 0;
    if (doneCount > 0 && totalSegments > 0) {
      progressRatio = (doneCount - 0.5) / totalSegments;
      if (activeIndex >= 0) {
        progressRatio = (activeIndex - 0.5) / totalSegments;
      }
    }

    // Ligne de progression
    const progressLine = document.createElement('div');
    progressLine.className = 'timeline-progress-line';
    timeline.appendChild(progressLine);

    etapes.forEach((etape, i) => {
      const div = document.createElement('div');
      const state = etape.done ? 'done' : etape.active ? 'active' : 'todo';
      div.className = `etape etape--${state}`;
      div.style.animationDelay = `${i * 0.08}s`;

      let dotIcon = '';
      if (etape.done) {
        dotIcon = `<svg viewBox="0 0 24 24" fill="none"><polyline points="20,6 9,17 4,12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
      } else if (etape.active) {
        dotIcon = `<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="5" fill="currentColor"/></svg>`;
      } else {
        dotIcon = `<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/></svg>`;
      }

      const dateTag   = etape.date   ? `<span class="etape-date">${etape.date}</span>` : '';
      const activeTag = etape.active ? `<span class="etape-en-cours">En cours</span>` : '';

      div.innerHTML = `
        <div class="etape-dot">${dotIcon}</div>
        <div class="etape-body">
          <p class="etape-titre">${etape.titre}</p>
          ${dateTag}${activeTag}
        </div>
      `;
      timeline.appendChild(div);
    });

    // Animer la ligne après rendu
    requestAnimationFrame(() => {
      const timelineEl = document.getElementById('timeline')!;
      const totalWidth = timelineEl.scrollWidth - 40 - 40; // marges gauche/droite
      const lineWidth = progressRatio * totalWidth;
      progressLine.style.width = lineWidth + 'px';

      const fill = document.getElementById('progress-fill')!;
      const pctEl = document.getElementById('progress-pct')!;
      const pct = Math.round((doneCount / etapes.length) * 100);
      fill.style.width = pct + '%';
      pctEl.textContent = pct + ' %';
    });

    // Étape en cours
    const activeEtape = etapes.find(e => e.active) || etapes.find(e => !e.done);
    if (activeEtape) {
      document.getElementById('next-titre')!.textContent = activeEtape.titre;
      document.getElementById('next-desc')!.textContent  = activeEtape.desc;
    }
  }

  const tabs = document.querySelectorAll<HTMLButtonElement>('.proc-tab');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      renderProc(tab.dataset.proc!);
    });
  });

  renderProc(procFromSession || 'penal');
</script>
