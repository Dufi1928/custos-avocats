    /* 3 — audience / balance */
    `<svg viewBox="0 0 24 24" fill="none"><line x1="12" y1="3" x2="12" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3 6l9-3 9 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 8l-2 5c0 1.66 1.34 3 3 3s3-1.34 3-3L7 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M19 8l-2 5c0 1.66 1.34 3 3 3s3-1.34 3-3L19 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><line x1="5" y1="21" x2="19" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`,
