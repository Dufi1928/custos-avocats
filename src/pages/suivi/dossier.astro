---
import Base from '../../layouts/Base.astro';
---

<Base title="Mon dossier" description="Suivi confidentiel de votre dossier — Custos Avocats.">
<section class="dossier-page" aria-label="Suivi de dossier">

  <!-- ══ EN-TÊTE ══ -->
  <div class="page-header">
    <div class="page-header-left">
      <div class="header-icon">
        <svg viewBox="0 0 48 48" fill="none">
          <line x1="24" y1="6" x2="24" y2="42" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <path d="M12 12l-5 10c0 3.3 2.7 6 5 6s5-2.7 5-6l-5-10z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M36 12l-5 10c0 3.3 2.7 6 5 6s5-2.7 5-6l-5-10z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M8 42h32" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <path d="M8 12h32" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <h1 class="page-title" id="page-title">SUIVI DU DOSSIER PÉNAL</h1>
        <p class="page-subtitle">Suivez l'avancement de votre dossier comme un colis</p>
      </div>
    </div>
    <div class="page-header-right">
      <div class="header-dossier">
        <p class="header-dossier-num" id="header-dossier-num">—</p>
        <p class="header-dossier-date" id="header-dossier-date">
          <svg viewBox="0 0 16 16" fill="none" width="13" height="13"><rect x="2" y="3" width="12" height="11" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M5 1v4M11 1v4M2 7h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          Ouvert le 03 mars 2025
        </p>
      </div>
      <div class="header-statut">
        <p class="statut-label">STATUT ACTUEL</p>
        <p class="statut-value" id="statut-value">
          <span class="statut-dot"></span>
          <span id="statut-text">—</span>
        </p>
      </div>
    </div>
  </div>

  <!-- ══ ONGLETS ══ -->
  <div class="proc-select-wrap">
    <p class="proc-select-label">Type de procédure</p>
    <div class="proc-tabs" role="tablist" id="proc-tabs">
      <button role="tab" aria-selected="true"  data-proc="penal"    class="proc-tab active">Pénal général</button>
      <button role="tab" aria-selected="false" data-proc="mineurs"  class="proc-tab">Droit des mineurs</button>
      <button role="tab" aria-selected="false" data-proc="famille"  class="proc-tab">Droit de la famille</button>
      <button role="tab" aria-selected="false" data-proc="affaires" class="proc-tab">Pénal des affaires</button>
      <button role="tab" aria-selected="false" data-proc="corporel" class="proc-tab">Dommages corporels</button>
      <button role="tab" aria-selected="false" data-proc="etranger" class="proc-tab">Droit des étrangers</button>
    </div>
  </div>

  <!-- ══ FRISE ══ -->
  <div class="frise-card">
    <div class="frise-scroll">
      <div class="frise-wrapper" id="frise-wrapper">
        <!-- Injecté par JS -->
      </div>
    </div>
  </div>

  <!-- ══ CARTES INFO ══ -->
  <div class="info-bar" id="info-bar">
    <div class="info-card">
      <div class="info-card-icon info-icon--info">
        <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><line x1="12" y1="11" x2="12" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="8" r="0.8" fill="currentColor"/></svg>
      </div>
      <div>
        <p class="info-card-titre">INFORMATION</p>
        <p class="info-card-texte">Les délais varient selon la complexité de l'affaire et la charge des juridictions. Votre avocat reste disponible pour toute question.</p>
      </div>
    </div>
    <div class="info-card">
      <div class="info-card-icon info-icon--action">
        <svg viewBox="0 0 24 24" fill="none"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div>
        <p class="info-card-titre">DERNIÈRE ACTION</p>
        <p class="info-card-texte" id="info-derniere-action">—</p>
      </div>
    </div>
    <div class="info-card">
      <div class="info-card-icon info-icon--next">
        <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div>
        <p class="info-card-titre">PROCHAINE ÉTAPE</p>
        <p class="info-card-texte" id="info-prochaine-etape">—</p>
      </div>
    </div>
  </div>

  <!-- ══ TABLEAU ══ -->
  <div class="chrono-wrap">
    <table class="chrono-table">
      <thead>
        <tr>
          <th class="col-date">Date et heure</th>
          <th class="col-event">Événement</th>
          <th class="col-comp">Complément</th>
        </tr>
      </thead>
      <tbody id="chrono-tbody"></tbody>
    </table>
  </div>

  <!-- Contact -->
  <div class="dossier-contact">
    <img src="/plant-eucalyptus.png" alt="" aria-hidden="true" class="plant-contact" />
    <p>Une question sur votre dossier ?</p>
    <a href="/contact" class="contact-btn">Contacter le cabinet</a>
  </div>

</section>
</Base>

<style>
  :root {
    --col-done:   #4A5D4E;
    --col-active: #5a8a5c;
    --col-todo:   #b8b8b8;
    --col-done-bg: #edf2ee;
    --col-active-bg: #e8f2e8;
  }

  .dossier-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* ── En-tête ── */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-radius: var(--radius);
    padding: 1.75rem 2rem;
    flex-wrap: wrap;
  }

  .page-header-left { display: flex; align-items: center; gap: 1.25rem; }

  .header-icon {
    width: 56px; height: 56px;
    background: var(--col-done-bg);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: var(--col-done);
    flex-shrink: 0;
  }
  .header-icon svg { width: 28px; height: 28px; }

  .page-title {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--texte);
    margin: 0 0 0.2rem;
  }

  .page-subtitle { font-size: 0.85rem; color: var(--gris); margin: 0; max-width: none; }

  .page-header-right { display: flex; gap: 2rem; align-items: flex-start; flex-wrap: wrap; }

  .header-dossier-num {
    font-size: 1rem; font-weight: 800; color: var(--texte);
    margin: 0 0 0.3rem; max-width: none;
  }

  .header-dossier-date {
    display: flex; align-items: center; gap: 0.35rem;
    font-size: 0.82rem; color: var(--gris);
    margin: 0; max-width: none;
  }

  .header-statut {
    border-left: 1px solid var(--gris-clair);
    padding-left: 2rem;
  }

  .statut-label {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gris);
    margin: 0 0 0.5rem; max-width: none;
  }

  .statut-value {
    display: flex; align-items: center; gap: 0.6rem;
    font-size: 0.88rem; font-weight: 800; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--col-active);
    background: var(--col-active-bg);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius);
    margin: 0; max-width: none;
  }

  .statut-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--col-active);
    animation: dotPulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes dotPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* ── Onglets ── */
  .proc-select-wrap {
    background: var(--fond); border: 1px dashed var(--gris-clair);
    border-radius: var(--radius); padding: 1rem 1.25rem;
  }

  .proc-select-label {
    font-size: 0.72rem; font-weight: 700; color: var(--gris);
    text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 0.75rem; max-width: none;
  }

  .proc-tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .proc-tab {
    background: var(--blanc); border: 1.5px solid var(--gris-clair); color: var(--texte);
    padding: 0.4rem 0.9rem; border-radius: 999px; font-family: var(--font-sans);
    font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s; white-space: nowrap;
  }
  .proc-tab:hover  { border-color: var(--vert); color: var(--vert); }
  .proc-tab.active { background: var(--vert); border-color: var(--vert); color: #F4F5F2; }

  /* ══════════════════════════════════════════
     FRISE
     NOTE: tous les éléments de la frise sont créés via JS, donc les styles
     Astro scopés ne s'y appliquent pas. On utilise :global() + styles inline.
  ══════════════════════════════════════════ */
  .frise-card {
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-radius: var(--radius);
    padding: 2.5rem 1.5rem 2rem;
  }

  .frise-wrapper {
    position: relative;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--gris-clair) transparent;
    padding-bottom: 0.5rem;
  }

  /* inner flex row — min-width set by JS */
  .frise-wrapper :global(.frise-row) {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    position: relative;
  }

  /* Étape */
  .frise-wrapper :global(.frise-step) {
    flex: 1 0 0;
    min-width: 110px;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* Bulle icône */
  .frise-wrapper :global(.step-bubble) {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 3;
  }

  .frise-wrapper :global(.step-bubble svg) {
    width: 22px;
    height: 22px;
    display: block;
  }

  /* Numéro */
  .frise-wrapper :global(.step-num) {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    margin-top: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 800;
    color: #fff;
    flex-shrink: 0;
    position: relative;
    z-index: 3;
  }

  /* Corps */
  .frise-wrapper :global(.step-body) {
    text-align: center;
    padding: 0.6rem 0.3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .frise-wrapper :global(.step-label) {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.3;
    margin: 0;
  }

  .frise-wrapper :global(.step-badge) {
    display: inline-block;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
  }

  .frise-wrapper :global(.step-date) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.65rem;
    margin: 0;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(5px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes bubblePulse {
    0%, 100% { box-shadow: 0 0 0 5px rgba(90,138,92,0.15); }
    50%       { box-shadow: 0 0 0 10px rgba(90,138,92,0.05); }
  }

  /* ══ Cartes info ══ */
  .info-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .info-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .info-card-icon {
    width: 40px; height: 40px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .info-card-icon svg { width: 18px; height: 18px; }

  .info-icon--info   { background: #e8f0ff; color: #4a6fa5; }
  .info-icon--action { background: #fff8e6; color: #b57a00; }
  .info-icon--next   { background: var(--col-done-bg); color: var(--col-done); }

  .info-card-titre {
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--texte);
    margin: 0 0 0.35rem; max-width: none;
  }

  .info-card-texte {
    font-size: 0.82rem; color: var(--anthracite);
    line-height: 1.55; margin: 0; max-width: none;
  }

  /* ══ Tableau ══ */
  .chrono-wrap { border: 1px solid #ddd; border-radius: var(--radius); overflow: hidden; }

  .chrono-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }

  .chrono-table thead tr { background: #3a4a3e; color: #F4F5F2; }

  .chrono-table th {
    padding: 0.95rem 1.4rem; text-align: left;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap;
  }

  .col-date { width: 170px; }
  .col-event { width: 44%; }

  .chrono-table tbody tr { border-bottom: 1px solid #e8e8e8; transition: background 0.15s; }
  .chrono-table tbody tr:last-child { border-bottom: none; }
  .chrono-table tbody tr:nth-child(odd)  { background: #fff; }
  .chrono-table tbody tr:nth-child(even) { background: #f6f7f5; }
  .chrono-table tbody tr:hover { background: #edf2ee; }
  .chrono-table td { padding: 1.1rem 1.4rem; vertical-align: top; line-height: 1.5; }

  .td-jour  { display: block; font-weight: 700; font-size: 0.85rem; color: #222; margin-bottom: 0.15rem; }
  .td-heure { font-size: 0.8rem; color: #888; }
  .td-lieu  { display: block; font-size: 0.72rem; font-weight: 800; color: var(--vert); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 0.25rem; }
  .td-titre { display: block; font-size: 0.875rem; color: #222; line-height: 1.4; }

  .td-badge-encours {
    display: inline-block; margin-top: 0.35rem;
    background: #dde8de; color: var(--vert); font-size: 0.65rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.07em; padding: 0.15rem 0.6rem;
    border-radius: 999px; border: 1px solid #b8cebb;
  }

  .td-comp-ligne { display: flex; gap: 0.4rem; font-size: 0.82rem; color: #555; margin-bottom: 0.2rem; line-height: 1.4; }
  .td-comp-cle   { font-weight: 700; color: #333; white-space: nowrap; }

  /* ── Contact ── */
  .dossier-contact {
    position: relative; text-align: center;
    padding: 2rem 1rem; border-top: 1px solid var(--gris-clair); overflow: hidden;
  }

  .plant-contact {
    position: absolute; right: -20px; bottom: -10px; width: 130px;
    opacity: 0.12; pointer-events: none; user-select: none; transform: scaleX(-1);
  }

  .dossier-contact p { font-size: 0.9rem; color: var(--gris); margin-bottom: 1rem; max-width: none; position: relative; z-index: 1; }

  .contact-btn {
    display: inline-block; padding: 0.75rem 2rem;
    border: 1.5px solid var(--vert); color: var(--vert); border-radius: var(--radius);
    font-size: 0.875rem; font-weight: 600; text-decoration: none;
    transition: background 0.2s, color 0.2s; position: relative; z-index: 1;
  }
  .contact-btn:hover { background: var(--vert); color: #F4F5F2; }

  @media (max-width: 900px) {
    .info-bar { grid-template-columns: 1fr; }
    .page-header { flex-direction: column; }
    .header-statut { border-left: none; padding-left: 0; border-top: 1px solid var(--gris-clair); padding-top: 1rem; }
  }

  @media (max-width: 640px) {
    .chrono-table th:last-child, .chrono-table td:last-child { display: none; }
  }
</style>

<script>
  /* ── Icônes SVG (48×48 viewBox, style trait fin) ── */
  const ICONS: Record<string, string> = {
    rdv: `<svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="18" r="7" stroke="currentColor" stroke-width="2.5"/><path d="M10 42c0-7.7 6.3-14 14-14s14 6.3 14 14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`,
    conclusions: `<svg viewBox="0 0 48 48" fill="none"><path d="M14 8h14l8 8v26H14V8z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M28 8v8h8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 24l8-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M18 30l4 4 8-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    conclFin: `<svg viewBox="0 0 48 48" fill="none"><path d="M14 8h14l8 8v26H14V8z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M28 8v8h8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M18 30l4 4 8-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M18 22h12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`,
    scales: `<svg viewBox="0 0 48 48" fill="none"><line x1="24" y1="8" x2="24" y2="40" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M14 16l-5 9c0 2.8 2.2 5 5 5s5-2.2 5-5l-5-9z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M34 16l-5 9c0 2.8 2.2 5 5 5s5-2.2 5-5l-5-9z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 40h28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M10 16h28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`,
    send: `<svg viewBox="0 0 48 48" fill="none"><path d="M6 24h28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M26 14l12 10-12 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><rect x="6" y="10" width="10" height="28" rx="2" stroke="currentColor" stroke-width="2.5"/></svg>`,
    clock: `<svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="15" stroke="currentColor" stroke-width="2.5"/><path d="M24 16v8l7 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`,
    calendar: `<svg viewBox="0 0 48 48" fill="none"><rect x="8" y="12" width="32" height="28" rx="3" stroke="currentColor" stroke-width="2.5"/><path d="M8 20h32M16 8v8M32 8v8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><circle cx="18" cy="30" r="2" fill="currentColor"/><circle cx="24" cy="30" r="2" fill="currentColor"/><circle cx="30" cy="30" r="2" fill="currentColor"/></svg>`,
    gavel: `<svg viewBox="0 0 48 48" fill="none"><rect x="12" y="8" width="16" height="8" rx="2" transform="rotate(45 12 8)" stroke="currentColor" stroke-width="2.5"/><path d="M22 22l-12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M12 38h24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><rect x="12" y="34" width="24" height="8" rx="2" stroke="currentColor" stroke-width="2.5"/></svg>`,
    lock: `<svg viewBox="0 0 48 48" fill="none"><rect x="10" y="22" width="28" height="20" rx="3" stroke="currentColor" stroke-width="2.5"/><path d="M16 22v-6a8 8 0 0 1 16 0v6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><circle cx="24" cy="33" r="3" fill="currentColor" opacity="0.5"/><path d="M24 36v4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`,
    check: `<svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="15" stroke="currentColor" stroke-width="2.5"/><path d="M16 24l6 6 10-10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    search: `<svg viewBox="0 0 48 48" fill="none"><circle cx="22" cy="22" r="12" stroke="currentColor" stroke-width="2.5"/><path d="M32 32l8 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`,
    building: `<svg viewBox="0 0 48 48" fill="none"><path d="M8 40V16l16-8 16 8v24H8z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M18 40V28h12v12" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M8 20h32" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`,
  };

  type Etape = {
    titre: string; icon: string;
    done?: boolean; active?: boolean;
    badge: string; desc: string;
    location?: string; date?: string;
  };
  type Evenement = {
    date: string; heure: string; lieu: string; titre: string;
    encours?: boolean;
    complement?: { cle: string; valeur: string }[];
