---
import Base from '../../layouts/Base.astro';
---

<Base title="Mon dossier" description="Suivi confidentiel de votre dossier — Custos Avocats.">

  <section class="dossier-page" aria-label="Suivi de dossier">

    <!-- En-tête -->
    <div class="dossier-header">
      <img src="/plant-cascade.png"  alt="" aria-hidden="true" class="plant-deco plant-right" />
      <img src="/plant-laurel.png"   alt="" aria-hidden="true" class="plant-deco plant-left" />
      <div class="header-content">
        <p class="header-eyebrow">Espace confidentiel</p>
        <div class="dossier-meta">
          <span class="dossier-ref" id="dossier-ref">—</span>
          <span class="dossier-badge" id="dossier-proc-label">Procédure pénale</span>
        </div>
        <p class="dossier-cabinet">Cabinet Custos Avocats — Barreau de Lille</p>
      </div>
    </div>

    <!-- Onglets -->
    <div class="proc-select-wrap">
      <p class="proc-select-label">Type de procédure</p>
      <div class="proc-tabs" role="tablist" id="proc-tabs">
        <button role="tab" aria-selected="true"  data-proc="penal"    class="proc-tab active">Pénal général</button>
        <button role="tab" aria-selected="false" data-proc="mineurs"  class="proc-tab">Droit des mineurs</button>
        <button role="tab" aria-selected="false" data-proc="famille"  class="proc-tab">Droit de la famille</button>
        <button role="tab" aria-selected="false" data-proc="affaires" class="proc-tab">Pénal des affaires</button>
        <button role="tab" aria-selected="false" data-proc="corporel" class="proc-tab">Dommages corporels</button>
        <button role="tab" aria-selected="false" data-proc="etranger" class="proc-tab">Droit des étrangers</button>
      </div>
    </div>

    <!-- Frise Domino's style -->
    <div class="frise-outer">
      <div class="frise-scroll">
        <div class="frise-band" id="frise-band" role="list"></div>
      </div>
    </div>

    <!-- Tableau Chronopost -->
    <div class="chrono-wrap">
      <table class="chrono-table" id="chrono-table">
        <thead>
          <tr>
            <th class="col-date">Date et heure</th>
            <th class="col-event">Événement</th>
            <th class="col-comp">Complément</th>
          </tr>
        </thead>
        <tbody id="chrono-tbody"></tbody>
      </table>
    </div>

    <!-- Contact -->
    <div class="dossier-contact">
      <img src="/plant-eucalyptus.png" alt="" aria-hidden="true" class="plant-contact" />
      <p>Une question sur votre dossier ?</p>
      <a href="/contact" class="contact-btn">Contacter le cabinet</a>
    </div>

  </section>

</Base>

<style>
  .dossier-page {
    max-width: 920px;
    margin: 0 auto;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ── En-tête ── */
  .dossier-header {
    position: relative;
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-radius: var(--radius);
    padding: 2rem 2.5rem;
    overflow: hidden;
  }

  .plant-deco {
    position: absolute;
    pointer-events: none;
    user-select: none;
    opacity: 0.17;
  }

  .plant-right { top: -10px; right: -15px; width: 175px; }
  .plant-left  { bottom: -10px; left: -10px; width: 120px; transform: scaleX(-1); }

  .header-content { position: relative; z-index: 1; }

  .header-eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--vert);
    margin: 0 0 0.6rem;
    max-width: none;
  }

  .dossier-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }

  .dossier-ref {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--texte);
  }

  .dossier-badge {
    background: #dde8de;
    color: var(--vert);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid #b8cebb;
  }

  .dossier-cabinet { font-size: 0.82rem; color: var(--gris); margin: 0; max-width: none; }

  /* ── Onglets ── */
  .proc-select-wrap {
    background: var(--fond);
    border: 1px dashed var(--gris-clair);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }

  .proc-select-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--gris);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
    max-width: none;
  }

  .proc-tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .proc-tab {
    background: var(--blanc);
    border: 1.5px solid var(--gris-clair);
    color: var(--texte);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .proc-tab:hover  { border-color: var(--vert); color: var(--vert); }
  .proc-tab.active { background: var(--vert); border-color: var(--vert); color: #F4F5F2; }

  /* ── Frise Domino's ── */
  .frise-outer {
    background: #2b3a2e;
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .frise-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .frise-scroll::-webkit-scrollbar { display: none; }

  .frise-band {
    display: flex;
    align-items: stretch;
    min-width: max-content;
    width: 100%;
  }

  /* ── Étapes (style chevron Domino's) ── */
  .frise-step {
    flex: 1;
    min-width: 110px;
    height: 96px;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0 0.5rem 0 1.6rem;
    cursor: default;
    transition: filter 0.2s;
  }

  /* Première étape : bord gauche arrondi, pas d'encoche gauche */
  .frise-step:first-child {
    border-radius: 6px 0 0 6px;
    padding-left: 1rem;
  }

  /* Dernière étape : bord droit arrondi, pas de flèche droite */
  .frise-step:last-child {
    border-radius: 0 6px 6px 0;
  }

  /* Flèche droite via ::after (border trick) */
  .frise-step:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -22px;
    top: 0;
    width: 0;
    height: 0;
    border-top: 48px solid transparent;
    border-bottom: 48px solid transparent;
    border-left: 22px solid var(--step-color, #4A5D4E);
    z-index: 4;
  }

  /* Z-index pour que chaque flèche passe devant la suivante — défini via JS */
  .frise-step { z-index: var(--step-z, 1); }

  /* ── États ── */
  .frise-step--done {
    --step-color: #4A5D4E;
    background: #4A5D4E;
    color: rgba(255,255,255,0.9);
  }

  .frise-step--active {
    --step-color: #3a6b42;
    background: #3a6b42;
    color: #fff;
  }

  .frise-step--todo {
    --step-color: #4a4a4a;
    background: #4a4a4a;
    color: rgba(255,255,255,0.4);
  }

  /* Icône */
  .step-icon { flex-shrink: 0; }
  .step-icon svg { width: 26px; height: 26px; display: block; }

  /* Label */
  .step-label {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    text-align: center;
    line-height: 1.25;
    max-width: 90px;
  }

  /* Date */
  .step-date {
    font-size: 0.6rem;
    opacity: 0.75;
    text-align: center;
  }

  /* Pulsation sur l'étape active */
  .frise-step--active {
    animation: stepPulse 2.5s ease-in-out infinite;
  }

  @keyframes stepPulse {
    0%, 100% { filter: brightness(1); }
    50% { filter: brightness(1.15); }
  }

  /* ── Tableau Chronopost ── */
  .chrono-wrap {
    border: 1px solid #ddd;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .chrono-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .chrono-table thead tr {
    background: #3a4a3e;
    color: #F4F5F2;
  }

  .chrono-table th {
    padding: 0.95rem 1.4rem;
    text-align: left;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .col-date  { width: 170px; }
  .col-event { width: 45%; }
  .col-comp  { }

  /* Corps du tableau */
  .chrono-table tbody tr {
    border-bottom: 1px solid #e8e8e8;
    transition: background 0.15s;
  }

  .chrono-table tbody tr:last-child { border-bottom: none; }
  .chrono-table tbody tr:nth-child(odd)  { background: #fff; }
  .chrono-table tbody tr:nth-child(even) { background: #f6f7f5; }
  .chrono-table tbody tr:hover { background: #edf2ee; }

  .chrono-table td {
    padding: 1.1rem 1.4rem;
    vertical-align: top;
    line-height: 1.5;
  }

  /* Colonne date */
  .td-jour {
    display: block;
    font-weight: 700;
    font-size: 0.85rem;
    color: #222;
    margin-bottom: 0.15rem;
  }

  .td-heure {
    font-size: 0.8rem;
    color: #888;
  }

  /* Colonne événement */
  .td-lieu {
    display: block;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--vert);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 0.25rem;
  }

  .td-titre {
    display: block;
    font-size: 0.875rem;
    color: #222;
    line-height: 1.4;
  }

  .td-badge-encours {
    display: inline-block;
    margin-top: 0.35rem;
    background: #dde8de;
    color: var(--vert);
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    border: 1px solid #b8cebb;
  }

  /* Colonne complément */
  .td-comp-ligne {
    display: flex;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: #555;
    margin-bottom: 0.2rem;
    line-height: 1.4;
  }

  .td-comp-cle {
    font-weight: 700;
    color: #333;
    white-space: nowrap;
  }

  /* ── Contact ── */
  .dossier-contact {
    position: relative;
    text-align: center;
    padding: 2rem 1rem;
    border-top: 1px solid var(--gris-clair);
    overflow: hidden;
  }

  .plant-contact {
    position: absolute;
    right: -20px;
    bottom: -10px;
    width: 130px;
    opacity: 0.13;
    pointer-events: none;
    user-select: none;
    transform: scaleX(-1);
  }

  .dossier-contact p {
    font-size: 0.9rem;
    color: var(--gris);
    margin-bottom: 1rem;
    max-width: none;
    position: relative;
    z-index: 1;
  }

  .contact-btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    border: 1.5px solid var(--vert);
    color: var(--vert);
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
    position: relative;
    z-index: 1;
  }

  .contact-btn:hover { background: var(--vert); color: #F4F5F2; }

  @media (max-width: 640px) {
    .plant-right, .plant-left { display: none; }
    .chrono-table th:last-child,
    .chrono-table td:last-child { display: none; }
    .frise-step { min-width: 90px; }
  }
</style>

<script>
  /* ── Icônes SVG par index d'étape ── */
