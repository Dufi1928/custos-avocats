  const dossierId = sessionStorage.getItem('suivi-id');
  const procFromSession = sessionStorage.getItem('suivi-proc');
  if (!dossierId) { window.location.href = '/suivi'; }
  document.getElementById('header-dossier-num')!.textContent = 'DOSSIER N° ' + (dossierId || '—');

  // ── Palette couleurs (dupliquées ici pour usage inline JS) ──
  const COL = {
    done:   { main: '#4A5D4E', bg: '#edf2ee', txt: '#4A5D4E' },
    active: { main: '#5a8a5c', bg: '#e8f2e8', txt: '#5a8a5c' },
    todo:   { main: '#cccccc', bg: '#f2f2f2', txt: '#bbbbbb' },
  } as const;

  const BUBBLE_PX  = 52;   // diamètre de la bulle
  const LINE_TOP   = BUBBLE_PX / 2; // 26px — centre vertical de la bulle
  const STEP_MIN_W = 120;  // largeur min par étape (px)

  function renderProc(key: string) {
    const proc = procedures[key];
    if (!proc) return;

    const procLabel = { penal: 'PÉNAL', mineurs: 'MINEURS', famille: 'FAMILLE', affaires: 'AFFAIRES', corporel: 'CORPOREL', etranger: 'ÉTRANGERS' }[key] || 'PÉNAL';
    document.getElementById('page-title')!.textContent = 'SUIVI DU DOSSIER — ' + procLabel;
    document.getElementById('statut-text')!.textContent = proc.statut;
    document.getElementById('info-derniere-action')!.textContent = proc.derniereAction;
    document.getElementById('info-prochaine-etape')!.textContent = proc.prochaineEtape;

    /* ══ FRISE ══ */
    const wrapper = document.getElementById('frise-wrapper')!;
    wrapper.innerHTML = '';

    const n = proc.etapes.length;
    const doneCount = proc.etapes.filter(e => e.done).length;
    const activeIdx = proc.etapes.findIndex(e => e.active);

    // ── Inner row (flex, pas de wrap) ──
    const row = document.createElement('div');
    row.className = 'frise-row';
    row.style.minWidth = `${n * STEP_MIN_W}px`;

    // ── Lignes (position: absolute dans .frise-row, tout en inline style) ──
    // Centre de l'étape i en % de la row
    const cx = (i: number) => `${(i + 0.5) / n * 100}%`;
    const cxNum = (i: number) => (i + 0.5) / n * 100;

    const addLine = (
      bg: string,
      leftPct: number,
      widthPct: number,
      dashed = false,
    ) => {
      if (widthPct <= 0) return;
      const d = document.createElement('div');
      d.style.cssText = `
        position: absolute;
        top: ${LINE_TOP}px;
        left: ${leftPct}%;
        width: ${widthPct}%;
        height: 2px;
        z-index: 1;
        background: ${dashed
          ? `repeating-linear-gradient(to right, ${bg} 0, ${bg} 6px, transparent 6px, transparent 13px)`
          : bg};
      `;
      row.appendChild(d);
    };

    // fond gris
    addLine('#e0e0e0', cxNum(0), cxNum(n - 1) - cxNum(0));
    // vert : entre étapes faites
    if (doneCount >= 2) addLine(COL.done.main, cxNum(0), cxNum(doneCount - 1) - cxNum(0));
    // vert clair : dernier done → active
    if (activeIdx >= 0 && doneCount >= 1) addLine(COL.active.main, cxNum(doneCount - 1), cxNum(activeIdx) - cxNum(doneCount - 1));
    // pointillé : active → fin
    if (activeIdx >= 0 && activeIdx < n - 1) addLine(COL.todo.main, cxNum(activeIdx), cxNum(n - 1) - cxNum(activeIdx), true);

    // ── Étapes ── (tous les styles visuels en inline pour bypasser le scope Astro)
    proc.etapes.forEach((etape, i) => {
      const state: 'done' | 'active' | 'todo' = etape.done ? 'done' : etape.active ? 'active' : 'todo';
      const col = COL[state];

      // Conteneur étape
      const step = document.createElement('div');
      step.className = 'frise-step';
      step.style.cssText = `animation: fadeUp 0.35s ease ${i * 0.06}s both;`;

      // Bulle
      const bubble = document.createElement('div');
      bubble.className = 'step-bubble';
      bubble.style.cssText = `
        color: ${col.main};
        border-color: ${state === 'todo' ? '#ddd' : col.main};
        background: ${state === 'done' ? col.bg : state === 'active' ? '#fff' : '#fafafa'};
        ${state === 'active' ? 'border-width: 2.5px; animation: bubblePulse 2.2s ease-in-out infinite;' : ''}
      `;
      bubble.innerHTML = ICONS[etape.icon] || '';

      // Numéro
      const num = document.createElement('div');
      num.className = 'step-num';
      num.textContent = String(i + 1);
      num.style.background = state === 'todo' ? '#ccc' : col.main;

      // Corps
      const body = document.createElement('div');
      body.className = 'step-body';

      const label = document.createElement('strong');
      label.className = 'step-label';
      label.innerHTML = etape.titre.replace(/\n/g, '<br>');
      label.style.color = state === 'todo' ? '#bbb' : col.main;

      const badge = document.createElement('span');
      badge.className = 'step-badge';
      badge.textContent = etape.badge;
      badge.style.cssText = `background: ${col.bg}; color: ${state === 'todo' ? '#bbb' : col.main};`;

      body.appendChild(label);
      body.appendChild(badge);

      if (etape.date) {
        const dateEl = document.createElement('p');
        dateEl.className = 'step-date';
        dateEl.style.color = state === 'todo' ? '#ccc' : '#999';
        dateEl.innerHTML = `<svg viewBox="0 0 14 14" fill="none" width="10" height="10"><rect x="1" y="2" width="12" height="11" rx="1.8" stroke="currentColor" stroke-width="1.4"/><path d="M1 5.5h12M4.5 1v2M9.5 1v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>${etape.date}`;
        body.appendChild(dateEl);
      }

      step.appendChild(bubble);
      step.appendChild(num);
      step.appendChild(body);
      row.appendChild(step);
    });

    wrapper.appendChild(row);

    /* ══ TABLEAU ══ */
    const tbody = document.getElementById('chrono-tbody')!;
    tbody.innerHTML = '';

    proc.evenements.forEach(ev => {
      const tr = document.createElement('tr');
      const compHTML = ev.complement
        ? ev.complement.map(c => `<div class="td-comp-ligne"><span class="td-comp-cle">${c.cle}</span> ${c.valeur}</div>`).join('')
        : '';

      tr.innerHTML = `
        <td><span class="td-jour">${ev.date}</span><span class="td-heure">${ev.heure}</span></td>
        <td>
          <span class="td-lieu">${ev.lieu}</span>
          <span class="td-titre">${ev.titre}</span>
          ${ev.encours ? `<span class="td-badge-encours">En cours</span>` : ''}
        </td>
        <td>${compHTML}</td>`;
      tbody.appendChild(tr);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.proc-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.proc-tab').forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      renderProc(tab.dataset.proc!);
    });
  });

  renderProc(procFromSession || 'penal');
</script>
