          complement: [
            { cle: 'Avocat :', valeur: 'Maître Chloé JAULIN-DENISSELLE' },
            { cle: 'Commentaire :', valeur: 'Identification des voies de recours, stratégie définie' },
          ],
        },
      ],
    },
  };

  const dossierId = sessionStorage.getItem('suivi-id');
  const procFromSession = sessionStorage.getItem('suivi-proc');

  if (!dossierId) { window.location.href = '/suivi'; }
  document.getElementById('dossier-ref')!.textContent = 'Dossier ' + (dossierId || '—');

  function renderProc(key: string) {
    const proc = procedures[key];
    if (!proc) return;

    document.getElementById('dossier-proc-label')!.textContent = proc.label;

    // ── Frise ──
    const friseEl = document.getElementById('frise')!;
    friseEl.innerHTML = '';

    const n = proc.etapes.length;
    const activeIdx = proc.etapes.findIndex(e => e.active);
    const doneCount = proc.etapes.filter(e => e.done).length;

    friseEl.style.gridTemplateColumns = `repeat(${n}, minmax(100px, 1fr))`;

    // Lignes (ajoutées avant les étapes pour rester derrière)
    const bgLine = document.createElement('div');
    bgLine.className = 'frise-bg-line';
    // Positionnée de centre du 1er cercle au centre du dernier
    // En % : left = 50%/n, width = (n-1)/n * 100%
    bgLine.style.left  = `calc(${50 / n}%)`;
    bgLine.style.width = `calc(${(n - 1) / n * 100}%)`;
    friseEl.appendChild(bgLine);

    const progLine = document.createElement('div');
    progLine.className = 'frise-prog-line';
    progLine.style.left = `calc(${50 / n}%)`;
    progLine.style.width = '0';
    friseEl.appendChild(progLine);

    // Étapes
    proc.etapes.forEach((etape, i) => {
      const state = etape.done ? 'done' : etape.active ? 'active' : 'todo';
      const div = document.createElement('div');
      div.className = `frise-etape frise-etape--${state}`;
      div.setAttribute('role', 'listitem');
      div.style.animationDelay = `${i * 0.09}s`;

      const icon = etape.done
        ? `<svg viewBox="0 0 24 24" fill="none"><polyline points="20,6 9,17 4,12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`
        : etape.active
          ? `<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="6" fill="currentColor"/></svg>`
          : `<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2.2"/></svg>`;

      div.innerHTML = `
        <div class="frise-cercle">${icon}</div>
        <div class="frise-label">
          <p class="frise-titre">${etape.titre}</p>
          ${etape.date   ? `<span class="frise-date">${etape.date}</span>` : ''}
          ${etape.active ? `<span class="frise-encours">En cours</span>` : ''}
        </div>`;
      friseEl.appendChild(div);
    });

    // Largeur de la ligne verte
    requestAnimationFrame(() => {
      let ratio = 0;
      if (activeIdx > 0) {
        // Ligne va jusqu'au centre de l'étape active
        ratio = activeIdx / (n - 1);
      } else if (doneCount === n) {
        ratio = 1;
      } else if (doneCount > 0 && activeIdx < 0) {
        ratio = (doneCount - 1) / (n - 1);
      }
      const totalLineWidth = (n - 1) / n * 100;
      progLine.style.width = `calc(${ratio * totalLineWidth}%)`;
    });

    // ── Journal ──
    const body = document.getElementById('journal-body')!;
    body.innerHTML = '';

    proc.evenements.forEach(ev => {
      const row = document.createElement('div');
      row.className = 'journal-row';

      const compHTML = ev.complement
        ? ev.complement.map(c => `<div class="j-comp-ligne"><span class="j-comp-cle">${c.cle}</span> ${c.valeur}</div>`).join('')
        : '';

      row.innerHTML = `
        <div class="j-date">
          <span class="j-jour">${ev.date}</span>
          <span class="j-heure">${ev.heure}</span>
        </div>
        <div class="j-event">
          <span class="j-lieu">${ev.lieu}</span>
          <span class="j-titre">${ev.titre}</span>
          ${ev.encours ? `<span class="j-encours">En cours</span>` : ''}
        </div>
        <div class="j-complement">${compHTML}</div>`;

      body.appendChild(row);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.proc-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.proc-tab').forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      renderProc(tab.dataset.proc!);
    });
  });

  renderProc(procFromSession || 'penal');
</script>
