      label: 'Pénal des affaires',
      etapes: [
        { titre: '1er entretien', done: true,  date: '01 avr. 2025' },
        { titre: 'Analyse actes', done: true,  date: '12 avr. 2025' },
        { titre: 'Enquête',       done: false, active: true },
