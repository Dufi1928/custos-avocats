---
import Base from '../../layouts/Base.astro';
---

<Base title="Mon dossier" description="Suivi confidentiel de votre dossier — Custos Avocats.">

  <section class="dossier-page" aria-label="Suivi de dossier">

    <!-- En-tête -->
    <div class="dossier-header">
      <div class="dossier-meta">
        <span class="dossier-ref" id="dossier-ref">—</span>
        <span class="dossier-badge" id="dossier-proc-label">Procédure pénale</span>
      </div>
      <p class="dossier-cabinet">Cabinet Custos Avocats — Barreau de Lille</p>
    </div>

    <!-- Onglets procédure -->
    <div class="proc-select-wrap">
      <p class="proc-select-label">Type de procédure</p>
      <div class="proc-tabs" role="tablist" id="proc-tabs">
        <button role="tab" aria-selected="true"  data-proc="penal"    class="proc-tab active">Pénal général</button>
        <button role="tab" aria-selected="false" data-proc="mineurs"  class="proc-tab">Droit des mineurs</button>
        <button role="tab" aria-selected="false" data-proc="famille"  class="proc-tab">Droit de la famille</button>
        <button role="tab" aria-selected="false" data-proc="affaires" class="proc-tab">Pénal des affaires</button>
        <button role="tab" aria-selected="false" data-proc="corporel" class="proc-tab">Dommages corporels</button>
        <button role="tab" aria-selected="false" data-proc="etranger" class="proc-tab">Droit des étrangers</button>
      </div>
    </div>

    <!-- Frise chronologique style Chronopost -->
    <div class="frise-wrap">
      <div class="frise-scroll">
        <div class="frise" id="frise"></div>
      </div>
    </div>

    <!-- Tableau de détail -->
    <div class="detail-wrap">
      <table class="detail-table" id="detail-table" aria-label="Détail des événements">
        <thead>
          <tr>
            <th>Date et heure</th>
            <th>Événement</th>
            <th>Complément</th>
          </tr>
        </thead>
        <tbody id="detail-tbody"></tbody>
      </table>
    </div>

    <!-- Contact -->
    <div class="dossier-contact">
      <p>Une question sur votre dossier ?</p>
      <a href="/contact" class="contact-btn">Contacter le cabinet</a>
    </div>

  </section>

</Base>

<style>
  .dossier-page {
    max-width: 900px;
    margin: 0 auto;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ── En-tête ── */
  .dossier-header {
    border-bottom: 1px solid var(--gris-clair);
    padding-bottom: 1.25rem;
  }

  .dossier-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }

  .dossier-ref {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--texte);
  }

  .dossier-badge {
    background: #dde8de;
    color: var(--vert);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid #b8cebb;
  }

  .dossier-cabinet {
    font-size: 0.8rem;
    color: var(--gris);
    margin: 0;
    max-width: none;
  }

  /* ── Onglets ── */
  .proc-select-wrap {
    background: var(--fond);
    border: 1px dashed var(--gris-clair);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }

  .proc-select-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--gris);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
    max-width: none;
  }

  .proc-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .proc-tab {
    background: var(--blanc);
    border: 1.5px solid var(--gris-clair);
    color: var(--texte);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .proc-tab:hover  { border-color: var(--vert); color: var(--vert); }
  .proc-tab.active { background: var(--vert); border-color: var(--vert); color: #F4F5F2; }

  /* ── Frise ── */
  .frise-wrap {
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-radius: var(--radius);
    padding: 2.5rem 2rem 2rem;
    overflow: hidden;
  }

  .frise-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--gris-clair) transparent;
  }

  .frise {
    display: flex;
    align-items: flex-start;
    position: relative;
    min-width: max-content;
    padding-bottom: 0.5rem;
  }

  /* Ligne de fond */
  .frise::before {
    content: '';
    position: absolute;
    top: 28px;
    left: 28px;
    right: 28px;
    height: 3px;
    background: #d8d8d8;
    z-index: 0;
    border-radius: 2px;
  }

  /* Ligne de progression verte */
  .frise-line {
    position: absolute;
    top: 28px;
    left: 28px;
    height: 3px;
    background: var(--vert);
    z-index: 1;
    border-radius: 2px;
    transition: width 0.9s cubic-bezier(.4,0,.2,1);
    width: 0;
  }

  /* Étape */
  .frise-etape {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    min-width: 120px;
    max-width: 160px;
    position: relative;
    z-index: 2;
    animation: fadeIn 0.4s ease both;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .frise-cercle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    position: relative;
    z-index: 3;
    transition: all 0.3s;
  }

  .frise-cercle svg { width: 22px; height: 22px; }

  /* Fait */
  .frise-etape--done .frise-cercle {
    background: #a8b8ab;
    border: 3px solid #a8b8ab;
    color: #fff;
  }

  /* En cours */
  .frise-etape--active .frise-cercle {
    background: var(--vert);
    border: 3px solid var(--vert);
    color: #fff;
    box-shadow: 0 0 0 6px rgba(74,93,78,0.15);
    animation: pulseGreen 2s ease-in-out infinite;
  }

  @keyframes pulseGreen {
    0%, 100% { box-shadow: 0 0 0 6px rgba(74,93,78,0.15); }
    50%       { box-shadow: 0 0 0 11px rgba(74,93,78,0.06); }
  }

  /* À venir */
  .frise-etape--todo .frise-cercle {
    background: #fff;
    border: 3px solid #d0d0d0;
    color: #c0c0c0;
  }

  .frise-label {
    text-align: center;
    padding: 0 0.4rem;
  }

  .frise-titre {
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--texte);
    margin: 0;
  }

  .frise-etape--done  .frise-titre { color: #888; }
  .frise-etape--todo  .frise-titre { color: #aaa; }
  .frise-etape--active .frise-titre {
    color: var(--vert);
    font-size: 0.82rem;
  }

  .frise-date {
    display: block;
    font-size: 0.68rem;
    color: #999;
    margin-top: 0.25rem;
  }

  .frise-encours {
    display: block;
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--vert);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-top: 0.2rem;
    animation: blink 1.8s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* ── Tableau de détail ── */
  .detail-wrap {
    border: 1px solid var(--gris-clair);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .detail-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .detail-table thead tr {
    background: var(--vert);
    color: #F4F5F2;
  }

  .detail-table th {
    padding: 0.85rem 1.25rem;
    text-align: left;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .detail-table tbody tr {
    border-bottom: 1px solid var(--gris-clair);
    transition: background 0.15s;
  }

  .detail-table tbody tr:nth-child(even) {
    background: var(--fond);
  }

  .detail-table tbody tr:last-child {
    border-bottom: none;
  }

  .detail-table tbody tr:hover {
    background: #dde8de44;
  }

  .detail-table td {
    padding: 0.9rem 1.25rem;
    vertical-align: top;
    color: var(--anthracite);
    line-height: 1.5;
  }

  .td-date {
    white-space: nowrap;
    font-size: 0.8rem;
    color: var(--gris);
    min-width: 130px;
  }

  .td-date strong {
    display: block;
    font-weight: 700;
    color: var(--texte);
    font-size: 0.82rem;
  }

  .td-event {
    font-weight: 600;
    color: var(--texte);
    min-width: 200px;
  }

  .td-event .event-lieu {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--vert);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 0.2rem;
  }

  .td-event .event-detail {
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--anthracite);
  }

  .td-complement {
    font-size: 0.82rem;
    color: var(--gris);
    min-width: 160px;
  }

  .td-complement .comp-ligne {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.15rem;
  }

  .td-complement .comp-key {
    font-weight: 600;
    color: var(--anthracite);
    white-space: nowrap;
  }

  /* Badge en cours dans le tableau */
  .badge-encours {
    display: inline-block;
    background: #dde8de;
    color: var(--vert);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    border: 1px solid #b8cebb;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  /* ── Contact ── */
  .dossier-contact {
    text-align: center;
    padding-top: 0.5rem;
    border-top: 1px solid var(--gris-clair);
  }

  .dossier-contact p {
    font-size: 0.875rem;
    color: var(--gris);
    margin-bottom: 0.75rem;
    max-width: none;
  }

  .contact-btn {
    display: inline-block;
    padding: 0.7rem 1.75rem;
    border: 1.5px solid var(--vert);
    color: var(--vert);
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .contact-btn:hover { background: var(--vert); color: #F4F5F2; }

  @media (max-width: 600px) {
    .frise-wrap { padding: 2rem 1rem 1.5rem; }
    .detail-table th:last-child,
    .detail-table td:last-child { display: none; }
  }
</style>

