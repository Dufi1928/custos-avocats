---
import Base from '../../layouts/Base.astro';
---

<Base title="Mon dossier" description="Suivi confidentiel de votre dossier — Custos Avocats.">

  <section class="dossier-page" aria-label="Suivi de dossier">

    <!-- En-tête avec plante déco -->
    <div class="dossier-header">
      <img src="/plant-cascade.png" alt="" aria-hidden="true" class="plant-deco plant-right" />
      <img src="/plant-laurel.png"  alt="" aria-hidden="true" class="plant-deco plant-left" />
      <div class="header-content">
        <p class="header-eyebrow">Espace confidentiel</p>
        <div class="dossier-meta">
          <span class="dossier-ref" id="dossier-ref">—</span>
          <span class="dossier-badge" id="dossier-proc-label">Procédure pénale</span>
        </div>
        <p class="dossier-cabinet">Cabinet Custos Avocats — Barreau de Lille</p>
      </div>
    </div>

    <!-- Onglets procédure -->
    <div class="proc-select-wrap">
      <p class="proc-select-label">Type de procédure</p>
      <div class="proc-tabs" role="tablist" id="proc-tabs">
        <button role="tab" aria-selected="true"  data-proc="penal"    class="proc-tab active">Pénal général</button>
        <button role="tab" aria-selected="false" data-proc="mineurs"  class="proc-tab">Droit des mineurs</button>
        <button role="tab" aria-selected="false" data-proc="famille"  class="proc-tab">Droit de la famille</button>
        <button role="tab" aria-selected="false" data-proc="affaires" class="proc-tab">Pénal des affaires</button>
        <button role="tab" aria-selected="false" data-proc="corporel" class="proc-tab">Dommages corporels</button>
        <button role="tab" aria-selected="false" data-proc="etranger" class="proc-tab">Droit des étrangers</button>
      </div>
    </div>

    <!-- Frise chronologique -->
    <div class="frise-card">
      <div class="frise-scroll">
        <div class="frise" id="frise" role="list"></div>
      </div>
    </div>

    <!-- Journal des événements -->
    <div class="journal-wrap">
      <div class="journal-header-row">
        <span>Date et heure</span>
        <span>Événement</span>
        <span>Complément</span>
      </div>
      <div class="journal-body" id="journal-body"></div>
    </div>

    <!-- Contact -->
    <div class="dossier-contact">
      <img src="/plant-eucalyptus.png" alt="" aria-hidden="true" class="plant-contact" />
      <p>Une question sur votre dossier ?</p>
      <a href="/contact" class="contact-btn">Contacter le cabinet</a>
    </div>

  </section>

</Base>

<style>
  .dossier-page {
    max-width: 900px;
    margin: 0 auto;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ── En-tête ── */
  .dossier-header {
    position: relative;
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-radius: var(--radius);
    padding: 2rem 2.5rem;
    overflow: hidden;
  }

  .plant-deco {
    position: absolute;
    pointer-events: none;
    user-select: none;
    opacity: 0.18;
  }

  .plant-right {
    top: -10px;
    right: -15px;
    width: 180px;
  }

  .plant-left {
    bottom: -10px;
    left: -10px;
    width: 130px;
    transform: scaleX(-1);
  }

  .header-content {
    position: relative;
    z-index: 1;
  }

  .header-eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--vert);
    margin: 0 0 0.6rem;
    max-width: none;
  }

  .dossier-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }

  .dossier-ref {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--texte);
  }

  .dossier-badge {
    background: #dde8de;
    color: var(--vert);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid #b8cebb;
  }

  .dossier-cabinet {
    font-size: 0.82rem;
    color: var(--gris);
    margin: 0;
    max-width: none;
  }

  /* ── Onglets ── */
  .proc-select-wrap {
    background: var(--fond);
    border: 1px dashed var(--gris-clair);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }

  .proc-select-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--gris);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
    max-width: none;
  }

  .proc-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .proc-tab {
    background: var(--blanc);
    border: 1.5px solid var(--gris-clair);
    color: var(--texte);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .proc-tab:hover  { border-color: var(--vert); color: var(--vert); }
  .proc-tab.active { background: var(--vert); border-color: var(--vert); color: #F4F5F2; }

  /* ── Frise ── */
  .frise-card {
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-radius: var(--radius);
    padding: 2.5rem 1.5rem 2rem;
  }

  .frise-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .frise-scroll::-webkit-scrollbar { display: none; }

  .frise {
    display: grid;
    position: relative;
    padding: 0 0.5rem;
    /* grid-template-columns set by JS */
  }

  /* Ligne grise de fond */
  .frise-bg-line {
    position: absolute;
    top: 28px;
    height: 3px;
    background: #e0e0e0;
    border-radius: 2px;
    z-index: 0;
  }

  /* Ligne verte de progression */
  .frise-prog-line {
    position: absolute;
    top: 28px;
    height: 3px;
    background: var(--vert);
    border-radius: 2px;
    z-index: 1;
    transition: width 1s cubic-bezier(.4,0,.2,1);
  }

  /* Étape */
  .frise-etape {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
    animation: fadeUp 0.4s ease both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .frise-cercle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    position: relative;
    z-index: 3;
    flex-shrink: 0;
  }

  .frise-cercle svg { width: 24px; height: 24px; }

  .frise-etape--done .frise-cercle {
    background: #b0bdb2;
    border: 3px solid #b0bdb2;
    color: #fff;
  }

  .frise-etape--active .frise-cercle {
    background: var(--vert);
    border: 3px solid var(--vert);
    color: #fff;
    box-shadow: 0 0 0 7px rgba(74,93,78,0.14);
    animation: pulse 2.2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 7px rgba(74,93,78,0.14); }
    50%       { box-shadow: 0 0 0 12px rgba(74,93,78,0.05); }
  }

  .frise-etape--todo .frise-cercle {
    background: #fff;
    border: 3px solid #d5d5d5;
    color: #c8c8c8;
  }

  .frise-label {
    text-align: center;
    padding: 0 0.5rem;
    max-width: 120px;
  }

  .frise-titre {
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0;
    color: var(--texte);
  }

  .frise-etape--done  .frise-titre { color: #999; }
  .frise-etape--todo  .frise-titre { color: #bbb; }
  .frise-etape--active .frise-titre { color: var(--vert); font-size: 0.83rem; }

  .frise-date {
    display: block;
    font-size: 0.7rem;
    color: #aaa;
    margin-top: 0.3rem;
  }

  .frise-encours {
    display: block;
    font-size: 0.67rem;
    font-weight: 700;
    color: var(--vert);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-top: 0.25rem;
    animation: blink 1.8s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  /* ── Journal des événements ── */
  .journal-wrap {
    border: 1px solid var(--gris-clair);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .journal-header-row {
    display: grid;
    grid-template-columns: 175px 1fr 1fr;
    background: var(--vert);
    color: #F4F5F2;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.9rem 1.5rem;
    gap: 1.5rem;
  }

  .journal-body {
    display: flex;
    flex-direction: column;
  }

  .journal-row {
    display: grid;
    grid-template-columns: 175px 1fr 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    border-bottom: 1px solid var(--gris-clair);
    transition: background 0.15s;
    align-items: start;
  }

  .journal-row:last-child { border-bottom: none; }

  .journal-row:nth-child(even) { background: var(--fond); }
  .journal-row:hover { background: rgba(221,232,222,0.35); }

  /* Colonne date */
  .j-date {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .j-jour {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--texte);
    line-height: 1.2;
  }

  .j-heure {
    font-size: 0.8rem;
    color: var(--gris);
  }

  /* Colonne événement */
  .j-event {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .j-lieu {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--vert);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .j-titre {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--texte);
    line-height: 1.35;
  }

  .j-encours {
    display: inline-block;
    background: #dde8de;
    color: var(--vert);
    font-size: 0.67rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    border: 1px solid #b8cebb;
    margin-top: 0.1rem;
    width: fit-content;
  }

  /* Colonne complément */
  .j-complement {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .j-comp-ligne {
    font-size: 0.82rem;
    color: var(--anthracite);
    line-height: 1.45;
  }

  .j-comp-cle {
    font-weight: 700;
    color: var(--texte);
  }

  /* ── Contact ── */
  .dossier-contact {
    position: relative;
    text-align: center;
    padding: 2rem 1rem;
    border-top: 1px solid var(--gris-clair);
    overflow: hidden;
  }

  .plant-contact {
    position: absolute;
    right: -20px;
    bottom: -10px;
    width: 140px;
    opacity: 0.15;
    pointer-events: none;
    user-select: none;
    transform: scaleX(-1);
  }

  .dossier-contact p {
    font-size: 0.9rem;
    color: var(--gris);
    margin-bottom: 1rem;
    max-width: none;
    position: relative;
    z-index: 1;
  }

  .contact-btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    border: 1.5px solid var(--vert);
    color: var(--vert);
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
    position: relative;
    z-index: 1;
  }

  .contact-btn:hover { background: var(--vert); color: #F4F5F2; }

  /* ── Responsive ── */
  @media (max-width: 700px) {
    .journal-header-row,
    .journal-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .journal-header-row span:not(:first-child) { display: none; }
    .dossier-header { padding: 1.5rem 1.25rem; }
    .plant-right, .plant-left { display: none; }
  }
</style>

