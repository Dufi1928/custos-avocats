        { date: 'Samedi 12 avril 2025', heure: '10h00', lieu: 'Cabinet Custos Avocats', titre: 'Analyse des actes d\'enquête', complement: [{ cle: 'Pièces :', valeur: 'Convocation et PV d\'audition libre examinés' }] },
        { date: 'Mardi 01 avril 2025', heure: '16h00', lieu: 'Cabinet Custos Avocats', titre: 'Premier entretien', complement: [{ cle: 'Avocat :', valeur: 'Maître Alexis HAROUNE' }] },
      ],
    },
    corporel: {
      label: 'Dommages corporels',
      etapes: [
        { titre: '1er entretien',      done: true,  date: '15 mars 2025' },
        { titre: 'Expertise médicale', done: true,  date: '02 avr. 2025' },
        { titre: 'Consolidation',      done: false, active: true },
        { titre: 'Négociation',        done: false },
        { titre: 'Audience',           done: false },
        { titre: 'Indemnisation',      done: false },
      ],
      evenements: [
        { date: 'Jeudi 10 avril 2025', heure: '09h30', lieu: 'Cabinet Custos Avocats', titre: 'Attente de consolidation médicale', encours: true, complement: [{ cle: 'Statut :', valeur: 'Évaluation du préjudice définitif en attente' }] },
        { date: 'Mercredi 02 avril 2025', heure: '14h00', lieu: 'Service de médecine légale', titre: 'Expertise médicale contradictoire', complement: [{ cle: 'Commentaire :', valeur: 'Assistance lors de l\'expertise' }] },
        { date: 'Samedi 15 mars 2025', heure: '10h00', lieu: 'Cabinet Custos Avocats', titre: 'Premier entretien', complement: [{ cle: 'Avocat :', valeur: 'Maître Lola DAVID' }] },
      ],
    },
    etranger: {
      label: 'Droit des étrangers',
      etapes: [
        { titre: 'Analyse dossier', done: true,  date: '01 avr. 2025' },
        { titre: 'Recours déposé',  done: true,  date: '11 avr. 2025' },
        { titre: 'Instruction',     done: false, active: true },
        { titre: 'Audience',        done: false },
        { titre: 'Décision',        done: false },
      ],
      evenements: [
        { date: 'Lundi 14 avril 2025', heure: '11h00', lieu: 'Tribunal administratif de Lille', titre: 'Instruction en cours', encours: true, complement: [{ cle: 'Statut :', valeur: 'Échange de mémoires avec le tribunal' }] },
        { date: 'Vendredi 11 avril 2025', heure: '09h30', lieu: 'Tribunal administratif de Lille', titre: 'Recours enregistré au greffe', complement: [{ cle: 'Commentaire :', valeur: 'Recours contre OQTF déposé' }] },
        { date: 'Mardi 01 avril 2025', heure: '15h00', lieu: 'Cabinet Custos Avocats', titre: 'Analyse du dossier administratif', complement: [{ cle: 'Avocat :', valeur: 'Maître Chloé JAULIN-DENISSELLE' }] },
      ],
    },
  };

  const dossierId = sessionStorage.getItem('suivi-id');
  const procFromSession = sessionStorage.getItem('suivi-proc');
  if (!dossierId) { window.location.href = '/suivi'; }
  document.getElementById('dossier-ref')!.textContent = 'Dossier ' + (dossierId || '—');

  function renderProc(key: string) {
    const proc = procedures[key];
    if (!proc) return;

    document.getElementById('dossier-proc-label')!.textContent = proc.label;

    /* ══ FRISE ══ */
    const friseEl = document.getElementById('frise')!;
    friseEl.innerHTML = '';

    const n = proc.etapes.length;
    const doneCount  = proc.etapes.filter(e => e.done).length;
    const activeIdx  = proc.etapes.findIndex(e => e.active);

    /* Grid */
    friseEl.style.gridTemplateColumns = `repeat(${n}, minmax(110px, 1fr))`;

    /* Ligne de fond : de centre col 0 à centre col n-1 */
    const bgLine = document.createElement('div');
    bgLine.className = 'frise-line-bg';
    bgLine.style.left  = `calc(${50 / n}%)`;
    bgLine.style.width = `calc(${(n - 1) / n * 100}%)`;
    friseEl.appendChild(bgLine);

    /* Ligne des étapes faites (gris-vert) */
    if (doneCount > 0) {
      const doneLine = document.createElement('div');
      doneLine.className = 'frise-line-done';
      doneLine.style.left  = `calc(${50 / n}%)`;
      /* Va du centre step 0 au centre step (doneCount-1) */
      doneLine.style.width = `calc(${(doneCount - 1) / n * 100}%)`;
      friseEl.appendChild(doneLine);
    }

    /* Ligne verte : du centre du dernier done au centre de l'active */
    if (activeIdx > 0 && doneCount > 0) {
      const activeLine = document.createElement('div');
      activeLine.className = 'frise-line-active';
      /* Commence au centre du dernier step done */
      const startPct = (doneCount - 0.5) / n * 100;
      /* Finit au centre du step active */
      const endPct   = (activeIdx + 0.5) / n * 100;
      activeLine.style.left  = `calc(${startPct}%)`;
      activeLine.style.width = `calc(${endPct - startPct}%)`;
      friseEl.appendChild(activeLine);
    }

    /* Étapes */
    proc.etapes.forEach((etape, i) => {
      const state = etape.done ? 'done' : etape.active ? 'active' : 'todo';
      const div = document.createElement('div');
      div.className = `frise-etape frise-etape--${state}`;
      div.setAttribute('role', 'listitem');
      div.style.animationDelay = `${i * 0.07}s`;

      const icon = etape.done ? ICON_DONE : etape.active ? ICON_CLOCK : ICON_TODO;

      div.innerHTML = `
        <div class="frise-cercle">${icon}</div>
        <div class="frise-label">
          <p class="frise-titre">${etape.titre}</p>
          ${etape.date   ? `<span class="frise-date">${etape.date}</span>` : ''}
          ${etape.active ? `<span class="frise-encours">En cours</span>` : ''}
        </div>`;
      friseEl.appendChild(div);
    });

    /* ══ TABLEAU ══ */
    const tbody = document.getElementById('chrono-tbody')!;
    tbody.innerHTML = '';

    proc.evenements.forEach(ev => {
      const tr = document.createElement('tr');
      const compHTML = ev.complement
        ? ev.complement.map(c => `<div class="td-comp-ligne"><span class="td-comp-cle">${c.cle}</span> ${c.valeur}</div>`).join('')
        : '';

      tr.innerHTML = `
        <td>
          <span class="td-jour">${ev.date}</span>
          <span class="td-heure">${ev.heure}</span>
        </td>
        <td>
          <span class="td-lieu">${ev.lieu}</span>
          <span class="td-titre">${ev.titre}</span>
          ${ev.encours ? `<span class="td-badge-encours">En cours</span>` : ''}
        </td>
        <td>${compHTML}</td>`;
      tbody.appendChild(tr);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.proc-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.proc-tab').forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      renderProc(tab.dataset.proc!);
    });
  });

  renderProc(procFromSession || 'penal');
</script>
