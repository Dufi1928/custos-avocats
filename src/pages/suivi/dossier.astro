  const dossierId = sessionStorage.getItem('suivi-id');
  const procFromSession = sessionStorage.getItem('suivi-proc');

  if (!dossierId) { window.location.href = '/suivi'; }

  document.getElementById('dossier-ref')!.textContent = 'Dossier ' + (dossierId || '—');

  function renderProc(key: string) {
    const proc = procedures[key];
    if (!proc) return;

    document.getElementById('dossier-proc-label')!.textContent = proc.label;

    // ── Frise ──
    const frise = document.getElementById('frise')!;
    frise.innerHTML = '';

    const etapes = proc.etapes;
    const doneCount = etapes.filter(e => e.done).length;
    const activeIdx = etapes.findIndex(e => e.active);

    // Ligne de progression
    const line = document.createElement('div');
    line.className = 'frise-line';
    frise.appendChild(line);

    etapes.forEach((etape, i) => {
      const state = etape.done ? 'done' : etape.active ? 'active' : 'todo';
      const div = document.createElement('div');
      div.className = `frise-etape frise-etape--${state}`;
      div.style.animationDelay = `${i * 0.08}s`;

      let icon = '';
      if (etape.done) {
        icon = `<svg viewBox="0 0 24 24" fill="none"><polyline points="20,6 9,17 4,12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
      } else if (etape.active) {
        icon = `<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="5" fill="currentColor"/></svg>`;
      } else {
        icon = `<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/></svg>`;
      }

      const dateTag    = etape.date   ? `<span class="frise-date">${etape.date}</span>` : '';
      const encoursTag = etape.active ? `<span class="frise-encours">En cours</span>` : '';

      div.innerHTML = `
        <div class="frise-cercle">${icon}</div>
        <div class="frise-label">
          <p class="frise-titre">${etape.titre}</p>
          ${dateTag}${encoursTag}
        </div>`;
      frise.appendChild(div);
    });

    // Calcul largeur de la ligne verte
    requestAnimationFrame(() => {
      const friseEl = document.getElementById('frise')!;
      const dots = friseEl.querySelectorAll<HTMLElement>('.frise-cercle');
      if (dots.length < 2) return;

      let endX = 0;
      if (doneCount > 0) {
        const lastDone = dots[Math.min(doneCount - 1, dots.length - 1)];
        const nextDot  = activeIdx >= 0 ? dots[activeIdx] : null;
        const friseRect = friseEl.getBoundingClientRect();

        if (nextDot) {
          const r1 = lastDone.getBoundingClientRect();
          const r2 = nextDot.getBoundingClientRect();
          endX = ((r1.left + r1.width / 2) + (r2.left + r2.width / 2)) / 2 - friseRect.left;
        } else {
          const r = lastDone.getBoundingClientRect();
          endX = r.left + r.width / 2 - friseRect.left;
        }
      }
      line.style.width = endX + 'px';
    });

    // ── Tableau ──
    const tbody = document.getElementById('detail-tbody')!;
    tbody.innerHTML = '';

    proc.evenements.forEach((ev, i) => {
      const tr = document.createElement('tr');

      // Colonne date
      const tdDate = document.createElement('td');
      tdDate.className = 'td-date';
      tdDate.innerHTML = `<strong>${ev.date}</strong>${ev.heure}`;

      // Colonne événement
      const tdEv = document.createElement('td');
      tdEv.className = 'td-event';
      const badge = ev.encours ? `<span class="badge-encours">En cours</span>` : '';
      tdEv.innerHTML = `<span class="event-lieu">${ev.lieu}</span><span class="event-detail">${ev.evenement}${badge}</span>`;

      // Colonne complément
      const tdComp = document.createElement('td');
      tdComp.className = 'td-complement';
      if (ev.complement) {
        tdComp.innerHTML = ev.complement.map(c =>
          `<div class="comp-ligne"><span class="comp-key">${c.cle}</span> ${c.valeur}</div>`
        ).join('');
      }

      tr.appendChild(tdDate);
      tr.appendChild(tdEv);
      tr.appendChild(tdComp);
      tbody.appendChild(tr);
    });
  }

  const tabs = document.querySelectorAll<HTMLButtonElement>('.proc-tab');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      renderProc(tab.dataset.proc!);
    });
  });

  renderProc(procFromSession || 'penal');
</script>
