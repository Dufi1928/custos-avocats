        { titre: 'RECOURS\nDÉPOSÉ',   icon: 'send',     done: true,   badge: 'TERMINÉ',  desc: 'Recours contre OQTF enregistré.', location: 'Tribunal administratif', date: '11 avr. 2025' },
        { titre: 'INSTRUCTION',        icon: 'building', active: true, badge: 'EN COURS', desc: 'Échange de mémoires avec la juridiction.', date: 'En cours' },
