---
import Base from '../../layouts/Base.astro';
---

<Base title="Mon dossier" description="Suivi confidentiel de votre dossier — Custos Avocats.">

  <section class="dossier-page" aria-label="Suivi de dossier">

    <!-- En-tête -->
    <div class="dossier-header">
      <img src="/plant-cascade.png"  alt="" aria-hidden="true" class="plant-deco plant-right" />
      <img src="/plant-laurel.png"   alt="" aria-hidden="true" class="plant-deco plant-left" />
      <div class="header-content">
        <p class="header-eyebrow">Espace confidentiel</p>
        <div class="dossier-meta">
          <span class="dossier-ref" id="dossier-ref">—</span>
          <span class="dossier-badge" id="dossier-proc-label">Procédure pénale</span>
        </div>
        <p class="dossier-cabinet">Cabinet Custos Avocats — Barreau de Lille</p>
      </div>
    </div>

    <!-- Onglets -->
    <div class="proc-select-wrap">
      <p class="proc-select-label">Type de procédure</p>
      <div class="proc-tabs" role="tablist" id="proc-tabs">
        <button role="tab" aria-selected="true"  data-proc="penal"    class="proc-tab active">Pénal général</button>
        <button role="tab" aria-selected="false" data-proc="mineurs"  class="proc-tab">Droit des mineurs</button>
        <button role="tab" aria-selected="false" data-proc="famille"  class="proc-tab">Droit de la famille</button>
        <button role="tab" aria-selected="false" data-proc="affaires" class="proc-tab">Pénal des affaires</button>
        <button role="tab" aria-selected="false" data-proc="corporel" class="proc-tab">Dommages corporels</button>
        <button role="tab" aria-selected="false" data-proc="etranger" class="proc-tab">Droit des étrangers</button>
      </div>
    </div>

    <!-- Frise style Chronopost -->
    <div class="frise-card">
      <div class="frise-scroll">
        <div class="frise" id="frise" role="list"></div>
      </div>
    </div>

    <!-- Tableau Chronopost -->
    <div class="chrono-wrap">
      <table class="chrono-table" id="chrono-table">
        <thead>
          <tr>
            <th class="col-date">Date et heure</th>
            <th class="col-event">Événement</th>
            <th class="col-comp">Complément</th>
          </tr>
        </thead>
        <tbody id="chrono-tbody"></tbody>
      </table>
    </div>

    <!-- Contact -->
    <div class="dossier-contact">
      <img src="/plant-eucalyptus.png" alt="" aria-hidden="true" class="plant-contact" />
      <p>Une question sur votre dossier ?</p>
      <a href="/contact" class="contact-btn">Contacter le cabinet</a>
    </div>

  </section>

</Base>

<style>
  .dossier-page {
    max-width: 940px;
    margin: 0 auto;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ── En-tête ── */
  .dossier-header {
    position: relative;
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-radius: var(--radius);
    padding: 2rem 2.5rem;
    overflow: hidden;
  }

  .plant-deco { position: absolute; pointer-events: none; user-select: none; opacity: 0.17; }
  .plant-right { top: -10px; right: -15px; width: 175px; }
  .plant-left  { bottom: -10px; left: -10px; width: 120px; transform: scaleX(-1); }
  .header-content { position: relative; z-index: 1; }

  .header-eyebrow {
    font-size: 0.68rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.16em; color: var(--vert); margin: 0 0 0.6rem; max-width: none;
  }

  .dossier-meta { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.4rem; }

  .dossier-ref { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 700; color: var(--texte); }

  .dossier-badge {
    background: #dde8de; color: var(--vert); font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; padding: 0.3rem 0.85rem;
    border-radius: 999px; border: 1px solid #b8cebb;
  }

  .dossier-cabinet { font-size: 0.82rem; color: var(--gris); margin: 0; max-width: none; }

  /* ── Onglets ── */
  .proc-select-wrap {
    background: var(--fond); border: 1px dashed var(--gris-clair);
    border-radius: var(--radius); padding: 1rem 1.25rem;
  }

  .proc-select-label {
    font-size: 0.72rem; font-weight: 700; color: var(--gris);
    text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 0.75rem; max-width: none;
  }

  .proc-tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .proc-tab {
    background: var(--blanc); border: 1.5px solid var(--gris-clair); color: var(--texte);
    padding: 0.4rem 0.9rem; border-radius: 999px; font-family: var(--font-sans);
    font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s; white-space: nowrap;
  }
  .proc-tab:hover  { border-color: var(--vert); color: var(--vert); }
  .proc-tab.active { background: var(--vert); border-color: var(--vert); color: #F4F5F2; }

  /* ════════════════════════════════════
     FRISE CHRONOPOST
  ════════════════════════════════════ */
  .frise-card {
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-radius: var(--radius);
    padding: 2.5rem 2rem 2rem;
  }

  .frise-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--gris-clair) transparent;
    padding-bottom: 0.5rem;
  }

  /* Grille d'étapes */
  .frise {
    display: grid;
    position: relative;
    min-width: max-content;
    width: 100%;
    /* grid-template-columns set by JS */
  }

  /* Ligne de fond (gris clair, toute la longueur) */
  .frise-line-bg {
    position: absolute;
    top: 26px; /* moitié des cercles (52px / 2) */
    height: 3px;
    background: #d8d8d8;
    border-radius: 2px;
    z-index: 0;
  }

  /* Ligne des étapes faites (gris-vert) */
  .frise-line-done {
    position: absolute;
    top: 26px;
    height: 3px;
    background: #a8b8ab;
    border-radius: 2px;
    z-index: 1;
    transition: width 0.9s cubic-bezier(.4,0,.2,1);
  }

  /* Ligne jusqu'à l'étape active (vert vif) */
  .frise-line-active {
    position: absolute;
    top: 26px;
    height: 3px;
    background: var(--vert);
    border-radius: 2px;
    z-index: 2;
    transition: width 0.9s cubic-bezier(.4,0,.2,1) 0.2s;
  }

  /* Étape */
  .frise-etape {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    position: relative;
    z-index: 3;
    min-width: 110px;
    animation: fadeUp 0.4s ease both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Cercle — taille fixe identique pour tous */
  .frise-cercle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 4;
  }

  .frise-cercle svg { width: 22px; height: 22px; display: block; }

  /* ── Fait : cercle gris-vert + coche ── */
  .frise-etape--done .frise-cercle {
    background: #a8b8ab;
    border: 3px solid #a8b8ab;
    color: #fff;
  }

  /* ── En cours : cercle VERT mis en avant ── */
  .frise-etape--active .frise-cercle {
    background: var(--vert);
    border: 3px solid var(--vert);
    color: #fff;
    box-shadow: 0 0 0 6px rgba(74,93,78,0.18), 0 0 0 11px rgba(74,93,78,0.07);
    animation: ringPulse 2.4s ease-in-out infinite;
  }

  @keyframes ringPulse {
    0%, 100% { box-shadow: 0 0 0 6px rgba(74,93,78,0.18), 0 0 0 11px rgba(74,93,78,0.07); }
    50%       { box-shadow: 0 0 0 9px rgba(74,93,78,0.12), 0 0 0 16px rgba(74,93,78,0.04); }
  }

  /* ── À faire : cercle blanc + bordure gris clair ── */
  .frise-etape--todo .frise-cercle {
    background: #fff;
    border: 3px solid #d0d0d0;
    color: #c8c8c8;
  }

  /* Labels */
  .frise-label { text-align: center; padding: 0 0.25rem; }

  .frise-titre {
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .frise-etape--done  .frise-titre { color: #999; }
  .frise-etape--todo  .frise-titre { color: #ccc; }
  .frise-etape--active .frise-titre {
    color: var(--vert);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .frise-date {
    display: block;
    font-size: 0.68rem;
    margin-top: 0.25rem;
  }
  .frise-etape--done  .frise-date { color: #bbb; }
  .frise-etape--todo  .frise-date { color: #c0c0c0; }
  .frise-etape--active .frise-date { color: var(--vert); font-weight: 600; }

  .frise-encours {
    display: block;
    font-size: 0.64rem;
    font-weight: 800;
    color: var(--vert);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.2rem;
    animation: blink 1.9s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  /* ════════════════════════════════════
     TABLEAU CHRONOPOST
  ════════════════════════════════════ */
  .chrono-wrap {
    border: 1px solid #ddd;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .chrono-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }

  .chrono-table thead tr { background: #3a4a3e; color: #F4F5F2; }

  .chrono-table th {
    padding: 0.95rem 1.4rem;
    text-align: left;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .col-date  { width: 170px; }
  .col-event { width: 44%; }

  .chrono-table tbody tr {
    border-bottom: 1px solid #e8e8e8;
    transition: background 0.15s;
  }
  .chrono-table tbody tr:last-child { border-bottom: none; }
  .chrono-table tbody tr:nth-child(odd)  { background: #fff; }
  .chrono-table tbody tr:nth-child(even) { background: #f6f7f5; }
  .chrono-table tbody tr:hover { background: #edf2ee; }

  .chrono-table td { padding: 1.1rem 1.4rem; vertical-align: top; line-height: 1.5; }

  .td-jour  { display: block; font-weight: 700; font-size: 0.85rem; color: #222; margin-bottom: 0.15rem; }
  .td-heure { font-size: 0.8rem; color: #888; }

  .td-lieu {
    display: block; font-size: 0.72rem; font-weight: 800;
    color: var(--vert); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 0.25rem;
  }
  .td-titre  { display: block; font-size: 0.875rem; color: #222; line-height: 1.4; }

  .td-badge-encours {
    display: inline-block; margin-top: 0.35rem;
    background: #dde8de; color: var(--vert); font-size: 0.65rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.07em; padding: 0.15rem 0.6rem;
    border-radius: 999px; border: 1px solid #b8cebb;
  }

  .td-comp-ligne { display: flex; gap: 0.4rem; font-size: 0.82rem; color: #555; margin-bottom: 0.2rem; line-height: 1.4; }
  .td-comp-cle   { font-weight: 700; color: #333; white-space: nowrap; }

  /* ── Contact ── */
  .dossier-contact {
    position: relative; text-align: center;
    padding: 2rem 1rem; border-top: 1px solid var(--gris-clair); overflow: hidden;
  }

  .plant-contact {
    position: absolute; right: -20px; bottom: -10px; width: 130px;
    opacity: 0.13; pointer-events: none; user-select: none; transform: scaleX(-1);
  }

  .dossier-contact p { font-size: 0.9rem; color: var(--gris); margin-bottom: 1rem; max-width: none; position: relative; z-index: 1; }

  .contact-btn {
    display: inline-block; padding: 0.75rem 2rem;
    border: 1.5px solid var(--vert); color: var(--vert); border-radius: var(--radius);
    font-size: 0.875rem; font-weight: 600; text-decoration: none;
    transition: background 0.2s, color 0.2s; position: relative; z-index: 1;
  }
  .contact-btn:hover { background: var(--vert); color: #F4F5F2; }

  @media (max-width: 640px) {
    .plant-right, .plant-left { display: none; }
    .chrono-table th:last-child, .chrono-table td:last-child { display: none; }
    .frise-etape { min-width: 90px; }
    .dossier-header { padding: 1.5rem 1.25rem; }
  }
</style>

<script>
  /* ── Icônes par état ── */
  const ICON_DONE = `<svg viewBox="0 0 24 24" fill="none"><polyline points="20,6 9,17 4,12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
  const ICON_CLOCK = `<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><polyline points="12,7 12,12 15,15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`;
  const ICON_TODO  = `<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/></svg>`;

  type Etape = { titre: string; done?: boolean; active?: boolean; date?: string };
