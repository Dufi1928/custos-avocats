---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const expertises = await getCollection('expertises');
const sorted = expertises.sort(
  (a: CollectionEntry<'expertises'>, b: CollectionEntry<'expertises'>) =>
    (a.data.ordre ?? 99) - (b.data.ordre ?? 99)
);

const piliers = [
  {
    titre: 'Secret professionnel',
    texte: 'Tout ce que vous nous confiez est protégé sans réserve ni limite dans le temps. Cette garantie est absolue.',
    icon: `<svg viewBox="0 0 40 48" fill="none" aria-hidden="true"><rect x="6" y="20" width="28" height="22" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M 12,20 V 15 C 12,8.4 28,8.4 28,15 V 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="20" cy="31" r="3" fill="currentColor" opacity="0.6"/><line x1="20" y1="34" x2="20" y2="38" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/></svg>`,
  },
  {
    titre: 'Engagement total',
    texte: 'Chaque dossier mobilise l\'ensemble du cabinet. Cinq associés, une seule priorité : votre défense.',
    icon: `<svg viewBox="0 0 48 40" fill="none" aria-hidden="true"><path d="M 8,28 C 4,22 4,14 10,10 C 16,6 22,10 24,16 C 26,10 32,6 38,10 C 44,14 44,22 40,28 L 24,38 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>`,
  },
  {
    titre: 'Transparence totale',
    texte: 'Honoraires définis en amont par convention. Stratégie expliquée à chaque étape. Vous décidez en connaissance de cause.',
    icon: `<svg viewBox="0 0 44 44" fill="none" aria-hidden="true"><rect x="6" y="6" width="32" height="38" rx="2" stroke="currentColor" stroke-width="1.8"/><line x1="13" y1="18" x2="31" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="13" y1="25" x2="31" y2="25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="13" y1="32" x2="24" y2="32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="13" y="8" width="18" height="6" rx="1" fill="currentColor" opacity="0.12" stroke="currentColor" stroke-width="1.2"/></svg>`,
  },
];
---

<Base
  title="Accueil"
  description="Cabinet d'avocats spécialisé en droit pénal — 5 avocats associés au Barreau de Lille. Garde à vue, comparution immédiate, assises."
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">Droit pénal — Barreau de Lille</p>
        <h1 class="hero-title">
          La défense pénale<br />
          <em>qui ne faiblit jamais.</em>
        </h1>
        <p class="hero-subtitle">
          Cinq avocats associés à vos côtés, de la garde à vue jusqu'à la cour
          d'assises. Custos met son expertise collective au service de votre défense.
        </p>
        <div class="hero-actions">
          <a href="/custos-avocats/contact" class="hero-btn hero-btn--primaire">
            Nous contacter
          </a>
          <a href="/custos-avocats/les-valeurs-du-cabinet" class="hero-btn hero-btn--secondaire">
            Le cabinet
          </a>
        </div>
      </div>

      <div class="hero-deco" aria-hidden="true">
        <svg viewBox="0 0 320 400" fill="none" xmlns="http://www.w3.org/2000/svg">

          <!-- ══ MONSTERA (arrière-plan, très discret) ══ -->
          <path d="M 160,355 C 152,328 136,302 114,282 C 86,255 58,238 48,208
                   C 34,168 50,128 78,113 C 96,103 118,108 130,123
                   C 125,144 120,166 126,184 C 132,200 146,208 155,203
                   L 160,196 L 165,203
                   C 174,208 188,200 194,184 C 200,166 195,144 190,123
                   C 202,108 224,103 242,113 C 270,128 286,168 272,208
                   C 262,238 234,255 206,282 C 184,302 168,328 160,355 Z"
                fill="currentColor" opacity="0.07"/>
          <!-- Nervure centrale -->
          <path d="M 160,355 C 160,320 160,265 160,196" stroke="currentColor" stroke-width="1" opacity="0.1" fill="none"/>
          <!-- Découpes gauche -->
          <path d="M 114,282 C 92,290 72,284 60,272" stroke="currentColor" stroke-width="1" opacity="0.12" fill="none" stroke-linecap="round"/>
          <path d="M 76,242 C 57,248 40,242 32,230" stroke="currentColor" stroke-width="1" opacity="0.12" fill="none" stroke-linecap="round"/>
          <!-- Découpes droite -->
          <path d="M 206,282 C 228,290 248,284 260,272" stroke="currentColor" stroke-width="1" opacity="0.12" fill="none" stroke-linecap="round"/>
          <path d="M 244,242 C 263,248 280,242 288,230" stroke="currentColor" stroke-width="1" opacity="0.12" fill="none" stroke-linecap="round"/>

          <!-- ══ BRANCHE FOUGÈRE (bas gauche) ══ -->
          <g opacity="0.2">
            <path d="M 50,390 C 54,360 62,325 72,295 C 82,265 96,240 108,220" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/>
            <path d="M 53,370 C 38,360 26,353 22,355" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/>
            <path d="M 57,348 C 42,337 30,330 26,332" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/>
            <path d="M 62,326 C 47,314 36,307 32,309" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/>
            <path d="M 67,304 C 53,291 43,284 40,286" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/>
            <path d="M 54,370 C 68,360 78,353 82,355" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/>
            <path d="M 58,348 C 72,337 82,330 86,332" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/>
            <path d="M 63,326 C 77,314 87,307 91,309" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/>
          </g>

          <!-- ══ PETITE FEUILLE (haut gauche) ══ -->
          <path d="M 38,72 C 44,54 60,44 74,46 C 88,48 96,62 90,76
                   C 84,90 68,94 55,88 C 42,82 36,80 38,72 Z"
                fill="currentColor" opacity="0.09"/>
          <path d="M 66,62 L 38,72" stroke="currentColor" stroke-width="0.8" opacity="0.12" stroke-linecap="round"/>

          <!-- ══ PETITE FEUILLE (haut droite) ══ -->
          <path d="M 282,78 C 276,60 260,52 246,56 C 232,60 226,74 234,86
                   C 242,98 258,100 270,93 C 282,86 286,84 282,78 Z"
                fill="currentColor" opacity="0.09"/>
          <path d="M 254,68 L 282,78" stroke="currentColor" stroke-width="0.8" opacity="0.12" stroke-linecap="round"/>

          <!-- ══ BALANCE DE LA JUSTICE (premier plan) ══ -->
          <!-- Poteau central -->
          <rect x="159" y="50" width="2" height="210" fill="currentColor" opacity="0.22"/>
          <!-- Fleuron -->
          <circle cx="160" cy="54" r="14" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.28"/>
          <circle cx="160" cy="54" r="4" fill="currentColor" opacity="0.22"/>
          <!-- Fléau -->
          <rect x="74" y="110" width="172" height="2.5" rx="1" fill="currentColor" opacity="0.22"/>
          <!-- Chaîne gauche -->
          <line x1="102" y1="112" x2="88" y2="178" stroke="currentColor" stroke-width="1.5" opacity="0.22" stroke-dasharray="4 3"/>
          <!-- Chaîne droite -->
          <line x1="218" y1="112" x2="232" y2="178" stroke="currentColor" stroke-width="1.5" opacity="0.22" stroke-dasharray="4 3"/>
          <!-- Plateau gauche -->
          <ellipse cx="88" cy="190" rx="30" ry="10" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.06" opacity="0.45"/>
          <!-- Plateau droit -->
          <ellipse cx="232" cy="190" rx="30" ry="10" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.06" opacity="0.45"/>
          <!-- Socle -->
          <rect x="126" y="260" width="68" height="2" fill="currentColor" opacity="0.16"/>
          <rect x="136" y="262" width="48" height="18" rx="2" fill="currentColor" opacity="0.07"/>

        </svg>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="stats-strip" aria-label="Chiffres clés">
    <ul class="stats-grid">
      <li class="stat"><strong>5</strong><span>Avocats associés</span></li>
      <li class="stat"><strong>Lille</strong><span>Barreau</span></li>
      <li class="stat"><strong>6</strong><span>Domaines d'intervention</span></li>
      <li class="stat"><strong>2</strong><span>Pôles par avocat</span></li>
    </ul>
  </section>

  <!-- ============ EXPERTISES ============ -->
  <section class="expertises" aria-label="Nos domaines d'expertise">
    <header class="section-header">
      <p class="eyebrow">Ce que nous défendons</p>
      <h2>Nos domaines d'expertise</h2>
    </header>
    <ul class="expertise-grid">
      {sorted.map((e: CollectionEntry<'expertises'>) => (
        <li>
          <a
            href={`/custos-avocats/expertises/${e.data.slug}`}
            class="expertise-card"
          >
            <span class="expertise-num">
              {String(e.data.ordre ?? 0).padStart(2, '0')}
            </span>
            <h3>{e.data.title}</h3>
            <p>{e.data.focus.slice(0, 2).join(' · ')}</p>
            <span class="expertise-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ MISSION ============ -->
  <section class="mission" aria-label="Notre mission">
    <div class="mission-inner">
      <div class="mission-text">
        <p class="eyebrow">Pourquoi Custos</p>
        <h2>Défendre.<br />Protéger.<br />Ne jamais abandonner.</h2>
        <p>
          Nous avons fondé Custos avec une conviction : la défense pénale exige
          autant d'humanité que d'expertise juridique. Chaque client vit une
          situation de crise. Notre rôle est de transformer cette crise en défense.
        </p>
        <a href="/custos-avocats/les-valeurs-du-cabinet" class="mission-lien">Notre mission →</a>
      </div>
      <div class="mission-deco">
        <blockquote class="mission-quote">
          <p>
            "La justice sans la force est impuissante ;
            la force sans la justice est tyrannique."
          </p>
          <cite>Blaise Pascal — Pensées</cite>
        </blockquote>

        <!-- Fougère décorative -->
        <svg class="mission-plant" viewBox="0 0 140 200" fill="none" aria-hidden="true">
          <path d="M 70,190 C 68,162 64,132 58,106 C 52,80 42,56 28,38" stroke="#4A5D4E" stroke-width="2" stroke-linecap="round" opacity="0.35"/>
          <!-- feuilles gauches -->
          <path d="M 66,170 C 50,161 36,154 30,157" stroke="#4A5D4E" stroke-width="1.4" stroke-linecap="round" opacity="0.3" fill="none"/>
          <path d="M 63,148 C 46,138 32,131 26,134" stroke="#4A5D4E" stroke-width="1.4" stroke-linecap="round" opacity="0.3" fill="none"/>
          <path d="M 60,126 C 44,115 30,108 25,111" stroke="#4A5D4E" stroke-width="1.4" stroke-linecap="round" opacity="0.3" fill="none"/>
          <path d="M 56,104 C 41,92 28,86 24,88" stroke="#4A5D4E" stroke-width="1.4" stroke-linecap="round" opacity="0.3" fill="none"/>
          <path d="M 50,83 C 37,70 26,64 22,67" stroke="#4A5D4E" stroke-width="1.4" stroke-linecap="round" opacity="0.3" fill="none"/>
          <!-- feuilles droites -->
          <path d="M 68,164 C 82,154 94,147 98,150" stroke="#4A5D4E" stroke-width="1.4" stroke-linecap="round" opacity="0.3" fill="none"/>
          <path d="M 65,142 C 79,131 90,124 94,127" stroke="#4A5D4E" stroke-width="1.4" stroke-linecap="round" opacity="0.3" fill="none"/>
          <path d="M 61,120 C 75,108 86,102 90,105" stroke="#4A5D4E" stroke-width="1.4" stroke-linecap="round" opacity="0.3" fill="none"/>
          <path d="M 57,98 C 69,86 80,80 84,83" stroke="#4A5D4E" stroke-width="1.4" stroke-linecap="round" opacity="0.3" fill="none"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- ============ PILIERS ============ -->
  <section class="piliers" aria-label="Nos engagements">
    <header class="section-header">
      <p class="eyebrow">Nos engagements</p>
      <h2>Ce sur quoi vous pouvez compter</h2>
    </header>
    <ul class="piliers-grid">
      {piliers.map(({ titre, texte, icon }) => (
        <li class="pilier">
          <span class="pilier-icon" set:html={icon}/>
          <h3>{titre}</h3>
          <p>{texte}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ ÉQUIPE PREVIEW ============ -->
  <section class="equipe-preview" aria-label="L'équipe">
    <div class="equipe-text">
      <p class="eyebrow">Cinq associés</p>
      <h2>Une équipe, un seul objectif : votre défense</h2>
      <p>
        Chaque avocat du cabinet partage un socle commun en droit pénal et porte
        une spécialité complémentaire. Ensemble, nous couvrons l'intégralité du
        spectre pénal.
      </p>
      <a href="/custos-avocats/equipe" class="equipe-lien">Rencontrer l'équipe →</a>
    </div>
  </section>

  <!-- ============ CONTACT CTA ============ -->
  <section class="urgence-cta" aria-label="Contact">
    <p class="eyebrow urgence-eyebrow">Prendre rendez-vous</p>
    <h2>Besoin d'un avocat pénaliste ?</h2>
    <p>Exposez-nous votre situation. Nous vous répondons dans les meilleurs délais.</p>
    <a href="/custos-avocats/contact" class="urgence-btn">Nous contacter</a>
  </section>
</Base>

<style>
/* ---- RESET SECTIONS PLEINE LARGEUR ---- */
.hero,
.stats-strip,
.mission,
.urgence-cta {
  max-width: 100%;
  width: 100%;
  padding: 0;
  border-bottom: none;
}

/* ======================================
   HERO
   ====================================== */
.hero { background: #1A1A1A; }

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 4rem;
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 7rem var(--gap) 6rem;
  min-height: 90vh;
}

.hero-eyebrow {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--vert-vif);
  font-weight: 600;
  margin-bottom: 1.75rem;
  max-width: none;
  animation: heroFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.hero-title {
  font-family: var(--font-serif);
  font-size: clamp(1.9rem, 3.2vw, 3rem);
  font-weight: 700;
  line-height: 1.12;
  color: #F4F5F2;
  margin-bottom: 1.5rem;
  animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;
}

.hero-title em {
  font-style: italic;
  color: var(--vert-vif);
}

.hero-subtitle {
  font-size: 1.05rem;
  color: rgba(244, 245, 242, 0.55);
  max-width: 50ch;
  line-height: 1.8;
  margin-bottom: 2.5rem;
  animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.24s both;
}

.hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
  animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.36s both;
}

.hero-btn {
  display: inline-block;
  padding: 0.85rem 1.75rem;
  border-radius: var(--radius);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-decoration: none;
  text-transform: uppercase;
  transition: all 0.25s ease;
  border: 1px solid transparent;
}

.hero-btn--primaire {
  background: var(--vert);
  color: #F4F5F2;
  border-color: var(--vert);
}
.hero-btn--primaire:hover {
  background: var(--vert-vif);
  border-color: var(--vert-vif);
  color: #F4F5F2;
  opacity: 1;
}

.hero-btn--secondaire {
  background: transparent;
  color: rgba(244, 245, 242, 0.65);
  border-color: rgba(244, 245, 242, 0.2);
}
.hero-btn--secondaire:hover {
  border-color: rgba(244, 245, 242, 0.5);
  color: #F4F5F2;
  background: transparent;
  opacity: 1;
}


.hero-deco {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: var(--vert-vif);
  animation: heroFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
}
.hero-deco svg { width: 85%; max-width: 300px; height: auto; }

@keyframes heroFadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ======================================
   STATS
   ====================================== */
.stats-strip {
  background: var(--blanc);
  border-bottom: 1px solid var(--gris-clair);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  max-width: var(--max-width);
  margin-inline: auto;
  flex-direction: row;
  gap: 0;
  margin-top: 0;
}

.stat {
  padding: 2.5rem 2rem;
  border-right: 1px solid var(--gris-clair);
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.stat:last-child { border-right: none; }

.stat strong {
  font-family: var(--font-serif);
  font-size: 2.75rem;
  color: var(--vert);
  line-height: 1;
}

.stat span {
  font-size: 0.7rem;
  color: var(--gris);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 500;
}

/* ======================================
   EXPERTISES
   ====================================== */
.expertises { padding: 6rem var(--gap); }

.section-header { margin-bottom: 3rem; }
.section-header h2 { margin-bottom: 0; }

.eyebrow {
  display: block;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--vert);
  font-weight: 600;
  margin-bottom: 0.75rem;
  max-width: none;
}

.expertise-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  background: var(--gris-clair);
  border: 1px solid var(--gris-clair);
  border-radius: var(--radius);
  overflow: hidden;
  flex-direction: unset;
  margin-top: 0;
}

.expertise-card {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  padding: 2.25rem 2rem;
  background: var(--fond);
  text-decoration: none;
  transition: background 0.25s;
  border: none;
  border-radius: 0;
  color: var(--texte);
}
.expertise-card:hover {
  background: var(--blanc);
  color: var(--texte);
  opacity: 1;
}

.expertise-num {
  display: block;
  font-size: 0.65rem;
  color: var(--gris);
  font-weight: 500;
  letter-spacing: 0.08em;
  margin-bottom: 0.5rem;
}

.expertise-card h3 {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  color: var(--texte);
  font-weight: 700;
  margin-bottom: 0.2rem;
}

.expertise-card p {
  font-size: 0.78rem;
  color: var(--gris);
  max-width: none;
  margin: 0;
  line-height: 1.5;
}

.expertise-arrow {
  display: block;
  margin-top: auto;
  padding-top: 1.5rem;
  font-size: 0.9rem;
  color: var(--vert);
  transition: transform 0.25s;
}
.expertise-card:hover .expertise-arrow { transform: translateX(5px); }

/* ======================================
   MISSION
   ====================================== */
.mission {
  background: #ECECE7;
  border-top: 1px solid var(--gris-clair);
  border-bottom: 1px solid var(--gris-clair) !important;
}

.mission-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 7rem var(--gap);
}

.mission-text .eyebrow { margin-bottom: 1rem; }

.mission-text h2 {
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  line-height: 1.15;
  margin-bottom: 1.75rem;
}

.mission-text p {
  max-width: 48ch;
  margin-bottom: 2.25rem;
  font-size: 0.95rem;
}

.mission-lien {
  display: inline-block;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--vert);
  text-decoration: none;
  border: none;
  padding: 0;
  border-radius: 0;
  transition: color 0.25s;
}
.mission-lien:hover { color: var(--vert-vif); background: transparent; opacity: 1; }

.mission-quote {
  border-left: 3px solid var(--vert);
  padding: 2.5rem 2.5rem 2.5rem 2.75rem;
  background: var(--blanc);
  border-radius: 0 var(--radius) var(--radius) 0;
  box-shadow: 0 4px 32px rgba(0, 0, 0, 0.07);
}

.mission-quote p {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  font-style: italic;
  color: var(--anthracite);
  line-height: 1.75;
  max-width: none;
  margin: 0 0 1.5rem;
}

.mission-quote cite {
  display: block;
  font-size: 0.7rem;
  font-style: normal;
  color: var(--gris);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-family: var(--font-sans);
  font-weight: 600;
}

.mission-plant {
  width: 90px;
  height: auto;
  display: block;
  margin-top: 1.5rem;
  margin-left: auto;
  opacity: 0.75;
}

/* ======================================
   PILIERS
   ====================================== */
.piliers { padding: 6rem var(--gap); }
.piliers .section-header { margin-bottom: 3.5rem; }

.piliers-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem;
  flex-direction: row;
  margin-top: 0;
}

.pilier {
  padding-top: 1.75rem;
  border-top: 2px solid var(--vert);
}

.pilier-icon {
  display: block;
  width: 36px;
