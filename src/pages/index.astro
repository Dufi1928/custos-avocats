---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const expertises = await getCollection('expertises');
const sorted = expertises.sort(
  (a: CollectionEntry<'expertises'>, b: CollectionEntry<'expertises'>) =>
    (a.data.ordre ?? 99) - (b.data.ordre ?? 99)
);

const piliers = [
  {
    titre: 'Secret professionnel',
    texte: 'Tout ce que vous nous confiez est protégé sans réserve ni limite dans le temps. Cette garantie est absolue.',
    icon: `<svg viewBox="0 0 40 48" fill="none" aria-hidden="true"><rect x="6" y="20" width="28" height="22" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M 12,20 V 15 C 12,8.4 28,8.4 28,15 V 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="20" cy="31" r="3" fill="currentColor" opacity="0.6"/><line x1="20" y1="34" x2="20" y2="38" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/></svg>`,
  },
  {
    titre: 'Engagement total',
    texte: 'Chaque dossier mobilise l\'ensemble du cabinet. Cinq associés, une seule priorité : votre défense.',
    icon: `<svg viewBox="0 0 48 40" fill="none" aria-hidden="true"><path d="M 8,28 C 4,22 4,14 10,10 C 16,6 22,10 24,16 C 26,10 32,6 38,10 C 44,14 44,22 40,28 L 24,38 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>`,
  },
  {
    titre: 'Transparence totale',
    texte: 'Honoraires définis en amont par convention. Stratégie expliquée à chaque étape. Vous décidez en connaissance de cause.',
    icon: `<svg viewBox="0 0 44 44" fill="none" aria-hidden="true"><rect x="6" y="6" width="32" height="38" rx="2" stroke="currentColor" stroke-width="1.8"/><line x1="13" y1="18" x2="31" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="13" y1="25" x2="31" y2="25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="13" y1="32" x2="24" y2="32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="13" y="8" width="18" height="6" rx="1" fill="currentColor" opacity="0.12" stroke="currentColor" stroke-width="1.2"/></svg>`,
  },
];
---

<Base
  title="Accueil"
  description="Cabinet d'avocats spécialisé en droit pénal — 5 avocats associés au Barreau de Lille. Garde à vue, comparution immédiate, assises."
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <img src="/custos-avocats/plant-eucalyptus2.png" alt="" aria-hidden="true" class="plant plant-hero-palm" />
    <img src="/custos-avocats/plant-branches.png" alt="" aria-hidden="true" class="plant plant-hero-branch" />
    <img src="/custos-avocats/justice-themis.png" alt="" aria-hidden="true" class="plant justice-hero-themis" />
    <div class="hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">Droit pénal — Barreau de Lille</p>
        <h1 class="hero-title">
          La défense pénale<br />
          <em>qui ne faiblit jamais.</em>
        </h1>
        <p class="hero-subtitle">
          Cinq avocats, tous spécialisés en droit pénal — de la garde à vue
          jusqu'à la cour d'assises. Custos met son expertise collective
          au service de votre défense.
        </p>
        <div class="hero-actions">
          <a href="/custos-avocats/contact" class="hero-btn hero-btn--primaire">
            Nous contacter
          </a>
          <a href="/custos-avocats/les-valeurs-du-cabinet" class="hero-btn hero-btn--secondaire">
            Le cabinet
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="stats-strip" aria-label="Chiffres clés">
    <ul class="stats-grid">
      <li class="stat"><strong>5</strong><span>Avocats pénalistes</span></li>
      <li class="stat"><strong>100%</strong><span>Spécialisés en droit pénal</span></li>
      <li class="stat"><strong>6</strong><span>Domaines d'intervention</span></li>
      <li class="stat"><strong>Lille</strong><span>Barreau</span></li>
    </ul>
  </section>

  <!-- ============ EXPERTISES ============ -->
  <section class="expertises" aria-label="Nos domaines d'expertise">
    <header class="section-header">
      <p class="eyebrow">Ce que nous défendons</p>
      <h2>Nos domaines d'expertise</h2>
    </header>
    <ul class="expertise-grid">
      {sorted.map((e: CollectionEntry<'expertises'>) => (
        <li>
          <a
            href={`/custos-avocats/expertises/${e.data.slug}`}
            class="expertise-card"
          >
            <span class="expertise-num">
              {String(e.data.ordre ?? 0).padStart(2, '0')}
            </span>
            <h3>{e.data.title}</h3>
            <p>{e.data.focus.slice(0, 2).join(' · ')}</p>
            <span class="expertise-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ MISSION ============ -->
  <section class="mission" aria-label="Notre mission">
    <img src="/custos-avocats/plant-cascade.png" alt="" aria-hidden="true" class="plant plant-mission" />
    <div class="mission-inner">
      <div class="mission-text">
        <p class="eyebrow">Pourquoi Custos</p>
        <h2>Défendre.<br />Protéger.<br />Ne jamais abandonner.</h2>
        <p>
          Nous avons fondé Custos avec une conviction : la défense pénale exige
          autant d'humanité que d'expertise juridique. Chaque client vit une
          situation de crise. Notre rôle est de transformer cette crise en défense.
        </p>
        <a href="/custos-avocats/les-valeurs-du-cabinet" class="mission-lien">Notre mission →</a>
      </div>
      <div class="mission-deco">
        <blockquote class="mission-quote">
          <p>
            "La justice sans la force est impuissante ;
            la force sans la justice est tyrannique."
          </p>
          <cite>Blaise Pascal — Pensées</cite>
        </blockquote>

      </div>
    </div>
  </section>

  <!-- ============ PILIERS ============ -->
  <section class="piliers" aria-label="Nos engagements">
    <header class="section-header">
      <p class="eyebrow">Nos engagements</p>
      <h2>Ce sur quoi vous pouvez compter</h2>
    </header>
    <ul class="piliers-grid">
      {piliers.map(({ titre, texte, icon }) => (
        <li class="pilier">
          <span class="pilier-icon" set:html={icon}/>
          <h3>{titre}</h3>
          <p>{texte}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ ÉQUIPE PREVIEW ============ -->
  <section class="equipe-preview" aria-label="L'équipe">
    <div class="equipe-text">
      <p class="eyebrow">Cinq pénalistes associés</p>
      <h2>Tous spécialisés en droit pénal</h2>
      <p>
        Chacun de nos cinq avocats est spécialisé en droit pénal — c'est le socle
        commun du cabinet. À cela s'ajoute un second domaine d'intervention propre
        à chaque associé, pour vous accompagner dans toutes les dimensions de votre vie.
      </p>
      <a href="/custos-avocats/equipe" class="equipe-lien">Rencontrer l'équipe →</a>
    </div>
  </section>

  <!-- ============ CONTACT CTA ============ -->
  <section class="urgence-cta" aria-label="Contact">
    <img src="/custos-avocats/plant-eucalyptus.png" alt="" aria-hidden="true" class="plant plant-cta" />
    <p class="eyebrow urgence-eyebrow">Prendre rendez-vous</p>
    <h2>Besoin d'un avocat pénaliste ?</h2>
    <p>Exposez-nous votre situation. Nous vous répondons dans les meilleurs délais.</p>
    <a href="/custos-avocats/contact" class="urgence-btn">Nous contacter</a>
  </section>
</Base>

<style>
/* ---- RESET SECTIONS PLEINE LARGEUR ---- */
.hero,
.stats-strip,
.mission,
.urgence-cta {
  max-width: 100%;
  width: 100%;
  padding: 0;
  border-bottom: none;
}

/* ======================================
   HERO
   ====================================== */
/* ── Décorations botaniques communes ── */
.plant {
  position: absolute;
  pointer-events: none;
  user-select: none;
  z-index: 0;
}

/* Hero : eucalyptus bas-gauche, branches haut-droite */
.plant-hero-palm {
  bottom: -10px;
  left: -30px;
  width: 320px;
  opacity: 0.16;
  transform: scaleX(-1);
}

.plant-hero-branch {
  top: -10px;
  right: -20px;
  width: 240px;
  opacity: 0.18;
  transform: rotate(180deg) scaleX(-1);
}

/* Hero : Thémis (Lady Justice) inverted white on dark bg */
.justice-hero-themis {
  bottom: -20px;
  right: -30px;
  width: 360px;
  opacity: 0.18;
  filter: invert(1);
}

/* Mission : eucalyptus cascade coin supérieur droit */
.plant-mission {
  top: -30px;
  right: -20px;
  width: 300px;
  opacity: 0.28;
}

/* CTA bas : eucalyptus en arrière-plan centré */
.plant-cta {
  bottom: -10px;
  right: 5%;
  width: 420px;
  opacity: 0.07;
}

.hero { background: #1A1A1A; position: relative; overflow: hidden; }

.hero-inner {
  position: relative;
  z-index: 1;
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 7rem var(--gap) 6rem;
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-eyebrow {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--vert-vif);
  font-weight: 600;
  margin-bottom: 1.75rem;
  max-width: none;
  animation: heroFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.hero-title {
  font-family: var(--font-serif);
  font-size: clamp(1.9rem, 3.2vw, 3rem);
  font-weight: 700;
  line-height: 1.12;
  color: #F4F5F2;
  margin-bottom: 1.5rem;
  animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;
}

.hero-title em {
  font-style: italic;
  color: var(--vert-vif);
}

.hero-subtitle {
  font-size: 1.05rem;
  color: rgba(244, 245, 242, 0.55);
  max-width: 50ch;
  line-height: 1.8;
  margin-bottom: 2.5rem;
  animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.24s both;
}

.hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
  animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.36s both;
}

.hero-btn {
  display: inline-block;
  padding: 0.85rem 1.75rem;
  border-radius: var(--radius);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-decoration: none;
  text-transform: uppercase;
  transition: all 0.25s ease;
  border: 1px solid transparent;
}

.hero-btn--primaire {
  background: var(--vert);
  color: #F4F5F2;
  border-color: var(--vert);
}
.hero-btn--primaire:hover {
  background: var(--vert-vif);
  border-color: var(--vert-vif);
  color: #F4F5F2;
  opacity: 1;
}

.hero-btn--secondaire {
  background: transparent;
  color: rgba(244, 245, 242, 0.65);
  border-color: rgba(244, 245, 242, 0.2);
}
.hero-btn--secondaire:hover {
  border-color: rgba(244, 245, 242, 0.5);
  color: #F4F5F2;
  background: transparent;
  opacity: 1;
}


@keyframes heroFadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ======================================
   STATS
   ====================================== */
.stats-strip {
  background: var(--blanc);
  border-bottom: 1px solid var(--gris-clair);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  max-width: var(--max-width);
  margin-inline: auto;
  flex-direction: row;
  gap: 0;
  margin-top: 0;
}

.stat {
  padding: 2.5rem 2rem;
  border-right: 1px solid var(--gris-clair);
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.stat:last-child { border-right: none; }

.stat strong {
  font-family: var(--font-serif);
  font-size: 2.75rem;
  color: var(--vert);
  line-height: 1;
}

.stat span {
  font-size: 0.7rem;
  color: var(--gris);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 500;
}

/* ======================================
   EXPERTISES
   ====================================== */
.expertises { padding: 6rem var(--gap); }

.section-header { margin-bottom: 3rem; }
.section-header h2 { margin-bottom: 0; }

.eyebrow {
  display: block;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--vert);
  font-weight: 600;
  margin-bottom: 0.75rem;
  max-width: none;
}

.expertise-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  background: var(--gris-clair);
  border: 1px solid var(--gris-clair);
  border-radius: var(--radius);
  overflow: hidden;
  flex-direction: unset;
  margin-top: 0;
}

.expertise-card {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  padding: 2.25rem 2rem;
  background: var(--fond);
  text-decoration: none;
  transition: background 0.25s;
  border: none;
  border-radius: 0;
  color: var(--texte);
}
.expertise-card:hover {
  background: var(--blanc);
  color: var(--texte);
  opacity: 1;
}

.expertise-num {
  display: block;
  font-size: 0.65rem;
  color: var(--gris);
  font-weight: 500;
  letter-spacing: 0.08em;
  margin-bottom: 0.5rem;
}

.expertise-card h3 {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  color: var(--texte);
  font-weight: 700;
  margin-bottom: 0.2rem;
}

.expertise-card p {
  font-size: 0.78rem;
  color: var(--gris);
  max-width: none;
  margin: 0;
  line-height: 1.5;
}

.expertise-arrow {
  display: block;
  margin-top: auto;
  padding-top: 1.5rem;
  font-size: 0.9rem;
  color: var(--vert);
  transition: transform 0.25s;
}
.expertise-card:hover .expertise-arrow { transform: translateX(5px); }

/* ======================================
   MISSION
   ====================================== */
.mission {
  background: #ECECE7;
  border-top: 1px solid var(--gris-clair);
  border-bottom: 1px solid var(--gris-clair) !important;
  position: relative;
  overflow: hidden;
}

.mission-inner { position: relative; z-index: 1; }

.mission-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 7rem var(--gap);
}

.mission-text .eyebrow { margin-bottom: 1rem; }

.mission-text h2 {
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  line-height: 1.15;
  margin-bottom: 1.75rem;
}

.mission-text p {
  max-width: 48ch;
  margin-bottom: 2.25rem;
  font-size: 0.95rem;
}

.mission-lien {
  display: inline-block;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--vert);
  text-decoration: none;
  border: none;
  padding: 0;
  border-radius: 0;
  transition: color 0.25s;
}
.mission-lien:hover { color: var(--vert-vif); background: transparent; opacity: 1; }

.mission-quote {
  border-left: 3px solid var(--vert);
  padding: 2.5rem 2.5rem 2.5rem 2.75rem;
  background: var(--blanc);
  border-radius: 0 var(--radius) var(--radius) 0;
  box-shadow: 0 4px 32px rgba(0, 0, 0, 0.07);
}

.mission-quote p {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  font-style: italic;
  color: var(--anthracite);
  line-height: 1.75;
  max-width: none;
  margin: 0 0 1.5rem;
}

.mission-quote cite {
  display: block;
  font-size: 0.7rem;
  font-style: normal;
  color: var(--gris);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-family: var(--font-sans);
  font-weight: 600;
}

.mission-plant {
  width: 90px;
  height: auto;
  display: block;
  margin-top: 1.5rem;
  margin-left: auto;
  opacity: 0.75;
}

/* ======================================
   PILIERS
   ====================================== */
.piliers { padding: 6rem var(--gap); }
.piliers .section-header { margin-bottom: 3.5rem; }

.piliers-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem;
  flex-direction: row;
  margin-top: 0;
}

.pilier {
  padding-top: 1.75rem;
  border-top: 2px solid var(--vert);
}

.pilier-icon {
  display: block;
  width: 36px;
  height: 36px;
  color: var(--vert);
  margin-bottom: 1rem;
  opacity: 0.8;
}

.pilier-icon svg {
  width: 100%;
  height: 100%;
}

.pilier h3 {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  margin-bottom: 0.75rem;
  color: var(--texte);
}

.pilier p { font-size: 0.9rem; line-height: 1.75; max-width: none; margin: 0; }

/* ======================================
   ÉQUIPE PREVIEW
   ====================================== */
.equipe-preview { padding: 6rem var(--gap); }

.equipe-text .eyebrow { margin-bottom: 1rem; }
.equipe-text h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); margin-bottom: 1.25rem; }
.equipe-text p { max-width: 60ch; margin-bottom: 2rem; font-size: 0.95rem; }

.equipe-lien {
  display: inline-block;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--vert);
  text-decoration: none;
  border: 1px solid var(--vert);
  padding: 0.7rem 1.5rem;
  border-radius: var(--radius);
  transition: all 0.25s;
}
.equipe-lien:hover { background: var(--vert); color: var(--blanc); opacity: 1; }

/* ======================================
   URGENCE CTA
   ====================================== */
.urgence-cta {
  position: relative;
  overflow: hidden;
  background: #1A1A1A;
  padding: 7rem var(--gap);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  border-bottom: none !important;
}

.urgence-eyebrow { color: var(--vert-vif); position: relative; z-index: 1; }
.urgence-cta h2, .urgence-cta p, .urgence-btn { position: relative; z-index: 1; }

.urgence-cta h2 { color: #F4F5F2; font-size: clamp(1.75rem, 4vw, 3rem); margin: 0; }
.urgence-cta p { color: rgba(244, 245, 242, 0.45); max-width: none; margin: 0; }

.urgence-btn {
  display: inline-block;
  margin-top: 1.25rem;
  background: var(--vert);
  color: #F4F5F2;
  padding: 1rem 2.5rem;
  border-radius: var(--radius);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  text-decoration: none;
  border: 1px solid var(--vert);
  transition: background 0.25s, border-color 0.25s;
}
.urgence-btn:hover {
  background: var(--vert-vif);
  border-color: var(--vert-vif);
  color: #F4F5F2;
  opacity: 1;
}

/* ======================================
   RESPONSIVE
   ====================================== */
@media (max-width: 900px) {
  .hero-inner {
    min-height: auto;
    padding: 5rem var(--gap) 4rem;
  }
  .expertise-grid { grid-template-columns: repeat(2, 1fr); }
  .mission-inner { grid-template-columns: 1fr; gap: 3rem; padding: 5rem var(--gap); }
  .piliers-grid { grid-template-columns: 1fr; gap: 2rem; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .stat:nth-child(2) { border-right: none; }
  .stat:nth-child(3) { border-top: 1px solid var(--gris-clair); }
  .stat:nth-child(4) { border-top: 1px solid var(--gris-clair); border-right: none; }
}

@media (max-width: 600px) {
  .expertise-grid { grid-template-columns: 1fr; }
}
</style>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

if (!noMotion) {
  gsap.from('.stat', {
    scrollTrigger: { trigger: '.stats-strip', start: 'top 88%' },
    y: 25, autoAlpha: 0, duration: 0.55, stagger: 0.1, ease: 'power3.out',
  });

  gsap.from('.expertise-card', {
    scrollTrigger: { trigger: '.expertise-grid', start: 'top 82%' },
    y: 35, autoAlpha: 0, duration: 0.5, stagger: 0.06, ease: 'power3.out',
  });

  gsap.utils.toArray<HTMLElement>('.section-header').forEach((el) => {
    gsap.from(Array.from(el.children), {
      scrollTrigger: { trigger: el, start: 'top 88%' },
      y: 20, autoAlpha: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out',
    });
  });

  gsap.from('.mission-text > *', {
    scrollTrigger: { trigger: '.mission-inner', start: 'top 80%' },
    y: 30, autoAlpha: 0, duration: 0.7, stagger: 0.12, ease: 'power3.out',
  });

  gsap.from('.mission-quote', {
    scrollTrigger: { trigger: '.mission-inner', start: 'top 75%' },
    x: 40, autoAlpha: 0, duration: 0.8, ease: 'power3.out',
  });

  gsap.from('.pilier', {
    scrollTrigger: { trigger: '.piliers-grid', start: 'top 85%' },
    y: 35, autoAlpha: 0, duration: 0.6, stagger: 0.15, ease: 'power3.out',
  });

  gsap.from('.equipe-text > *', {
