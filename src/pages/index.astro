---

<Base
  title="Accueil"
  description="Cabinet d'avocats spécialisé en droit pénal — 5 avocats associés au Barreau de Lille. Garde à vue, comparution immédiate, assises."
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <img src="/plant-eucalyptus2.png" alt="" aria-hidden="true" class="plant plant-hero-palm" />
    <img src="/justice-themis-hero.png" alt="" aria-hidden="true" class="plant justice-hero-themis" />
    <div class="hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">Droit pénal — Barreau de Lille</p>
        <h1 class="hero-title">
          La défense pénale<br />
          <em>qui ne faiblit jamais.</em>
        </h1>
        <p class="hero-subtitle">
          Cinq avocats, tous spécialisés en droit pénal — de la garde à vue
          jusqu'à la cour d'assises. Custos met son expertise collective
          au service de votre défense.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="hero-btn hero-btn--primaire">
            Nous contacter
          </a>
          <a href="/les-valeurs-du-cabinet" class="hero-btn hero-btn--secondaire">
            Le cabinet
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="stats-strip" aria-label="Chiffres clés">
    <ul class="stats-grid">
      <li class="stat"><strong>5</strong><span>Avocats pénalistes</span></li>
      <li class="stat stat--sm"><strong>Spécialisés</strong><span>en droit pénal</span></li>
      <li class="stat"><strong>6</strong><span>Domaines d'intervention</span></li>
      <li class="stat stat--sm"><strong>Barreau</strong><span>de Lille</span></li>
    </ul>
  </section>

  <!-- ============ EXPERTISES ============ -->
  <section class="expertises" aria-label="Nos domaines d'expertise">
    <h2 class="expertises-titre">Nos domaines d'expertise</h2>

    {droitPenal && (
      <a
        href={`/expertises/${droitPenal.data.slug}`}
        class="expertise-card-principal"
      >
        <div>
          <p class="eyebrow expertise-socle">Socle commun du cabinet</p>
          <h3>{droitPenal.data.title}</h3>
        </div>
        <span class="expertise-principal-icon" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M 16 4 C 13.75 4 12.234375 4.886719 10.875 5.625 C 9.515625 6.363281 8.28125 7 6 7 L 5 7 L 5 8 C 5 15.71875 7.609375 20.742188 10.25 23.78125 C 12.890625 26.820313 15.625 27.9375 15.625 27.9375 L 16 28.0625 L 16.375 27.9375 C 16.375 27.9375 19.109375 26.84375 21.75 23.8125 C 24.390625 20.78125 27 15.746094 27 8 L 27 7 L 26 7 C 23.730469 7 22.484375 6.363281 21.125 5.625 C 19.765625 4.886719 18.25 4 16 4 Z M 16 6 C 17.75 6 18.753906 6.613281 20.15625 7.375 C 21.339844 8.019531 22.910156 8.636719 24.9375 8.84375 C 24.746094 15.609375 22.507813 19.910156 20.25 22.5 C 18.203125 24.847656 16.484375 25.628906 16 25.84375 C 15.511719 25.625 13.796875 24.824219 11.75 22.46875 C 9.492188 19.871094 7.253906 15.578125 7.0625 8.84375 C 9.097656 8.636719 10.660156 8.019531 11.84375 7.375 C 13.246094 6.613281 14.25 6 16 6 Z"/></svg>
        </span>
      </a>
    )}

    <p class="expertise-complementaires-label">Domaines complémentaires</p>
    <ul class="expertise-grid">
      {complementaires.map((e: CollectionEntry<'expertises'>) => (
        <li>
          <a
            href={`/expertises/${e.data.slug}`}
            class="expertise-card"
          >
            <h3>{e.data.title}</h3>
            <span class="expertise-card-icon" aria-hidden="true" set:html={domainIcons[e.data.slug] ?? ''} />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ MISSION ============ -->
  <section class="mission" aria-label="Notre mission">
    <img src="/plant-cascade.png" alt="" aria-hidden="true" class="plant plant-mission" />
    <div class="mission-inner">
      <div class="mission-text">
        <p class="eyebrow">Pourquoi Custos</p>
        <h2>Défendre.<br />Protéger.<br />Ne jamais abandonner.</h2>
        <p>
          Nous avons fondé Custos avec une conviction : la défense pénale exige
          autant d'humanité que d'expertise juridique. Chaque client vit une
          situation de crise. Notre rôle est de transformer cette crise en défense.
        </p>
        <a href="/les-valeurs-du-cabinet" class="mission-lien">Notre mission →</a>
      </div>
      <div class="mission-deco">
        <blockquote class="mission-quote">
          <p>
            « La justice ne peut être juste que si la défense est libre. »
          </p>
          <cite>Robert Badinter</cite>
        </blockquote>

      </div>
    </div>
  </section>

  <!-- ============ PILIERS ============ -->
  <section class="piliers" aria-label="Nos engagements">
    <header class="section-header">
      <h2>Nos engagements</h2>
    </header>
    <ul class="piliers-grid">
      {piliers.map(({ titre, texte, icon }) => (
        <li class="pilier">
          <span class="pilier-icon" set:html={icon}/>
          <h3>{titre}</h3>
          <p>{texte}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ ÉQUIPE PREVIEW ============ -->
  <section class="equipe-preview" aria-label="L'équipe">
    <div class="equipe-text">
      <p class="eyebrow">Cinq pénalistes associés</p>
      <h2>Tous spécialisés en droit pénal</h2>
      <p>
        Chacun de nos cinq avocats est spécialisé en droit pénal — c'est le socle
        commun du cabinet. À cela s'ajoute un second domaine d'intervention propre
        à chaque associé, pour vous accompagner dans toutes les dimensions de votre vie.
      </p>
      <a href="/equipe" class="equipe-lien">Rencontrer l'équipe →</a>
    </div>
  </section>

  <!-- ============ CONTACT CTA ============ -->
  <section class="urgence-cta" aria-label="Contact">
    <img src="/plant-eucalyptus.png" alt="" aria-hidden="true" class="plant plant-cta" />
    <h2>Besoin d'un avocat pénaliste ?</h2>
    <p>Exposez-nous votre situation. Nous vous répondons dans les meilleurs délais.</p>
    <a href="/rdv" class="urgence-btn">Prendre rendez-vous</a>
  </section>
</Base>

<style>
/* ---- RESET SECTIONS PLEINE LARGEUR ---- */
.hero,
.stats-strip,
.mission,
.urgence-cta {
  max-width: 100%;
  width: 100%;
  padding: 0;
  border-bottom: none;
}

/* ======================================
   HERO
   ====================================== */
/* ── Décorations botaniques communes ── */
.plant {
  position: absolute;
  pointer-events: none;
  user-select: none;
  z-index: 0;
}

/* Hero : eucalyptus bas-gauche, branches haut-droite */
.plant-hero-palm {
  bottom: -10px;
  left: -30px;
  width: 320px;
  opacity: 0.16;
  transform: scaleX(-1);
}

/* Hero : Thémis inversée, tracé blanc sur fond sombre */
.justice-hero-themis {
  bottom: -30px;
  right: -20px;
  width: 480px;
  opacity: 0.22;
  filter: invert(1);
}

/* Mission : eucalyptus cascade coin supérieur droit */
.plant-mission {
  top: -30px;
  right: -20px;
  width: 300px;
  opacity: 0.28;
}

/* CTA bas : eucalyptus en arrière-plan centré */
.plant-cta {
  bottom: -10px;
  right: 5%;
  width: 420px;
  opacity: 0.07;
}

.hero { background: #1A1A1A; position: relative; overflow: hidden; }

.hero-inner {
  position: relative;
  z-index: 1;
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 7rem var(--gap) 6rem;
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-eyebrow {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--vert-vif);
  font-weight: 600;
  margin-bottom: 1.75rem;
  max-width: none;
  animation: heroFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.hero-title {
  font-family: var(--font-serif);
  font-size: clamp(1.9rem, 3.2vw, 3rem);
  font-weight: 700;
  line-height: 1.12;
  color: #F4F5F2;
  margin-bottom: 1.5rem;
  animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;
}

.hero-title em {
  font-style: italic;
  color: var(--vert-vif);
}

.hero-subtitle {
  font-size: 1.05rem;
  color: rgba(244, 245, 242, 0.55);
  max-width: 50ch;
  line-height: 1.8;
  margin-bottom: 2.5rem;
  animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.24s both;
}

.hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
  animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.36s both;
}

.hero-btn {
  display: inline-block;
  padding: 0.85rem 1.75rem;
  border-radius: var(--radius);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-decoration: none;
  text-transform: uppercase;
  transition: all 0.25s ease;
  border: 1px solid transparent;
}

.hero-btn--primaire {
  background: var(--vert);
  color: #F4F5F2;
  border-color: var(--vert);
}
.hero-btn--primaire:hover {
  background: var(--vert-vif);
  border-color: var(--vert-vif);
  color: #F4F5F2;
  opacity: 1;
}

.hero-btn--secondaire {
  background: transparent;
  color: rgba(244, 245, 242, 0.65);
  border-color: rgba(244, 245, 242, 0.2);
}
.hero-btn--secondaire:hover {
  border-color: rgba(244, 245, 242, 0.5);
  color: #F4F5F2;
  background: transparent;
  opacity: 1;
}


@keyframes heroFadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ======================================
   STATS
   ====================================== */
.stats-strip {
  background: var(--blanc);
  border-bottom: 1px solid var(--gris-clair);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  max-width: var(--max-width);
  margin-inline: auto;
  flex-direction: row;
  gap: 0;
  margin-top: 0;
}

.stat {
  padding: 2.5rem 2rem;
  border-right: 1px solid var(--gris-clair);
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.stat:last-child { border-right: none; }

.stat strong {
  font-family: var(--font-serif);
  font-size: 2.75rem;
  color: var(--vert);
  line-height: 1;
}

.stat--sm strong {
  font-size: 1.5rem;
}

.stat span {
  font-size: 0.7rem;
  color: var(--gris);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 500;
}

/* ======================================
   EXPERTISES
   ====================================== */
.expertises { padding: 6rem var(--gap); }

.section-header { margin-bottom: 3rem; }
.section-header h2 { margin-bottom: 0; }
.expertises-titre { margin-bottom: 3rem; }

.expertise-card-principal {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.75rem 2rem;
  background: var(--vert);
  border-radius: 1rem;
  text-decoration: none;
  margin-bottom: 0.75rem;
  transition: background 0.25s;
  position: relative;
  overflow: hidden;
}
.expertise-card-principal:hover { background: #3a4a3e; opacity: 1; }
.expertise-card-principal h3 {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 700;
  color: #F4F5F2;
  margin: 0;
}
.expertise-socle { color: rgba(244,245,242,0.65) !important; margin-bottom: 0.3rem !important; }
.expertise-card-principal .expertise-arrow { color: rgba(244,245,242,0.7); font-size: 1.1rem; }
.expertise-card-principal:hover .expertise-arrow { transform: translateX(5px); }

.expertise-principal-icon {
  position: absolute;
  bottom: -6px;
  right: -6px;
  width: 72px;
  height: 72px;
  color: rgba(255, 255, 255, 0.15);
  pointer-events: none;
  transition: color 0.25s, transform 0.25s;
}
.expertise-principal-icon svg { width: 100%; height: 100%; }
.expertise-card-principal:hover .expertise-principal-icon {
  color: rgba(255, 255, 255, 0.26);
  transform: scale(1.08) rotate(-4deg);
}

.expertise-complementaires-label {
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--gris);
  font-weight: 600;
  margin-bottom: 0.75rem !important;
  margin-top: 1.75rem !important;
  max-width: none;
}

.eyebrow {
  display: block;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--vert);
  font-weight: 600;
  margin-bottom: 0.75rem;
  max-width: none;
}

.expertise-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 0.75rem;
  background: none;
  border: none;
  overflow: visible;
  flex-direction: unset;
  margin-top: 0;
}

/* 3 cards ligne 1 (33% chacune) + 2 cards ligne 2 (50% chacune) */
.expertise-grid > li             { grid-column: span 2; }
.expertise-grid > li:nth-child(4) { grid-column: span 3; }
.expertise-grid > li:nth-child(5) { grid-column: span 3; }

.expertise-card {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  padding: 1.75rem 1.5rem;
  background: rgba(74, 93, 78, 0.08);
  border: 1px solid rgba(74, 93, 78, 0.14);
  text-decoration: none;
  transition: background 0.25s, border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  border-radius: 1rem;
  color: var(--texte);
  height: 100%;
  animation: bubbleIn 0.5s ease both;
  position: relative;
  overflow: hidden;
}

.expertise-card-icon {
  position: absolute;
  bottom: -6px;
  right: -6px;
  width: 68px;
  height: 68px;
  color: var(--vert);
  opacity: 0.13;
  pointer-events: none;
  transition: opacity 0.25s, transform 0.25s;
}

.expertise-card-icon svg {
  width: 100%;
  height: 100%;
}

.expertise-card:hover .expertise-card-icon {
  opacity: 0.22;
  transform: scale(1.08) rotate(-4deg);
}
.expertise-card:hover {
  background: rgba(74, 93, 78, 0.14);
  border-color: rgba(74, 93, 78, 0.25);
  color: var(--texte);
  opacity: 1;
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(74, 93, 78, 0.15);
}

.expertise-grid > li:nth-child(1) .expertise-card { animation-delay: 0.05s; }
.expertise-grid > li:nth-child(2) .expertise-card { animation-delay: 0.12s; }
.expertise-grid > li:nth-child(3) .expertise-card { animation-delay: 0.19s; }
.expertise-grid > li:nth-child(4) .expertise-card { animation-delay: 0.26s; }
.expertise-grid > li:nth-child(5) .expertise-card { animation-delay: 0.33s; }

.expertise-card-principal {
  animation: bubbleIn 0.4s ease both;
}

@keyframes bubbleIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

.expertise-card h3 {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  color: var(--texte);
  font-weight: 700;
  margin: 0;
}

.expertise-arrow {
  font-size: 1rem;
  color: rgba(244,245,242,0.7);
  opacity: 0.7;
  flex-shrink: 0;
  transition: transform 0.25s, opacity 0.25s;
  line-height: 1.4;
}
.expertise-card-principal:hover .expertise-arrow { transform: translateX(5px); opacity: 1; }

/* ======================================
   MISSION
   ====================================== */
.mission {
  background: #ECECE7;
  border-top: 1px solid var(--gris-clair);
  border-bottom: 1px solid var(--gris-clair) !important;
  position: relative;
  overflow: hidden;
}

.mission-inner { position: relative; z-index: 1; }

.mission-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 7rem var(--gap);
}

.mission-text .eyebrow { margin-bottom: 1rem; }

.mission-text h2 {
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  line-height: 1.15;
  margin-bottom: 1.75rem;
}

.mission-text p {
  max-width: 48ch;
  margin-bottom: 2.25rem;
  font-size: 0.95rem;
}

.mission-lien {
  display: inline-block;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--vert);
  text-decoration: none;
  border: none;
  padding: 0;
  border-radius: 0;
  transition: color 0.25s;
}
.mission-lien:hover { color: var(--vert-vif); background: transparent; opacity: 1; }

.mission-quote {
  border-left: 3px solid var(--vert);
  padding: 2.5rem 2.5rem 2.5rem 2.75rem;
  background: var(--blanc);
  border-radius: 0 var(--radius) var(--radius) 0;
  box-shadow: 0 4px 32px rgba(0, 0, 0, 0.07);
}

.mission-quote p {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  font-style: italic;
  color: var(--anthracite);
  line-height: 1.75;
  max-width: none;
  margin: 0 0 1.5rem;
}

.mission-quote cite {
  display: block;
  font-size: 0.7rem;
  font-style: normal;
  color: var(--gris);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-family: var(--font-sans);
  font-weight: 600;
}

.mission-plant {
  width: 90px;
  height: auto;
  display: block;
  margin-top: 1.5rem;
  margin-left: auto;
  opacity: 0.75;
}

/* ======================================
   PILIERS
   ====================================== */
.piliers { padding: 6rem var(--gap); }
.piliers .section-header { margin-bottom: 3.5rem; }

.piliers-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem;
  flex-direction: row;
  margin-top: 0;
}

.pilier {
  padding-top: 1.75rem;
  border-top: 2px solid var(--vert);
}

.pilier-icon {
  display: block;
  width: 36px;
  height: 36px;
  color: var(--vert);
  margin-bottom: 1rem;
  opacity: 0.8;
}

.pilier-icon svg {
  width: 100%;
  height: 100%;
}

.pilier h3 {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  margin-bottom: 0.75rem;
  color: var(--texte);
}

.pilier p { font-size: 0.9rem; line-height: 1.75; max-width: none; margin: 0; }

/* ======================================
   ÉQUIPE PREVIEW
   ====================================== */
.equipe-preview { padding: 6rem var(--gap); }

.equipe-text .eyebrow { margin-bottom: 1rem; }
.equipe-text h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); margin-bottom: 1.25rem; }
.equipe-text p { max-width: 60ch; margin-bottom: 2rem; font-size: 0.95rem; }

.equipe-lien {
  display: inline-block;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--vert);
  text-decoration: none;
  border: 1px solid var(--vert);
  padding: 0.7rem 1.5rem;
  border-radius: var(--radius);
  transition: all 0.25s;
}
.equipe-lien:hover { background: var(--vert); color: var(--blanc); opacity: 1; }

/* ======================================
   URGENCE CTA
   ====================================== */
.urgence-cta {
  position: relative;
  overflow: hidden;
  background: #1A1A1A;
  padding: 7rem var(--gap);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  border-bottom: none !important;
}

.urgence-eyebrow { color: var(--vert-vif); position: relative; z-index: 1; }
.urgence-cta h2, .urgence-cta p, .urgence-btn { position: relative; z-index: 1; }

.urgence-cta h2 { color: #F4F5F2; font-size: clamp(1.75rem, 4vw, 3rem); margin: 0; }
.urgence-cta p { color: rgba(244, 245, 242, 0.45); max-width: none; margin: 0; }

.urgence-btn {
  display: inline-block;
  margin-top: 1.25rem;
  background: var(--vert);
  color: #F4F5F2;
  padding: 1rem 2.5rem;
  border-radius: var(--radius);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  text-decoration: none;
  border: 1px solid var(--vert);
  transition: background 0.25s, border-color 0.25s;
}
.urgence-btn:hover {
  background: var(--vert-vif);
  border-color: var(--vert-vif);
  color: #F4F5F2;
  opacity: 1;
}

/* ======================================
   RESPONSIVE
   ====================================== */
@media (max-width: 900px) {
  .hero-inner {
    min-height: auto;
    padding: 5rem var(--gap) 4rem;
  }
  .expertise-grid { grid-template-columns: repeat(2, 1fr) !important; }
  .expertise-grid > li,
  .expertise-grid > li:nth-child(4),
  .expertise-grid > li:nth-child(5) { grid-column: span 1 !important; }
  .mission-inner { grid-template-columns: 1fr; gap: 3rem; padding: 5rem var(--gap); }
  .piliers-grid { grid-template-columns: 1fr; gap: 2rem; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .stat:nth-child(2) { border-right: none; }
  .stat:nth-child(3) { border-top: 1px solid var(--gris-clair); }
  .stat:nth-child(4) { border-top: 1px solid var(--gris-clair); border-right: none; }
}

@media (max-width: 600px) {
  .expertise-grid { grid-template-columns: 1fr !important; }
  .plant-hero-palm,
  .plant-mission { display: none; }
}
</style>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

if (!noMotion) {
  gsap.from('.stat', {
    scrollTrigger: { trigger: '.stats-strip', start: 'top 88%' },
    y: 25, autoAlpha: 0, duration: 0.55, stagger: 0.1, ease: 'power3.out',
  });

  gsap.from('.expertise-card', {
    scrollTrigger: { trigger: '.expertise-grid', start: 'top 82%' },
    y: 35, autoAlpha: 0, duration: 0.5, stagger: 0.06, ease: 'power3.out',
  });

  gsap.utils.toArray<HTMLElement>('.section-header').forEach((el) => {
    gsap.from(Array.from(el.children), {
      scrollTrigger: { trigger: el, start: 'top 88%' },
      y: 20, autoAlpha: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out',
    });
  });

  gsap.from('.mission-text > *', {
    scrollTrigger: { trigger: '.mission-inner', start: 'top 80%' },
    y: 30, autoAlpha: 0, duration: 0.7, stagger: 0.12, ease: 'power3.out',
  });

  gsap.from('.mission-quote', {
    scrollTrigger: { trigger: '.mission-inner', start: 'top 75%' },
    x: 40, autoAlpha: 0, duration: 0.8, ease: 'power3.out',
  });

  gsap.from('.pilier', {
    scrollTrigger: { trigger: '.piliers-grid', start: 'top 85%' },
    y: 35, autoAlpha: 0, duration: 0.6, stagger: 0.15, ease: 'power3.out',
  });

  gsap.from('.equipe-text > *', {
    scrollTrigger: { trigger: '.equipe-preview', start: 'top 85%' },
    y: 25, autoAlpha: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out',
  });

  gsap.from('.urgence-cta > *', {
    scrollTrigger: { trigger: '.urgence-cta', start: 'top 85%' },
    y: 25, autoAlpha: 0, duration: 0.6, stagger: 0.12, ease: 'power3.out',
  });
}
</script>
