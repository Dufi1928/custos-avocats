---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const expertises = await getCollection('expertises');
const sorted = expertises.sort(
  (a: CollectionEntry<'expertises'>, b: CollectionEntry<'expertises'>) =>
    (a.data.ordre ?? 99) - (b.data.ordre ?? 99)
);
const droitPenal = sorted.find((e: CollectionEntry<'expertises'>) => e.data.slug === 'droit-penal');
const complementaires = sorted.filter((e: CollectionEntry<'expertises'>) => e.data.slug !== 'droit-penal');

const domainIcons: Record<string, string> = {
  'droit-des-mineurs': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4"/><path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/></svg>`,
  'droit-des-etrangers': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  'droit-de-la-famille': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  'droit-penal-des-affaires': `<svg viewBox="0 0 512 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M496,120H384c0-8.844-7.164-16-16-16v-16c0-26.469-21.531-48-48-48H192c-26.469,0-48,21.531-48,48v16c-8.836,0-16,7.156-16,16H16C7.164,120,0,127.156,0,136v304c0,8.844,7.164,16,16,16h48c0,8.836,7.163,16,16,16h32c8.837,0,16-7.164,16-16h256c0,8.836,7.163,16,16,16h32c8.837,0,16-7.164,16-16h48c8.836,0,16-7.156,16-16V136C512,127.156,504.836,120,496,120zM176,88c0-8.828,7.18-16,16-16h128c8.82,0,16,7.172,16,16v16c-8.836,0-16,7.156-16,16H192c0-8.844-7.164-16-16-16V88zM480,424H32V152h448V424z"/><path d="M128,376c8.836,0,16-7.156,16-16V216c0-8.844-7.164-16-16-16s-16,7.156-16,16v144C112,368.844,119.164,376,128,376z"/><path d="M384,376c8.836,0,16-7.156,16-16V216c0-8.844-7.164-16-16-16s-16,7.156-16,16v144C368,368.844,375.164,376,384,376z"/></svg>`,
  'dommages-corporels': `<svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M22,7H10C9.692,7,9.401,6.858,9.212,6.615C9.023,6.373,8.955,6.056,9.03,5.757l1-4C10.141,1.313,10.541,1,11,1h10c0.459,0,0.859,0.313,0.97,0.757l1,4c0.075,0.299,0.007,0.615-0.182,0.858C22.599,6.858,22.308,7,22,7z M11.281,5h9.438l-0.5-2h-8.438L11.281,5z"/><path d="M19,23h-6c-0.552,0-1-0.448-1-1v-2h-2c-0.552,0-1-0.448-1-1v-6c0-0.552,0.448-1,1-1h2v-2c0-0.552,0.448-1,1-1h6c0.552,0,1,0.448,1,1v2h2c0.552,0,1,0.448,1,1v6c0,0.552-0.448,1-1,1h-2v2C20,22.552,19.552,23,19,23z M14,21h4v-2c0-0.552,0.448-1,1-1h2v-4h-2c-0.552,0-1-0.448-1-1v-2h-4v2c0,0.552-0.448,1-1,1h-2v4h2c0.552,0,1,0.448,1,1V21z"/><path d="M30,27H2c-0.283,0-0.552-0.12-0.741-0.329c-0.19-0.21-0.282-0.489-0.254-0.771l2-20C3.056,5.389,3.486,5,4,5h24c0.514,0,0.944,0.389,0.995,0.9l2,20c0.028,0.281-0.064,0.561-0.254,0.771C30.552,26.88,30.283,27,30,27z M3.105,25h25.79l-1.8-18H4.905L3.105,25z"/></svg>`,
};

const piliers = [
  {
    titre: 'Secret professionnel',
    texte: 'Tout ce que vous nous confiez est protégé sans réserve ni limite dans le temps. Cette garantie est absolue.',
    icon: `<svg viewBox="0 0 40 48" fill="none" aria-hidden="true"><rect x="6" y="20" width="28" height="22" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M 12,20 V 15 C 12,8.4 28,8.4 28,15 V 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="20" cy="31" r="3" fill="currentColor" opacity="0.6"/><line x1="20" y1="34" x2="20" y2="38" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/></svg>`,
  },
  {
    titre: 'Engagement total',
    texte: 'Chaque dossier mobilise l\'ensemble du cabinet. Cinq associés, une seule priorité : votre défense.',
    icon: `<svg viewBox="0 0 48 40" fill="none" aria-hidden="true"><path d="M 8,28 C 4,22 4,14 10,10 C 16,6 22,10 24,16 C 26,10 32,6 38,10 C 44,14 44,22 40,28 L 24,38 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>`,
  },
  {
    titre: 'Transparence totale',
    texte: 'Honoraires définis en amont par convention. Stratégie expliquée à chaque étape. Vous décidez en connaissance de cause.',
    icon: `<svg viewBox="0 0 44 44" fill="none" aria-hidden="true"><rect x="6" y="6" width="32" height="38" rx="2" stroke="currentColor" stroke-width="1.8"/><line x1="13" y1="18" x2="31" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="13" y1="25" x2="31" y2="25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="13" y1="32" x2="24" y2="32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="13" y="8" width="18" height="6" rx="1" fill="currentColor" opacity="0.12" stroke="currentColor" stroke-width="1.2"/></svg>`,
  },
];
---

<Base
  title="Accueil"
  description="Cabinet d'avocats spécialisé en droit pénal — 5 avocats associés au Barreau de Lille. Garde à vue, comparution immédiate, assises."
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <img src="/plant-eucalyptus2.png" alt="" aria-hidden="true" class="plant plant-hero-palm" />
    <img src="/justice-themis-hero.png" alt="" aria-hidden="true" class="plant justice-hero-themis" />
    <div class="hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">Droit pénal — Barreau de Lille</p>
        <h1 class="hero-title">
          La défense pénale<br />
          <em>qui ne faiblit jamais.</em>
        </h1>
        <p class="hero-subtitle">
          Cinq avocats, tous spécialisés en droit pénal — de la garde à vue
          jusqu'à la cour d'assises. Custos met son expertise collective
          au service de votre défense.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="hero-btn hero-btn--primaire">
            Nous contacter
          </a>
          <a href="/les-valeurs-du-cabinet" class="hero-btn hero-btn--secondaire">
            Le cabinet
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="stats-strip" aria-label="Chiffres clés">
    <ul class="stats-grid">
      <li class="stat"><strong>5</strong><span>Avocats pénalistes</span></li>
      <li class="stat stat--sm"><strong>Spécialisés</strong><span>en droit pénal</span></li>
      <li class="stat"><strong>6</strong><span>Domaines d'intervention</span></li>
      <li class="stat stat--sm"><strong>Barreau</strong><span>de Lille</span></li>
    </ul>
  </section>

  <!-- ============ EXPERTISES ============ -->
  <section class="expertises" aria-label="Nos domaines d'expertise">
    <h2 class="expertises-titre">Nos domaines d'expertise</h2>

    {droitPenal && (
      <a
        href={`/expertises/${droitPenal.data.slug}`}
        class="expertise-card-principal"
      >
        <div>
          <p class="eyebrow expertise-socle">Socle commun du cabinet</p>
          <h3>{droitPenal.data.title}</h3>
        </div>
        <span class="expertise-arrow" aria-hidden="true">→</span>
        <span class="expertise-principal-icon" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M 16 4 C 13.75 4 12.234375 4.886719 10.875 5.625 C 9.515625 6.363281 8.28125 7 6 7 L 5 7 L 5 8 C 5 15.71875 7.609375 20.742188 10.25 23.78125 C 12.890625 26.820313 15.625 27.9375 15.625 27.9375 L 16 28.0625 L 16.375 27.9375 C 16.375 27.9375 19.109375 26.84375 21.75 23.8125 C 24.390625 20.78125 27 15.746094 27 8 L 27 7 L 26 7 C 23.730469 7 22.484375 6.363281 21.125 5.625 C 19.765625 4.886719 18.25 4 16 4 Z M 16 6 C 17.75 6 18.753906 6.613281 20.15625 7.375 C 21.339844 8.019531 22.910156 8.636719 24.9375 8.84375 C 24.746094 15.609375 22.507813 19.910156 20.25 22.5 C 18.203125 24.847656 16.484375 25.628906 16 25.84375 C 15.511719 25.625 13.796875 24.824219 11.75 22.46875 C 9.492188 19.871094 7.253906 15.578125 7.0625 8.84375 C 9.097656 8.636719 10.660156 8.019531 11.84375 7.375 C 13.246094 6.613281 14.25 6 16 6 Z"/></svg>
        </span>
      </a>
    )}

    <p class="expertise-complementaires-label">Domaines complémentaires</p>
    <ul class="expertise-grid">
      {complementaires.map((e: CollectionEntry<'expertises'>) => (
        <li>
          <a
            href={`/expertises/${e.data.slug}`}
            class="expertise-card"
          >
            <h3>{e.data.title}</h3>
            <span class="expertise-card-icon" aria-hidden="true" set:html={domainIcons[e.data.slug] ?? ''} />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ MISSION ============ -->
  <section class="mission" aria-label="Notre mission">
    <img src="/plant-cascade.png" alt="" aria-hidden="true" class="plant plant-mission" />
    <div class="mission-inner">
      <div class="mission-text">
        <p class="eyebrow">Pourquoi Custos</p>
        <h2>Défendre.<br />Protéger.<br />Ne jamais abandonner.</h2>
        <p>
          Nous avons fondé Custos avec une conviction : la défense pénale exige
          autant d'humanité que d'expertise juridique. Chaque client vit une
          situation de crise. Notre rôle est de transformer cette crise en défense.
        </p>
        <a href="/les-valeurs-du-cabinet" class="mission-lien">Notre mission →</a>
      </div>
      <div class="mission-deco">
        <blockquote class="mission-quote">
          <p>
            « La justice ne peut être juste que si la défense est libre. »
          </p>
          <cite>Robert Badinter</cite>
        </blockquote>

      </div>
    </div>
  </section>

  <!-- ============ PILIERS ============ -->
  <section class="piliers" aria-label="Nos engagements">
    <header class="section-header">
      <p class="eyebrow">Nos engagements</p>
      <h2>Ce sur quoi vous pouvez compter</h2>
    </header>
    <ul class="piliers-grid">
      {piliers.map(({ titre, texte, icon }) => (
        <li class="pilier">
          <span class="pilier-icon" set:html={icon}/>
          <h3>{titre}</h3>
          <p>{texte}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ ÉQUIPE PREVIEW ============ -->
  <section class="equipe-preview" aria-label="L'équipe">
    <div class="equipe-text">
      <p class="eyebrow">Cinq pénalistes associés</p>
      <h2>Tous spécialisés en droit pénal</h2>
      <p>
        Chacun de nos cinq avocats est spécialisé en droit pénal — c'est le socle
        commun du cabinet. À cela s'ajoute un second domaine d'intervention propre
        à chaque associé, pour vous accompagner dans toutes les dimensions de votre vie.
      </p>
      <a href="/equipe" class="equipe-lien">Rencontrer l'équipe →</a>
    </div>
  </section>

  <!-- ============ CONTACT CTA ============ -->
  <section class="urgence-cta" aria-label="Contact">
    <img src="/plant-eucalyptus.png" alt="" aria-hidden="true" class="plant plant-cta" />
    <p class="eyebrow urgence-eyebrow">Prendre rendez-vous</p>
    <h2>Besoin d'un avocat pénaliste ?</h2>
    <p>Exposez-nous votre situation. Nous vous répondons dans les meilleurs délais.</p>
    <a href="/contact" class="urgence-btn">Nous contacter</a>
  </section>
</Base>

<style>
/* ---- RESET SECTIONS PLEINE LARGEUR ---- */
.hero,
.stats-strip,
.mission,
.urgence-cta {
  max-width: 100%;
  width: 100%;
  padding: 0;
  border-bottom: none;
}

/* ======================================
   HERO
   ====================================== */
/* ── Décorations botaniques communes ── */
.plant {
  position: absolute;
  pointer-events: none;
  user-select: none;
  z-index: 0;
}

/* Hero : eucalyptus bas-gauche, branches haut-droite */
.plant-hero-palm {
  bottom: -10px;
  left: -30px;
  width: 320px;
  opacity: 0.16;
  transform: scaleX(-1);
}

/* Hero : Thémis inversée, tracé blanc sur fond sombre */
.justice-hero-themis {
  bottom: -30px;
  right: -20px;
  width: 480px;
  opacity: 0.22;
  filter: invert(1);
}

/* Mission : eucalyptus cascade coin supérieur droit */
.plant-mission {
  top: -30px;
  right: -20px;
  width: 300px;
  opacity: 0.28;
}

/* CTA bas : eucalyptus en arrière-plan centré */
.plant-cta {
  bottom: -10px;
  right: 5%;
  width: 420px;
  opacity: 0.07;
}

.hero { background: #1A1A1A; position: relative; overflow: hidden; }

.hero-inner {
  position: relative;
  z-index: 1;
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 7rem var(--gap) 6rem;
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-eyebrow {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--vert-vif);
  font-weight: 600;
  margin-bottom: 1.75rem;
  max-width: none;
  animation: heroFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.hero-title {
  font-family: var(--font-serif);
  font-size: clamp(1.9rem, 3.2vw, 3rem);
  font-weight: 700;
  line-height: 1.12;
  color: #F4F5F2;
  margin-bottom: 1.5rem;
  animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;
}

.hero-title em {
  font-style: italic;
  color: var(--vert-vif);
}

.hero-subtitle {
  font-size: 1.05rem;
  color: rgba(244, 245, 242, 0.55);
  max-width: 50ch;
  line-height: 1.8;
  margin-bottom: 2.5rem;
  animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.24s both;
}

.hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
  animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.36s both;
}

.hero-btn {
  display: inline-block;
  padding: 0.85rem 1.75rem;
  border-radius: var(--radius);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-decoration: none;
  text-transform: uppercase;
  transition: all 0.25s ease;
  border: 1px solid transparent;
}

.hero-btn--primaire {
  background: var(--vert);
  color: #F4F5F2;
  border-color: var(--vert);
}
.hero-btn--primaire:hover {
  background: var(--vert-vif);
  border-color: var(--vert-vif);
  color: #F4F5F2;
  opacity: 1;
}

.hero-btn--secondaire {
  background: transparent;
  color: rgba(244, 245, 242, 0.65);
  border-color: rgba(244, 245, 242, 0.2);
}
.hero-btn--secondaire:hover {
  border-color: rgba(244, 245, 242, 0.5);
  color: #F4F5F2;
  background: transparent;
  opacity: 1;
}


@keyframes heroFadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ======================================
   STATS
   ====================================== */
.stats-strip {
  background: var(--blanc);
  border-bottom: 1px solid var(--gris-clair);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  max-width: var(--max-width);
  margin-inline: auto;
  flex-direction: row;
  gap: 0;
  margin-top: 0;
}

.stat {
  padding: 2.5rem 2rem;
  border-right: 1px solid var(--gris-clair);
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.stat:last-child { border-right: none; }

.stat strong {
  font-family: var(--font-serif);
  font-size: 2.75rem;
  color: var(--vert);
  line-height: 1;
}

.stat--sm strong {
  font-size: 1.5rem;
}

.stat span {
  font-size: 0.7rem;
  color: var(--gris);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 500;
}

/* ======================================
   EXPERTISES
   ====================================== */
.expertises { padding: 6rem var(--gap); }

.section-header { margin-bottom: 3rem; }
.section-header h2 { margin-bottom: 0; }
.expertises-titre { margin-bottom: 3rem; }

.expertise-card-principal {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.75rem 2rem;
  background: var(--vert);
  border-radius: 1rem;
  text-decoration: none;
  margin-bottom: 0.75rem;
  transition: background 0.25s;
  position: relative;
  overflow: hidden;
}
.expertise-card-principal:hover { background: #3a4a3e; opacity: 1; }
.expertise-card-principal h3 {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 700;
  color: #F4F5F2;
  margin: 0;
}
.expertise-socle { color: rgba(244,245,242,0.65) !important; margin-bottom: 0.3rem !important; }
.expertise-card-principal .expertise-arrow { color: rgba(244,245,242,0.7); font-size: 1.1rem; }
.expertise-card-principal:hover .expertise-arrow { transform: translateX(5px); }

.expertise-principal-icon {
  position: absolute;
  bottom: -6px;
  right: -6px;
  width: 72px;
  height: 72px;
  color: rgba(255, 255, 255, 0.15);
  pointer-events: none;
  transition: color 0.25s, transform 0.25s;
}
.expertise-principal-icon svg { width: 100%; height: 100%; }
.expertise-card-principal:hover .expertise-principal-icon {
  color: rgba(255, 255, 255, 0.26);
  transform: scale(1.08) rotate(-4deg);
}

.expertise-complementaires-label {
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--gris);
  font-weight: 600;
  margin-bottom: 0.75rem !important;
  margin-top: 1.75rem !important;
  max-width: none;
}

.eyebrow {
  display: block;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--vert);
  font-weight: 600;
  margin-bottom: 0.75rem;
  max-width: none;
}

.expertise-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 0.75rem;
  background: none;
  border: none;
  overflow: visible;
  flex-direction: unset;
  margin-top: 0;
}

/* 3 cards ligne 1 (33% chacune) + 2 cards ligne 2 (50% chacune) */
.expertise-grid > li             { grid-column: span 2; }
.expertise-grid > li:nth-child(4) { grid-column: span 3; }
.expertise-grid > li:nth-child(5) { grid-column: span 3; }

.expertise-card {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  padding: 1.75rem 1.5rem;
  background: rgba(74, 93, 78, 0.08);
  border: 1px solid rgba(74, 93, 78, 0.14);
  text-decoration: none;
  transition: background 0.25s, border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  border-radius: 1rem;
  color: var(--texte);
  height: 100%;
  animation: bubbleIn 0.5s ease both;
  position: relative;
  overflow: hidden;
}

.expertise-card-icon {
  position: absolute;
  bottom: -6px;
  right: -6px;
  width: 68px;
  height: 68px;
  color: var(--vert);
  opacity: 0.13;
  pointer-events: none;
  transition: opacity 0.25s, transform 0.25s;
}

.expertise-card-icon svg {
  width: 100%;
  height: 100%;
}

.expertise-card:hover .expertise-card-icon {
  opacity: 0.22;
  transform: scale(1.08) rotate(-4deg);
}
.expertise-card:hover {
  background: rgba(74, 93, 78, 0.14);
  border-color: rgba(74, 93, 78, 0.25);
  color: var(--texte);
  opacity: 1;
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(74, 93, 78, 0.15);
}

