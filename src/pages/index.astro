---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const expertises = await getCollection('expertises');
const sorted = expertises.sort(
  (a: CollectionEntry<'expertises'>, b: CollectionEntry<'expertises'>) =>
    (a.data.ordre ?? 99) - (b.data.ordre ?? 99)
);
const droitPenal = sorted.find((e: CollectionEntry<'expertises'>) => e.data.slug === 'droit-penal');
const complementaires = sorted.filter((e: CollectionEntry<'expertises'>) => e.data.slug !== 'droit-penal');

const domainIcons: Record<string, string> = {
  'droit-des-mineurs': `<svg viewBox="0 0 512 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M305.406,269.895c6.441,4.993,14.604,7.975,23.367,7.975c8.706,0,16.826-2.938,23.252-7.867c6.426-4.928,11.246-11.846,13.54-19.872c1.498-5.268-1.556-10.762-6.824-12.259c-5.268-1.505-10.746,1.549-12.245,6.817h-0.007c-1.086,3.828-3.416,7.179-6.528,9.56c-3.126,2.38-6.94,3.777-11.188,3.777c-4.269,0-8.105-1.418-11.239-3.828c-3.119-2.41-5.449-5.811-6.513-9.675c-1.462-5.283-6.918-8.38-12.201-6.933c-5.276,1.462-8.38,6.926-6.926,12.202C294.138,257.903,298.958,264.909,305.406,269.895z"/><path d="M220.091,250.131c1.506-5.262-1.541-10.754-6.809-12.259c-5.269-1.505-10.754,1.542-12.259,6.81c-1.1,3.836-3.423,7.186-6.535,9.568c-3.126,2.38-6.94,3.777-11.188,3.777c-4.262,0-8.112-1.418-11.239-3.828c-3.126-2.41-5.45-5.811-6.513-9.675c-1.462-5.283-6.918-8.38-12.201-6.933c-5.283,1.462-8.38,6.926-6.926,12.202c2.244,8.112,7.056,15.117,13.512,20.104c6.44,4.993,14.61,7.975,23.367,7.975c8.713,0,16.826-2.938,23.244-7.867C212.978,265.075,217.804,258.157,220.091,250.131z"/><path d="M494.002,217.703c-10.052-10.066-23.715-16.666-38.818-17.773c-9.436-44.376-33.188-83.454-66.173-112.156c-36.046-31.35-83.229-50.368-134.747-50.368c-51.44,0-98.565,18.96-134.582,50.216c-33.18,28.794-57.04,68.076-66.423,112.676c-13.692,1.788-26.012,8.134-35.282,17.404C6.897,228.783,0,244.226,0,261.145c0,16.891,6.897,32.334,17.976,43.413c11.079,11.08,26.522,17.969,43.435,17.969c1.166,0,2.302-0.029,3.438-0.086c14.792,35.142,39.042,65.319,69.603,87.311c14.046,10.117,29.468,18.504,45.902,24.851c-1.983-6.94-3.004-14.227-3.004-21.652c0-3.423,0.225-6.853,0.674-10.197c-9.509-4.537-18.548-9.914-27.029-16.008c-29.077-20.921-51.577-50.476-63.734-84.851l-4.393-12.411l-12.693,3.488c-2.924,0.789-5.811,1.216-8.764,1.216c-9.176,0-17.364-3.684-23.375-9.69c-6.006-6.014-9.694-14.198-9.694-23.353c0-9.183,3.687-17.375,9.694-23.382c6.01-6.006,14.199-9.69,23.375-9.69c0.572,0,1.418,0.058,2.613,0.138l13.178,1.02l1.954-13.026c6.404-42.5