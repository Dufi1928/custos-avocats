---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const expertises = await getCollection('expertises');
const sorted = expertises.sort(
  (a: CollectionEntry<'expertises'>, b: CollectionEntry<'expertises'>) =>
    (a.data.ordre ?? 99) - (b.data.ordre ?? 99)
);
const droitPenal = sorted.find((e: CollectionEntry<'expertises'>) => e.data.slug === 'droit-penal');
const complementaires = sorted.filter((e: CollectionEntry<'expertises'>) => e.data.slug !== 'droit-penal');
---

<Base title="Domaines & Honoraires" description="Domaines d'intervention et honoraires du cabinet Custos Avocats — Droit pénal, Barreau de Lille.">

  <!-- ══ DOMAINES D'INTERVENTION ══ -->
  <section aria-label="Domaines d'intervention" class="domaines-intro">
    <img src="/plant-cascade.png" alt="" aria-hidden="true" class="plant-honoraires" />
    <div class="domaines-intro-content">
      <h1>Domaines &amp; Honoraires</h1>
      <p>
        Custos Avocats est un cabinet spécialisé en droit pénal. Chacun de nos associés
        cumule cette expertise de base avec un second domaine d'intervention, pour vous
        accompagner dans toutes les dimensions de votre vie.
      </p>
    </div>
    <ul class="domaines-grid">
      {sorted.map((e: CollectionEntry<'expertises'>) => (
        <li>
          <a href={`/expertises/${e.data.slug}`} class="domaine-card">
            <h3>{e.data.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ══ HONORAIRES ══ -->
  <section aria-label="Honoraires" class="honoraires-section">
    <h2>Honoraires</h2>
    <p class="honoraires-intro">
      Le cabinet Custos s'engage à une totale transparence sur ses honoraires.
      Une convention d'honoraires écrite est systématiquement établie avant toute intervention,
      conformément à la loi du 6 août 2015. Vous connaissez le coût de votre défense
      avant même que nous commencions à travailler.
    </p>

    <div class="honoraires-blocs">

      <div class="honoraires-bloc">
        <div class="honoraires-bloc-icon" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" width="28" height="28">
            <circle cx="20" cy="20" r="17" stroke="currentColor" stroke-width="1.6"/>
            <path d="M13 20h14M20 13v14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <h3>Premier rendez-vous</h3>
          <p>
            Le premier rendez-vous est un moment d'écoute et d'analyse, sans engagement de votre part.
            Vous exposez votre situation, nous l'examinons et vous présentons les options envisageables,
            la stratégie possible et le cadre d'intervention du cabinet.
          </p>
          <p>
            Ce rendez-vous est payant et fait l'objet d'une facturation forfaitaire,
            quelle que soit sa durée. Son montant est déduit des honoraires si vous décidez
            de confier votre dossier au cabinet.
          </p>
        </div>
      </div>

      <div class="honoraires-bloc">
        <div class="honoraires-bloc-icon" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" width="28" height="28">
            <rect x="7" y="10" width="26" height="22" rx="2" stroke="currentColor" stroke-width="1.6"/>
            <path d="M14 10V7M26 10V7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M7 18h26" stroke="currentColor" stroke-width="1.4"/>
            <path d="M14 25h4M22 25h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <h3>Honoraires au forfait</h3>
          <p>
            Pour la majorité des procédures, le cabinet propose des honoraires au forfait :
            un montant global est fixé pour l'ensemble de la procédure, quelle que soit
            la durée effective des actes accomplis. Vous savez dès le départ ce que
            votre défense vous coûtera.
          </p>
          <p>
            Le forfait est déterminé en fonction de la nature de l'affaire, de sa complexité
            et du stade de la procédure. Il est formalisé dans la convention d'honoraires
            signée avant tout acte. Un complément d'honoraires peut être prévu contractuellement
            en cas de développement imprévisible du dossier.
          </p>
        </div>
      </div>

      <div class="honoraires-bloc">
        <div class="honoraires-bloc-icon" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" width="28" height="28">
            <path d="M20 7v4M20 29v4M7 20h4M29 20h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="20" cy="20" r="8" stroke="currentColor" stroke-width="1.6"/>
            <path d="M17 20.5l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <h3>Aide juridictionnelle</h3>
          <p>
            Le cabinet accepte les dossiers pris en charge par l'aide juridictionnelle (AJ),
            totale ou partielle. L'AJ permet aux personnes dont les ressources sont insuffisantes
            de bénéficier d'une prise en charge par l'État de tout ou partie des honoraires d'avocat.
          </p>
          <p>
            La demande d'aide juridictionnelle se fait auprès du Bureau d'Aide Juridictionnelle (BAJ)
            du tribunal compétent. Le cabinet vous accompagne dans cette démarche si nécessaire.
            L'admission à l'AJ n'affecte pas la qualité de la défense qui vous est apportée :
            chaque dossier bénéficie du même niveau d'engagement, quelle que soit la modalité
            de prise en charge des honoraires.
          </p>
        </div>
      </div>

    </div>

    <div class="honoraires-cta">
      <p>Une question sur nos honoraires ou votre éligibilité à l'aide juridictionnelle ?</p>
      <a href="/contact" class="honoraires-btn">Prendre rendez-vous</a>
    </div>
  </section>

</Base>

<style>
  /* ── Plant decoration ── */
  .domaines-intro {
    position: relative;
    overflow: hidden;
  }

  .domaines-intro-content {
    position: relative;
    z-index: 1;
  }

  .plant-honoraires {
    position: absolute;
    top: -30px;
    right: -15px;
    width: 180px;
    opacity: 0.18;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* ── Grille domaines ── */
  .domaines-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    background: none;
    border: none;
    overflow: visible;
    margin-top: 0 !important;
    flex-direction: unset !important;
  }

  .domaine-card {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.6rem 1.25rem;
    background: #dde8de;
    border: 1.5px solid #b8cebb;
    text-decoration: none;
    color: var(--texte);
    transition: background 0.22s, border-color 0.22s, transform 0.22s, box-shadow 0.22s;
    border-radius: 1rem;
    height: 100%;
    box-shadow: 0 2px 8px rgba(74, 93, 78, 0.1);
    animation: bubbleIn 0.5s ease both;
  }
  .domaine-card:hover {
    background: #ccdace;
    border-color: #9ab89e;
    color: var(--texte);
    opacity: 1;
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(74, 93, 78, 0.2);
  }

  .domaines-grid > li:nth-child(1) .domaine-card { animation-delay: 0.04s; }
  .domaines-grid > li:nth-child(2) .domaine-card { animation-delay: 0.09s; }
  .domaines-grid > li:nth-child(3) .domaine-card { animation-delay: 0.14s; }
  .domaines-grid > li:nth-child(4) .domaine-card { animation-delay: 0.19s; }
  .domaines-grid > li:nth-child(5) .domaine-card { animation-delay: 0.24s; }
  .domaines-grid > li:nth-child(6) .domaine-card { animation-delay: 0.29s; }

  @keyframes bubbleIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .domaine-card h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--texte);
    margin: 0;
  }

  @media (max-width: 640px) {
    .domaines-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 380px) {
    .domaines-grid { grid-template-columns: 1fr !important; }
  }

  /* ── Section honoraires ── */
  .honoraires-section { }

  .honoraires-intro {
    max-width: 68ch;
    color: var(--anthracite);
    line-height: 1.75;
    margin-bottom: 2.5rem !important;
  }

  .honoraires-blocs {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .honoraires-bloc {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-left: 3px solid var(--vert);
    border-radius: var(--radius);
    padding: 1.75rem 2rem;
  }

  .honoraires-bloc-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    background: rgba(74, 93, 78, 0.08);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vert);
    margin-top: 0.15rem;
  }

  .honoraires-bloc h3 {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--texte);
    margin: 0 0 0.75rem 0;
  }

  .honoraires-bloc p {
    font-size: 0.9rem;
    color: var(--anthracite);
    line-height: 1.75;
    margin: 0 0 0.6rem 0 !important;
    max-width: none;
  }

  .honoraires-bloc p:last-child { margin-bottom: 0 !important; }

  .honoraires-cta {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .honoraires-cta p {
    font-size: 0.9rem;
    color: var(--gris);
    margin: 0 !important;
    max-width: none;
  }

  .honoraires-btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    background: var(--vert);
    color: #F4F5F2;
    text-decoration: none;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.875rem;
    transition: background 0.25s;
  }

  .honoraires-btn:hover {
    background: #3a4a3e;
    color: #F4F5F2;
    opacity: 1;
  }

  @media (max-width: 560px) {
    .honoraires-bloc { flex-direction: column; gap: 1rem; }
    .honoraires-bloc-icon { width: 38px; height: 38px; }
  }
</style>
