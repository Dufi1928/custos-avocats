---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const expertises = await getCollection('expertises');
const sorted = expertises.sort(
  (a: CollectionEntry<'expertises'>, b: CollectionEntry<'expertises'>) =>
    (a.data.ordre ?? 99) - (b.data.ordre ?? 99)
);
const droitPenal = sorted.find((e: CollectionEntry<'expertises'>) => e.data.slug === 'droit-penal');
const complementaires = sorted.filter((e: CollectionEntry<'expertises'>) => e.data.slug !== 'droit-penal');
---

<Base title="Domaines & Honoraires" description="Domaines d'intervention et honoraires du cabinet Custos Avocats — Droit pénal, Barreau de Lille.">

  <!-- ══ DOMAINES D'INTERVENTION ══ -->
  <section aria-label="Domaines d'intervention" class="domaines-intro">
    <img src="/custos-avocats/plant-cascade.png" alt="" aria-hidden="true" class="plant-honoraires" />
    <div class="domaines-intro-content">
      <h1>Domaines &amp; Honoraires</h1>
      <p>
        Custos Avocats est un cabinet spécialisé en droit pénal. Chacun de nos associés
        cumule cette expertise de base avec un second domaine d'intervention, pour vous
        accompagner dans toutes les dimensions de votre vie.
      </p>
    </div>
    {droitPenal && (
      <>
        <p class="domaine-socle-label">Socle commun du cabinet</p>
        <a href={`/custos-avocats/expertises/${droitPenal.data.slug}`} class="domaine-card-principal">
          <h3>{droitPenal.data.title}</h3>
          <span class="domaine-card-cta">Découvrir</span>
        </a>
      </>
    )}

    <p class="domaine-complementaires-label">Domaines complémentaires</p>

    <ul class="domaines-grid">
      {complementaires.map((e: CollectionEntry<'expertises'>) => (
        <li>
          <a href={`/custos-avocats/expertises/${e.data.slug}`} class="domaine-card">
            <h3>{e.data.title}</h3>
            <span class="domaine-card-cta">Découvrir</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ══ HONORAIRES ══ -->
  <section aria-label="Introduction honoraires">
    <h2>Honoraires</h2>
    <p>
      Le cabinet Custos s'engage à une totale transparence sur ses honoraires.
      Une convention d'honoraires écrite est systématiquement établie avant toute intervention,
      conformément à la loi du 6 août 2015.
    </p>
    <p>
      Les grilles tarifaires détaillées sont consultables directement sur la page de chaque
      domaine ci-dessus. En cas de difficultés de règlement, un paiement échelonné peut être
      convenu. L'aide juridictionnelle est acceptée sous conditions de ressources.
    </p>
    <a href="/custos-avocats/contact">Prendre rendez-vous</a>
  </section>

</Base>

<style>
  /* ── Plant decoration ── */
  .domaines-intro {
    position: relative;
    overflow: hidden;
  }

  .domaines-intro-content {
    position: relative;
    z-index: 1;
  }

  .plant-honoraires {
    position: absolute;
    top: -30px;
    right: -15px;
    width: 180px;
    opacity: 0.18;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* ── Label socle ── */
  .domaine-socle-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--vert);
    font-weight: 700;
    margin-top: 2rem !important;
    margin-bottom: 0.6rem !important;
    max-width: none;
  }

  /* ── Carte droit pénal principale ── */
  .domaine-card-principal {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem 2.5rem;
    background: var(--vert);
    border-radius: 1rem;
    text-decoration: none;
    transition: background 0.25s, transform 0.25s, box-shadow 0.25s;
    animation: bubbleIn 0.4s ease both;
  }
  .domaine-card-principal:hover {
    background: #3a4a3e;
    opacity: 1;
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(74, 93, 78, 0.3);
  }
  .domaine-card-principal h3 {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #F4F5F2;
    margin: 0;
    text-align: center;
  }

  .domaine-complementaires-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--gris);
    font-weight: 600;
    margin-top: 1.75rem !important;
    margin-bottom: 0.75rem !important;
    max-width: none;
  }

  /* ── Grille domaines complémentaires ── */
  .domaines-grid {
    display: grid !important;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.75rem;
    background: none;
    border: none;
    overflow: visible;
    margin-top: 0 !important;
    flex-direction: unset !important;
  }

  .domaines-grid > li { grid-column: span 2; }
  .domaines-grid > li:nth-child(4) { grid-column: 2 / 4; }
  .domaines-grid > li:nth-child(5) { grid-column: 4 / 6; }

  .domaine-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.35rem;
    padding: 1.75rem 1.5rem;
    background: rgba(74, 93, 78, 0.08);
    border: 1px solid rgba(74, 93, 78, 0.14);
    text-decoration: none;
    color: var(--texte);
    transition: background 0.25s, border-color 0.25s, transform 0.25s, box-shadow 0.25s;
    border-radius: 1rem;
    height: 100%;
    animation: bubbleIn 0.5s ease both;
  }
  .domaine-card:hover {
    background: rgba(74, 93, 78, 0.14);
    border-color: rgba(74, 93, 78, 0.25);
    color: var(--texte);
    opacity: 1;
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(74, 93, 78, 0.15);
  }

  .domaines-grid > li:nth-child(1) .domaine-card { animation-delay: 0.05s; }
  .domaines-grid > li:nth-child(2) .domaine-card { animation-delay: 0.12s; }
  .domaines-grid > li:nth-child(3) .domaine-card { animation-delay: 0.19s; }
  .domaines-grid > li:nth-child(4) .domaine-card { animation-delay: 0.26s; }
  .domaines-grid > li:nth-child(5) .domaine-card { animation-delay: 0.33s; }

  @keyframes bubbleIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .domaine-card h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--texte);
    margin: 0;
  }

  .domaine-card-cta {
    display: inline-block;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--vert);
  }
  .domaine-card-principal .domaine-card-cta {
    color: rgba(244,245,242,0.75);
    padding-top: 0;
  }

  @media (max-width: 760px) {
    .domaines-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    .domaines-grid > li,
    .domaines-grid > li:nth-child(4),
    .domaines-grid > li:nth-child(5) { grid-column: span 1 !important; }
  }

  @media (max-width: 480px) {
    .domaines-grid { grid-template-columns: 1fr !important; }
  }
</style>
