---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const expertises = await getCollection('expertises');
const sorted = expertises.sort(
  (a: CollectionEntry<'expertises'>, b: CollectionEntry<'expertises'>) =>
    (a.data.ordre ?? 99) - (b.data.ordre ?? 99)
);
---

<Base title="Domaines & Honoraires" description="Domaines d'intervention et grille tarifaire du cabinet Custos Avocats — Droit pénal, Barreau de Lille.">

  <!-- ══ DOMAINES D'INTERVENTION ══ -->
  <section aria-label="Domaines d'intervention">
    <h1>Domaines &amp; Honoraires</h1>
    <p>
      Custos Avocats est un cabinet spécialisé en droit pénal. Chacun de nos associés
      cumule cette expertise de base avec un second domaine d'intervention, pour vous
      accompagner dans toutes les dimensions de votre vie.
    </p>
    <ul class="domaines-grid">
      {sorted.map((e: CollectionEntry<'expertises'>) => (
        <li>
          <a href={`/custos-avocats/expertises/${e.data.slug}`} class="domaine-card">
            <span class="domaine-num">{String(e.data.ordre ?? 0).padStart(2, '0')}</span>
            <h3>{e.data.title}</h3>
            <p>{e.data.focus.slice(0, 2).join(' · ')}</p>
            <span class="domaine-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ══ HONORAIRES ══ -->
  <section aria-label="Introduction honoraires">
    <h2>Honoraires</h2>
    <p>
      Le cabinet Custos s'engage à une totale transparence sur ses honoraires.
      Une convention d'honoraires écrite est systématiquement établie avant toute intervention,
      conformément à la loi du 6 août 2015. Les fourchettes ci-dessous sont indicatives
      et peuvent être adaptées selon la complexité du dossier et la situation du client.
    </p>
    <p>
      En cas de difficultés de règlement, un paiement échelonné peut être convenu.
      L'aide juridictionnelle est acceptée sous conditions de ressources.
    </p>
  </section>

  <section aria-label="Premier entretien">
    <h2>Premier entretien</h2>
    <p>
      Le premier entretien est facturé. Il vous permet d'exposer votre situation et
      d'obtenir une première analyse juridique approfondie.
      Si l'entretien aboutit à l'ouverture d'un dossier, les honoraires versés pour
      ce rendez-vous sont intégralement déduits du coût de la procédure.
    </p>
  </section>

  <!-- ══════════════════════════════════════
       PARTIE CIVILE / VICTIME
  ══════════════════════════════════════ -->
  <section aria-label="Honoraires partie civile">
    <h2>Partie civile — Victime</h2>

    <div class="tarif-groupe">
      <h3>Plainte avec constitution de partie civile</h3>
      <ul class="tarif-liste">
        <li class="tarif-item">
          <div>
            <strong>Juridiction correctionnelle</strong>
            <p>Rédaction, dépôt et suivi de l'instruction</p>
          </div>
          <span class="tarif-prix">1 000 – 2 500 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Juridiction criminelle</strong>
            <p>Rédaction, dépôt et suivi de l'instruction</p>
          </div>
          <span class="tarif-prix">2 000 – 4 500 €</span>
        </li>
      </ul>
    </div>

    <div class="tarif-groupe">
      <h3>Représentation à l'audience</h3>
      <ul class="tarif-liste">
        <li class="tarif-item">
          <div>
            <strong>Tribunal de police</strong>
            <p>Représentation de la victime</p>
          </div>
          <span class="tarif-prix">400 – 700 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Tribunal correctionnel</strong>
            <p>Représentation, demande de dommages-intérêts</p>
          </div>
          <span class="tarif-prix">600 – 1 200 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Tribunal pour enfants</strong>
            <p>Victime d'une infraction commise par un mineur</p>
          </div>
          <span class="tarif-prix">600 – 1 100 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Cour criminelle départementale</strong>
            <p>Représentation de la victime</p>
          </div>
          <span class="tarif-prix">1 800 – 3 500 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Cour d'assises</strong>
            <p>Représentation de la victime ou des ayants droit</p>
          </div>
          <span class="tarif-prix">2 500 – 5 000 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Cour d'appel</strong>
            <p>Appel correctionnel en tant que partie civile</p>
          </div>
          <span class="tarif-prix">1 000 – 2 000 €</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       PRÉVENU / ACCUSÉ
  ══════════════════════════════════════ -->
  <section aria-label="Honoraires personne mise en cause">
    <h2>Personne mise en cause — Prévenu / Accusé</h2>

    <div class="tarif-groupe">
      <h3>Phase d'enquête</h3>
      <ul class="tarif-liste">
        <li class="tarif-item">
          <div>
            <strong>Garde à vue — semaine</strong>
            <p>Entretien initial, assistance durant la mesure</p>
          </div>
          <span class="tarif-prix">500 – 800 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Garde à vue — week-end / nuit / jours fériés</strong>
            <p>Majoration pour astreinte hors horaires</p>
          </div>
          <span class="tarif-prix">750 – 1 100 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Audition libre</strong>
            <p>Convocation OPJ sans mise en garde à vue</p>
          </div>
          <span class="tarif-prix">400 – 700 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Délégué du procureur</strong>
            <p>Rappel à la loi, classement sous conditions, stage</p>
          </div>
          <span class="tarif-prix">350 – 550 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Médiation pénale</strong>
            <p>Représentation et participation à la séance</p>
          </div>
          <span class="tarif-prix">500 – 800 €</span>
        </li>
      </ul>
    </div>

    <div class="tarif-groupe">
      <h3>Instruction</h3>
      <ul class="tarif-liste">
        <li class="tarif-item">
          <div>
            <strong>Instruction correctionnelle — sans détention provisoire</strong>
            <p>Suivi complet jusqu'à l'ordonnance de renvoi</p>
          </div>
          <span class="tarif-prix">1 200 – 2 000 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Instruction correctionnelle — avec détention provisoire</strong>
            <p>Demandes de mise en liberté, suivi et renvoi</p>
          </div>
          <span class="tarif-prix">2 000 – 3 500 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Instruction criminelle</strong>
            <p>Suivi complet jusqu'à l'arrêt de mise en accusation</p>
          </div>
          <span class="tarif-prix">4 000 – 7 000 €</span>
        </li>
      </ul>
    </div>

    <div class="tarif-groupe">
      <h3>Audiences pénales — Adultes</h3>
      <ul class="tarif-liste">
        <li class="tarif-item">
          <div>
            <strong>Tribunal de police</strong>
            <p>Contraventions de 5e classe</p>
          </div>
          <span class="tarif-prix">600 – 1 000 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Tribunal correctionnel</strong>
            <p>Délits — préparation et plaidoirie</p>
          </div>
          <span class="tarif-prix">900 – 1 800 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Comparution immédiate</strong>
            <p>Urgence — étude rapide du dossier et plaidoirie</p>
          </div>
          <span class="tarif-prix">900 – 1 500 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>CRPC — audience d'homologation</strong>
            <p>Négociation de la peine proposée et homologation</p>
          </div>
          <span class="tarif-prix">550 – 900 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Cour criminelle départementale</strong>
            <p>Crimes punis de 15 à 20 ans — sans jury populaire</p>
          </div>
          <span class="tarif-prix">2 500 – 4 500 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Cour d'assises</strong>
            <p>Crimes punis de réclusion — avec jury populaire</p>
          </div>
          <span class="tarif-prix">3 500 – 7 000 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>JIRS</strong>
            <p>Crime organisé, grand trafic de stupéfiants</p>
          </div>
          <span class="tarif-prix">4 500 – 8 500 €</span>
        </li>
      </ul>
    </div>

    <div class="tarif-groupe">
      <h3>Audiences pénales — Mineurs</h3>
      <ul class="tarif-liste">
        <li class="tarif-item">
          <div>
            <strong>Juge des enfants — audience de cabinet</strong>
            <p>Mesures éducatives, RRSE, admonestation</p>
          </div>
          <span class="tarif-prix">600 – 1 000 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Tribunal pour enfants</strong>
            <p>Audience collégiale — mineur prévenu ou partie civile</p>
          </div>
          <span class="tarif-prix">1 000 – 1 800 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Cour d'assises des mineurs</strong>
            <p>Crimes commis par un mineur — avec jury</p>
          </div>
          <span class="tarif-prix">3 500 – 7 000 €</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       VOIES DE RECOURS
  ══════════════════════════════════════ -->
  <section aria-label="Voies de recours">
    <h2>Voies de recours</h2>
    <ul class="tarif-liste">
      <li class="tarif-item">
        <div>
          <strong>Chambre de l'instruction</strong>
          <p>Appel des ordonnances JI, appel de détention en instruction</p>
        </div>
        <span class="tarif-prix">1 000 – 2 000 €</span>
      </li>
      <li class="tarif-item">
        <div>
          <strong>Cour d'appel — correctionnel</strong>
          <p>Mémoire et audience chambre des appels correctionnels</p>
        </div>
        <span class="tarif-prix">1 500 – 2 800 €</span>
      </li>
      <li class="tarif-item">
        <div>
          <strong>Cour d'appel — criminel (assises d'appel)</strong>
          <p>Nouveau procès devant jury — charge de travail élevée</p>
        </div>
        <span class="tarif-prix">4 500 – 8 500 €</span>
      </li>
    </ul>
  </section>

  <!-- ══════════════════════════════════════
       JAP / JLD / DÉTENTION
  ══════════════════════════════════════ -->
  <section aria-label="Application des peines et détention">
    <h2>Application des peines &amp; Détention</h2>

    <div class="tarif-groupe">
      <h3>Juge de l'application des peines (JAP)</h3>
      <ul class="tarif-liste">
        <li class="tarif-item">
          <div>
            <strong>Audience devant le JAP</strong>
            <p>Aménagement de peine, libération conditionnelle, SME…</p>
          </div>
          <span class="tarif-prix">500 – 900 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Chambre des appels de l'application des peines (CHAAP)</strong>
            <p>Appel des décisions du JAP</p>
          </div>
          <span class="tarif-prix">750 – 1 200 €</span>
        </li>
      </ul>
    </div>

    <div class="tarif-groupe">
      <h3>Juge des libertés et de la détention (JLD)</h3>
      <ul class="tarif-liste">
        <li class="tarif-item">
          <div>
            <strong>Audience JLD</strong>
            <p>Débat contradictoire sur placement / maintien en détention</p>
          </div>
          <span class="tarif-prix">600 – 900 €</span>
        </li>
      </ul>
    </div>

    <div class="tarif-groupe">
      <h3>Discipline pénitentiaire</h3>
      <ul class="tarif-liste">
        <li class="tarif-item">
          <div>
            <strong>Commission de discipline en maison d'arrêt</strong>
            <p>Assistance à l'audience disciplinaire</p>
          </div>
          <span class="tarif-prix">500 – 800 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Requête en annulation — sanction disciplinaire</strong>
            <p>Recours devant le tribunal administratif</p>
          </div>
          <span class="tarif-prix">700 – 1 200 €</span>
        </li>
        <li class="tarif-item">
          <div>
            <strong>Requête en indemnisation — détention provisoire injustifiée</strong>
            <p>Saisine du premier président de la cour d'appel</p>
          </div>
          <span class="tarif-prix">1 500 – 3 000 €</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       NOTES & CONDITIONS
  ══════════════════════════════════════ -->
  <section aria-label="Notes et conditions tarifaires">
    <h2>Notes &amp; Conditions</h2>
    <ul class="notes-liste">
      <li>Tous les tarifs sont exprimés <strong>TTC (TVA 20 % incluse)</strong>. Les débours sont facturés en sus : déplacements hors Métropole lilloise, copies, actes d'huissier, frais d'expertise.</li>
      <li>Les voies de recours font l'objet d'un <strong>avenant</strong> à la convention d'honoraires initiale et ne sont pas incluses dans le forfait de première instance.</li>
      <li>Conformément à la loi n° 2015-990 du 6 août 2015, une <strong>convention d'honoraires écrite</strong> est établie avant toute intervention. Les fourchettes sont indicatives et peuvent être adaptées selon la complexité du dossier et la situation financière du client.</li>
      <li>En cas de difficultés de règlement, un <strong>paiement échelonné</strong> peut être convenu.</li>
      <li>L'<strong>aide juridictionnelle</strong> est acceptée sous conditions de ressources.</li>
    </ul>
    <a href="/custos-avocats/contact">Prendre rendez-vous</a>
  </section>

</Base>

<style>
  /* ── Grille domaines ── */
  .domaines-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    background: var(--gris-clair);
    border: 1px solid var(--gris-clair);
    border-radius: var(--radius);
    overflow: hidden;
    margin-top: 2rem !important;
    flex-direction: unset !important;
  }

  .domaine-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.75rem 1.5rem;
    background: var(--fond);
    text-decoration: none;
    color: var(--texte);
    transition: background 0.25s;
    border: none;
    border-radius: 0;
  }
  .domaine-card:hover { background: var(--blanc); color: var(--texte); opacity: 1; }

  .domaine-num {
    font-size: 0.62rem;
    color: var(--gris);
    letter-spacing: 0.08em;
    font-weight: 500;
    margin-bottom: 0.3rem;
  }

  .domaine-card h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--texte);
    margin: 0;
  }

  .domaine-card p {
    font-size: 0.75rem;
    color: var(--gris);
    margin: 0;
    max-width: none;
    line-height: 1.4;
  }

  .domaine-arrow {
    display: block;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.85rem;
    color: var(--vert);
    transition: transform 0.25s;
  }
  .domaine-card:hover .domaine-arrow { transform: translateX(4px); }

  @media (max-width: 640px) {
    .domaines-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Groupes tarifaires ── */
  .tarif-groupe {
    margin-top: 2rem;
  }

  .tarif-groupe h3 {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--vert);
    font-weight: 700;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--gris-clair);
  }

  /* ── Lignes tarifaires ── */
  .tarif-liste {
    display: flex !important;
    flex-direction: column !important;
    gap: 0 !important;
    margin-top: 0 !important;
  }

  .tarif-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--gris-clair);
  }

  .tarif-item:last-child {
    border-bottom: none;
  }

  .tarif-item > div {
    flex: 1;
  }

  .tarif-item strong {
    display: block;
    font-size: 0.9rem;
    color: var(--texte);
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .tarif-item p {
    font-size: 0.8rem;
    color: var(--gris);
    margin: 0;
    max-width: none;
    line-height: 1.4;
  }

  .tarif-prix {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--vert);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Notes ── */
  .notes-liste {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.75rem !important;
    margin-top: 1rem !important;
    margin-bottom: 2rem;
    list-style: disc !important;
    padding-left: 1.25rem;
  }

  .notes-liste li {
    font-size: 0.875rem;
    color: var(--anthracite);
    line-height: 1.65;
  }

  @media (max-width: 560px) {
    .tarif-item {
      flex-direction: column;
      gap: 0.4rem;
    }
    .tarif-prix {
      font-size: 1rem;
    }
  }
</style>
