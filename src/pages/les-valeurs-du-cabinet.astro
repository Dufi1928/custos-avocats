---
import Base from '../layouts/Base.astro';

const axes = [
  {
    num: '01',
    titre: 'Préserver et protéger les droits de la défense',
    couleur: 'axe--defense',
    items: [
      {
        titre: 'Intervention en garde à vue',
        texte: 'Disponibles 24h/24 pour intervenir dès la première heure de garde à vue. Le droit à l\'assistance d\'un avocat est immédiat — nous y répondons.',
        tag: 'Urgence : +33 X XX XX XX XX',
        urgent: true,
      },
      {
        titre: 'Assistance à tous les stades de la procédure',
        texte: 'De l\'enquête préliminaire jusqu\'à la cour d\'assises, en passant par l\'instruction et le tribunal correctionnel, le cabinet est présent à chaque audience.',
        urgent: false,
      },
      {
        titre: 'Stratégie de défense sur-mesure',
        texte: 'Chaque dossier est analysé dans sa singularité. La défense que nous construisons est pensée pour votre situation — jamais standardisée.',
        urgent: false,
      },
      {
        titre: 'Contradictoire et accès au dossier',
        texte: 'Nous veillons au respect du principe du contradictoire à chaque étape. Vous êtes informé, consulté, et au cœur de chaque décision stratégique.',
        urgent: false,
      },
    ],
  },
  {
    num: '02',
    titre: 'Accompagner les victimes d\'infractions pénales',
    couleur: 'axe--victimes',
    items: [
      {
        titre: 'Constitution de partie civile',
        texte: 'Nous vous assistons pour faire valoir vos droits en tant que victime : dépôt de plainte, constitution de partie civile, suivi de l\'information judiciaire.',
        urgent: false,
      },
      {
        titre: 'Évaluation et chiffrage des préjudices',
        texte: 'L\'indemnisation juste exige une expertise fine. Nous évaluons l\'ensemble de vos préjudices — corporels, moraux, matériels — pour en obtenir la réparation intégrale.',
        urgent: false,
      },
      {
        titre: 'Accompagnement dans le parcours judiciaire',
        texte: 'La justice pénale est complexe et longue. Nous vous guidons à chaque étape du processus : enquête, instruction, audience — avec clarté et bienveillance.',
        urgent: false,
      },
      {
        titre: 'Présence aux audiences',
        texte: 'Nous plaidons vos intérêts devant toutes les juridictions pénales. Votre parole est portée avec force, votre souffrance reconnue.',
        urgent: false,
      },
    ],
  },
  {
    num: '03',
    titre: 'Garantir l\'accès au droit pour tous',
    couleur: 'axe--acces',
    items: [
      {
        titre: 'Aide juridictionnelle acceptée',
        texte: 'Nous acceptons l\'aide juridictionnelle totale ou partielle. La qualité de la défense ne doit pas être conditionnée aux seules ressources financières.',
        urgent: false,
      },
      {
        titre: 'Paiement échelonné',
        texte: 'En cas de difficultés financières, un paiement en plusieurs fois peut être convenu. Nous trouverons ensemble une solution adaptée à votre situation.',
        urgent: false,
      },
      {
        titre: 'Convention d\'honoraires transparente',
        texte: 'Conformément à la loi du 6 août 2015, une convention d\'honoraires écrite est établie avant toute intervention. Le coût de la défense est clair dès le départ.',
        urgent: false,
      },
      {
        titre: 'Consultation accessible',
        texte: 'Un premier rendez-vous pour comprendre votre situation, poser vos questions, évaluer les options. Sans engagement, sans jargon.',
        urgent: false,
      },
    ],
  },
];
---

<Base title="Valeurs du cabinet" description="Mission, engagements et raison d'être du cabinet Custos Avocats — spécialisé en droit pénal au Barreau de Lille.">

  <!-- ══ INTRO ══ -->
  <section aria-label="Mission du cabinet" class="valeurs-intro">
    <img src="/custos-avocats/plant-cascade.png" alt="" aria-hidden="true" class="plant-deco plant-right" />
    <img src="/custos-avocats/justice-balance.png" alt="" aria-hidden="true" class="plant-deco justice-balance" />
    <div class="valeurs-intro-content">
      <p class="eyebrow">Le cabinet</p>
      <h1>Valeurs du cabinet</h1>
      <p class="intro-lead">
        Custos Avocats est un cabinet à mission. Notre activité professionnelle est guidée
        par une raison d'être qui dépasse la seule défense technique : accompagner la personne,
        dans toutes les dimensions de l'épreuve qu'elle traverse.
      </p>
    </div>
  </section>

  <!-- ══ RAISON D'ÊTRE ══ -->
  <section aria-label="Raison d'être" class="raison-section">
    <p class="raison-label">Notre raison d'être</p>
    <blockquote class="raison-quote">
      Accompagner durablement le justiciable dans le contentieux pénal et les épreuves
      juridiques et humaines complémentaires qu'il traverse — au-delà de la seule
      procédure pénale.
    </blockquote>
  </section>

  <!-- ══ LES 3 AXES ══ -->
  {axes.map((axe) => (
    <section aria-label={axe.titre} class={`axe-section ${axe.couleur}`}>
      <header class="axe-header">
        <span class="axe-num">{axe.num}</span>
        <h2>{axe.titre}</h2>
      </header>
      <ul class="axe-grid">
        {axe.items.map(({ titre, texte, tag, urgent }) => (
          <li class={`axe-item${urgent ? ' axe-item--urgent' : ''}`}>
            <h3>{titre}</h3>
            <p>{texte}</p>
            {urgent && tag && (
              <span class="axe-tag">{tag}</span>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <!-- ══ CTA ══ -->
  <section aria-label="Prendre contact" class="cta-section">
    <h2>Une situation à analyser ?</h2>
    <p>
      Un premier rendez-vous pour faire le point — sans engagement, sans jargon.
      Nous sommes là pour répondre à vos questions et définir ensemble la meilleure approche.
    </p>
    <a href="/custos-avocats/contact" class="cta-btn">Nous contacter</a>
  </section>

</Base>

<style>
  /* ── Décorations intro ── */
  .valeurs-intro {
    position: relative;
    overflow: hidden;
  }

  .valeurs-intro-content {
    position: relative;
    z-index: 1;
  }

  .plant-deco {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .plant-right {
    top: -20px;
    right: -10px;
    width: 200px;
    opacity: 0.22;
  }

  .justice-balance {
    bottom: -10px;
    left: -10px;
    width: 260px;
    opacity: 0.2;
  }

  .eyebrow {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--vert);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .intro-lead {
    max-width: 62ch;
    color: var(--anthracite);
    line-height: 1.75;
  }

  @media (max-width: 640px) {
    .plant-right, .justice-balance { display: none; }
  }

  /* ── Raison d'être ── */
  .raison-section {
    background: var(--blanc);
    border-left: 4px solid var(--vert);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 2rem 2.5rem;
    box-shadow: 0 2px 20px rgba(0,0,0,0.05);
  }

  .raison-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--vert);
    font-weight: 700;
    margin-bottom: 0.85rem !important;
    max-width: none;
  }

  .raison-quote {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--anthracite);
    line-height: 1.75;
    margin: 0;
    max-width: 64ch;
  }

  /* ── Sections axes ── */
  .axe-section {
    padding-top: 0.5rem;
  }

  .axe-header {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .axe-num {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--vert);
    opacity: 0.18;
    line-height: 1;
    flex-shrink: 0;
  }

  .axe-header h2 {
    margin: 0;
  }

  .axe-grid {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem !important;
    margin-top: 0 !important;
    flex-direction: unset !important;
    background: none !important;
    border: none !important;
    overflow: visible !important;
  }

  .axe-item {
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-top: 3px solid var(--vert);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .axe-item--urgent {
    border-top-color: #c0392b;
  }

  .axe-item h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--texte);
    margin: 0;
  }

  .axe-item p {
    font-size: 0.875rem;
    color: var(--anthracite);
    line-height: 1.7;
    margin: 0;
    max-width: none;
  }

  .axe-tag {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #c0392b;
    background: rgba(192, 57, 43, 0.08);
    border: 1px solid rgba(192, 57, 43, 0.2);
    border-radius: 4px;
    padding: 0.25rem 0.6rem;
  }

  /* ── CTA ── */
  .cta-section {
    text-align: center;
  }

  .cta-section p {
    max-width: 50ch;
    margin-inline: auto;
    color: var(--anthracite);
  }

  .cta-btn {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.85rem 2rem;
    background: var(--vert);
    color: #F4F5F2;
    text-decoration: none;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.9rem;
    transition: background 0.25s;
  }

  .cta-btn:hover {
    background: #3a4a3e;
    color: #F4F5F2;
    opacity: 1;
  }
</style>
