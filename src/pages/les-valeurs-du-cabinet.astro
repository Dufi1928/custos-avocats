---
import Base from '../layouts/Base.astro';

const axes = [
  {
    num: '01',
    titre: 'Préserver et protéger les droits de la défense',
    items: [
      {
        titre: 'Disponibilité 24h/24',
        texte: 'Instaurer une disponibilité de défense pour les auteurs dès que le cabinet est fermé : soir, nuit et week-end.',
        urgent: false,
      },
      {
        titre: 'Formation continue ciblée',
        texte: 'Se former à des problématiques ciblées d\'auteurs d\'infractions : 2 formations spécifiques par membre du cabinet et par an.',
        urgent: false,
      },
      {
        titre: 'Mémo des droits',
        texte: 'Transmission systématique au client d\'un mémo de ses droits selon sa situation, grâce à la création d\'un livret actualisé.',
        urgent: false,
      },
      {
        titre: 'Orientation vers des structures de soins',
        texte: 'Accompagner et orienter les auteurs vers des structures de soins adaptées, via des conclusions de partenariat avec ces structures.',
        urgent: false,
      },
    ],
  },
  {
    num: '02',
    titre: 'Accompagner les victimes d\'infractions pénales',
    items: [
      {
        titre: 'Justice restaurative',
        texte: 'Proposer la justice restaurative aux victimes : production de documentation à leur destination et explication de ce dispositif, lorsqu\'il est adapté à leur situation.',
        urgent: false,
      },
      {
        titre: 'Associations d\'aide aux victimes',
        texte: 'Orientation et proposition d\'accompagnement vers des associations d\'aide aux victimes, avec une réunion de coordination tous les 2 mois.',
        urgent: false,
      },
      {
        titre: 'Formation à l\'accueil des victimes',
        texte: 'Se former spécifiquement à l\'accueil et à l\'accompagnement des victimes : 2 formations ciblées par membre du cabinet et par an.',
        urgent: false,
      },
      {
        titre: 'Orientation vers des structures de soins',
        texte: 'Accompagner et orienter les victimes vers des structures de soins adaptées, via des conclusions de partenariat avec ces structures.',
        urgent: false,
      },
    ],
  },
  {
    num: '03',
    titre: 'Garantir l\'accès au droit pour tous',
    items: [
      {
        titre: 'Veille juridique générale',
        texte: 'Maintenir une veille juridique régulière : 2 articles par mois en droit pénal, et 1 article par mois sur chacune des autres matières proposées par le cabinet.',
        urgent: false,
      },
      {
        titre: 'Aide juridictionnelle',
        texte: 'Au moins 40 % des dossiers traités dans le cadre de l\'aide juridictionnelle. La qualité de la défense ne peut dépendre des seules ressources financières.',
        urgent: false,
      },
      {
        titre: 'Accessibilité PMR',
        texte: 'Garantir l\'accessibilité aux personnes à mobilité réduite : rampes d\'accès PMR et sanitaires adaptés au sein du cabinet.',
        urgent: false,
      },
      {
        titre: 'Permanences juridiques gratuites',
        texte: 'Participer aux permanences juridiques pour consultation gratuite : une permanence par mois, ouverte à tous.',
        urgent: false,
      },
    ],
  },
];
---

<Base title="Valeurs du cabinet" description="Mission, engagements et raison d'être du cabinet Custos Avocats — spécialisé en droit pénal au Barreau de Lille.">

  <!-- ══ INTRO ══ -->
  <section aria-label="Mission du cabinet" class="valeurs-intro">
    <img src="/plant-cascade.png" alt="" aria-hidden="true" class="plant-deco plant-right" />
    <img src="/justice-balance.png" alt="" aria-hidden="true" class="plant-deco justice-balance" />
    <div class="valeurs-intro-content">
      <p class="eyebrow">Le cabinet</p>
      <h1>Valeurs du cabinet</h1>
      <p class="intro-lead">
        Custos Avocats est un cabinet à mission. Notre activité professionnelle est guidée
        par une raison d'être qui dépasse la seule défense technique : accompagner la personne,
        dans toutes les dimensions de l'épreuve qu'elle traverse.
      </p>
    </div>
  </section>

  <!-- ══ RAISON D'ÊTRE ══ -->
  <section aria-label="Raison d'être" class="raison-section">
    <p class="raison-label">Raison d'être du cabinet</p>
    <blockquote class="raison-quote">
      Accompagner durablement le justiciable dans le contentieux pénal et les épreuves
      juridiques et humaines complémentaires qu'il traverse, au-delà de la procédure pénale.
    </blockquote>
  </section>

  <!-- ══ LES 3 OBJECTIFS ══ -->
  {axes.map((axe) => (
    <section aria-label={axe.titre} class="axe-section">
      <header class="axe-header">
        <span class="axe-num">{axe.num}</span>
        <h2>{axe.titre}</h2>
      </header>
      <ul class="axe-grid">
        {axe.items.map(({ titre, texte, tag, urgent }) => (
          <li class={`axe-item${urgent ? ' axe-item--urgent' : ''}`}>
            <h3>{titre}</h3>
            <p>{texte}</p>
            {urgent && tag && (
              <span class="axe-tag">{tag}</span>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <!-- ══ CTA ══ -->
  <section aria-label="Prendre contact" class="cta-section">
    <h2>Une situation à analyser ?</h2>
    <p>
      Un premier rendez-vous pour faire le point, sans engagement, sans jargon.
      Nous sommes là pour répondre à vos questions et définir ensemble la meilleure approche.
    </p>
    <a href="/contact" class="cta-btn">Nous contacter</a>
  </section>

</Base>

<style>
  /* ── Décorations intro ── */
  .valeurs-intro {
    position: relative;
    overflow: hidden;
  }

  .valeurs-intro-content {
    position: relative;
    z-index: 1;
  }

  .plant-deco {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .plant-right {
    top: -20px;
    right: -10px;
    width: 200px;
    opacity: 0.22;
  }

  .justice-balance {
    bottom: -10px;
    left: -10px;
    width: 260px;
    opacity: 0.2;
  }

  .eyebrow {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--vert);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .intro-lead {
    max-width: 62ch;
    color: var(--anthracite);
    line-height: 1.75;
  }

  @media (max-width: 640px) {
    .plant-right, .justice-balance { display: none; }
  }

  /* ── Raison d'être ── */
  .raison-section {
    background: var(--blanc);
    border-left: 4px solid var(--vert);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 2rem 2.5rem;
    box-shadow: 0 2px 20px rgba(0,0,0,0.05);
  }

  .raison-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--vert);
    font-weight: 700;
    margin-bottom: 0.85rem !important;
    max-width: none;
  }

  .raison-quote {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--anthracite);
    line-height: 1.75;
    margin: 0;
    max-width: 64ch;
  }

  /* ── Sections axes ── */
  .axe-section {
    padding-top: 0.5rem;
  }

  .axe-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    margin-bottom: 2rem;
    text-align: left;
  }

  .axe-num {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--vert);
    opacity: 0.5;
  }

  .axe-header h2 {
    margin: 0;
    text-align: left;
  }

  .axe-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem !important;
    margin-top: 0 !important;
    background: none !important;
    border: none !important;
    overflow: visible !important;
  }

  .axe-grid > li:nth-child(4) {
    grid-column: 2 / 3;
  }

  @media (max-width: 760px) {
    .axe-grid { grid-template-columns: repeat(2, 1fr) !important; }
    .axe-grid > li:nth-child(4) { grid-column: 1 / 3; }
  }

  @media (max-width: 480px) {
    .axe-grid { grid-template-columns: 1fr !important; }
    .axe-grid > li:nth-child(4) { grid-column: auto; }
  }

  .axe-item {
    background: var(--blanc);
    border: 1px solid var(--gris-clair);
    border-top: 3px solid var(--vert);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .axe-item--urgent {
    border-top-color: #c0392b;
  }

  .axe-item h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--texte);
    margin: 0;
  }

  .axe-item p {
    font-size: 0.875rem;
    color: var(--anthracite);
    line-height: 1.7;
    margin: 0;
    max-width: none;
  }

  .axe-tag {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #c0392b;
    background: rgba(192, 57, 43, 0.08);
    border: 1px solid rgba(192, 57, 43, 0.2);
    border-radius: 4px;
    padding: 0.25rem 0.6rem;
  }

  /* ── CTA ── */
  .cta-section {
    text-align: center;
  }

  .cta-section p {
    max-width: 50ch;
    margin-inline: auto;
    color: var(--anthracite);
  }

  .cta-btn {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.85rem 2rem;
    background: var(--vert);
    color: #F4F5F2;
    text-decoration: none;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.9rem;
    transition: background 0.25s;
  }

  .cta-btn:hover {
    background: #3a4a3e;
    color: #F4F5F2;
    opacity: 1;
  }
</style>
