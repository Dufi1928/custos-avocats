---
import Base from '../layouts/Base.astro';
import CardAvocat from '../components/CardAvocat.astro';

const avocats = [
  {
    nom: 'Maître Rachel ROETYNCK',
    specialite: 'Droit des Mineurs',
    description: 'Intervient dans la défense des mineurs en conflit avec la loi, l\'assistance éducative et les procédures devant le juge des enfants.',
    expertiseHref: '/custos-avocats/expertises/droit-des-mineurs',
  },
  {
    nom: 'Maître Lauriana DAVRILLON',
    specialite: 'Droit de la Famille',
    description: 'Défend les clients dans les procédures de divorce conflictuel, les violences intrafamiliales et les litiges relatifs à l\'autorité parentale.',
    expertiseHref: '/custos-avocats/expertises/droit-de-la-famille',
  },
  {
    nom: 'Maître Alexis HAROUNE',
    specialite: 'Droit Pénal des Affaires',
    description: 'Assiste dirigeants et entreprises face aux enquêtes financières, poursuites pour abus de biens sociaux, fraude fiscale et compliance.',
    expertiseHref: '/custos-avocats/expertises/droit-penal-des-affaires',
  },
  {
    nom: 'Maître Lola DAVID',
    specialite: 'Dommages Corporels',
    description: 'Défend les victimes d\'accidents corporels et les accompagne de l\'expertise médicale jusqu\'à l\'obtention d\'une indemnisation juste.',
    expertiseHref: '/custos-avocats/expertises/dommages-corporels',
  },
  {
    nom: 'Maître Chloé JAULIN-DENISSELLE',
    specialite: 'Droit des Étrangers',
    description: 'Accompagne les personnes étrangères face aux procédures d\'éloignement, recours OQTF, titres de séjour et régularisation.',
    expertiseHref: '/custos-avocats/expertises/droit-des-etrangers',
  },
];

const secretaires = [
  {
    nom: '[Prénom NOM]',
    description: 'Secrétaire juridique — Gestion des dossiers, accueil et coordination administrative du cabinet.',
  },
  {
    nom: '[Prénom NOM]',
    description: 'Secrétaire juridique — Gestion des dossiers, accueil et coordination administrative du cabinet.',
  },
];
---

<Base title="Notre équipe" description="Cinq avocats associés au Barreau de Lille, tous spécialisés en droit pénal, avec chacun un second domaine d'intervention.">
  <section aria-label="Présentation de l'équipe">
    <h1>Nos Avocats Associés</h1>
    <p>
      Custos Avocats est un cabinet spécialisé en droit pénal. Chacun de nos cinq associés,
      membres du Barreau de Lille, partage ce socle commun et y ajoute un second domaine
      d'intervention — pour vous accompagner dans tous les pans de votre vie.
    </p>
  </section>

  <section aria-label="Les avocats du cabinet">
    {avocats.map((avocat) => (
      <CardAvocat
        nom={avocat.nom}
        specialite={avocat.specialite}
        description={avocat.description}
        expertiseHref={avocat.expertiseHref}
      />
    ))}
  </section>

  <section aria-label="Secrétariat juridique">
    <h2>Secrétariat juridique</h2>
    <p>Notre équipe administrative assure l'accueil, le suivi des dossiers et la coordination du cabinet.</p>
    <ul class="secretaires-grid">
      {secretaires.map(({ nom, description }) => (
        <li class="card secretaire-card">
          <header>
            <h3>{nom}</h3>
            <p>Secrétaire juridique</p>
          </header>
          <p>{description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .secretaires-grid {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    flex-direction: unset !important;
    margin-top: 1.5rem !important;
  }

  .secretaire-card header p {
    color: var(--gris);
    font-size: 0.875rem;
  }
</style>
