---
import Base from '../layouts/Base.astro';
import CardAvocat from '../components/CardAvocat.astro';

const avocats = [
  {
    nom: 'Maître Rachel ROETYNCK',
    specialite: 'Droit des Mineurs',
    description: 'Intervient dans la défense des mineurs en conflit avec la loi, l\'assistance éducative et les procédures devant le juge des enfants.',
    expertiseHref: '/expertises/droit-des-mineurs',
    photo: '/avocat-rachel.jpg',
  },
  {
    nom: 'Maître Lauriana DAVRILLON',
    specialite: 'Droit de la Famille',
    description: 'Défend les clients dans les procédures de divorce conflictuel, les violences intrafamiliales et les litiges relatifs à l\'autorité parentale.',
    expertiseHref: '/expertises/droit-de-la-famille',
    photo: '/avocat-lauriana.jpg',
  },
  {
    nom: 'Maître Alexis HAROUNE',
    specialite: 'Droit Pénal des Affaires',
    description: 'Assiste dirigeants et entreprises face aux enquêtes financières, poursuites pour abus de biens sociaux, fraude fiscale et compliance.',
    expertiseHref: '/expertises/droit-penal-des-affaires',
    photo: '/avocat-alexis.jpg',
  },
  {
    nom: 'Maître Lola DAVID',
    specialite: 'Dommages Corporels',
    description: 'Défend les victimes d\'accidents corporels et les accompagne de l\'expertise médicale jusqu\'à l\'obtention d\'une indemnisation juste.',
    expertiseHref: '/expertises/dommages-corporels',
    photo: '/avocat-lola.jpg',
  },
  {
    nom: 'Maître Chloé JAULIN-DENISSELLE',
    specialite: 'Droit des Étrangers',
    description: 'Accompagne les personnes étrangères face aux procédures d\'éloignement, recours OQTF, titres de séjour et régularisation.',
    expertiseHref: '/expertises/droit-des-etrangers',
    photo: '/avocat-chloe.jpg',
  },
];

const secretaires = [
  {
    nom: '[Prénom NOM]',
    description: 'Secrétaire juridique — Gestion des dossiers, accueil et coordination administrative du cabinet.',
  },
  {
    nom: '[Prénom NOM]',
    description: 'Secrétaire juridique — Gestion des dossiers, accueil et coordination administrative du cabinet.',
  },
];
---

<Base title="Équipe" description="Cinq avocats associés au Barreau de Lille, tous spécialisés en droit pénal, avec chacun un second domaine d'intervention.">
  <section aria-label="Présentation de l'équipe" class="equipe-intro">
    <img src="/custos-avocats/plant-cascade.png" alt="" aria-hidden="true" class="plant-corner" />
    <h1>Nos Avocats Associés</h1>
    <p>
      Custos Avocats est un cabinet spécialisé en droit pénal. Chacun de nos cinq associés,
      membres du Barreau de Lille, partage ce socle commun et y ajoute un second domaine
      d'intervention — pour vous accompagner dans tous les pans de votre vie.
    </p>

    <!-- Photo de groupe -->
    <div class="photo-groupe">
      <img
        src="/equipe-custos.jpg"
        alt="Les cinq associés du cabinet Custos Avocats"
        class="photo-groupe-img"
        width="1510"
        height="930"
        loading="eager"
      />
    </div>
  </section>

  <section aria-label="Les avocats du cabinet" class="avocats-grid-section">
    {avocats.map((avocat) => (
      <CardAvocat
        nom={avocat.nom}
        specialite={avocat.specialite}
        description={avocat.description}
        expertiseHref={avocat.expertiseHref}
        photo={avocat.photo}
      />
    ))}
  </section>

  <section aria-label="Secrétariat juridique">
    <h2>Secrétariat juridique</h2>
    <p>Notre équipe administrative assure l'accueil, le suivi des dossiers et la coordination du cabinet.</p>
    <ul class="secretaires-grid">
      {secretaires.map(({ nom, description }) => (
        <li class="card secretaire-card">
          <div class="secretaire-photo" aria-label={`Photo de ${nom}`}>
            <svg viewBox="0 0 80 80" fill="none" aria-hidden="true">
              <circle cx="40" cy="30" r="16" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <path d="M 10,72 C 10,52 70,52 70,72" stroke="currentColor" stroke-width="1.5" opacity="0.4" fill="none" stroke-linecap="round"/>
            </svg>
            <span>Photo à venir</span>
          </div>
          <header>
            <h3>{nom}</h3>
            <p>Secrétaire juridique</p>
          </header>
          <p>{description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .equipe-intro {
    position: relative;
    overflow: hidden;
  }

  .plant-corner {
    position: absolute;
    top: -20px;
    right: -10px;
    width: 220px;
    opacity: 0.22;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .equipe-intro > :not(.plant-corner) {
    position: relative;
    z-index: 1;
  }

  /* Photo de groupe */
  .secretaire-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--fond);
    border: 1.5px dashed var(--gris-clair);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--gris);
    margin-bottom: 1rem;
  }

  .secretaire-photo svg {
    width: 40px;
    height: 40px;
    color: var(--gris-clair);
  }

  .secretaire-photo span {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gris-clair);
    font-weight: 600;
  }

  /* Photo de groupe */
  .photo-groupe {
    width: 100%;
    margin-top: 2rem;
    border-radius: var(--radius);
    overflow: hidden;
    line-height: 0;
  }

  .photo-groupe-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
  }

  /* Grille des avocats : 3 puis 2 centrés */
  .avocats-grid-section {
    display: grid !important;
    grid-template-columns: repeat(6, 1fr) !important;
    gap: 1.5rem !important;
    padding-top: 4rem !important;
    padding-bottom: 4rem !important;
  }

  .avocats-grid-section > :global(*) {
    grid-column: span 2;
  }

  /* 4e et 5e cartes centrées sur la 2e ligne */
  .avocats-grid-section > :global(*:nth-child(4)) {
    grid-column: 2 / 4;
  }

  .avocats-grid-section > :global(*:nth-child(5)) {
    grid-column: 4 / 6;
  }

  @media (max-width: 860px) {
    .avocats-grid-section {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    .avocats-grid-section > :global(*),
    .avocats-grid-section > :global(*:nth-child(4)),
    .avocats-grid-section > :global(*:nth-child(5)) {
      grid-column: span 1;
    }
  }

  @media (max-width: 500px) {
    .avocats-grid-section {
      grid-template-columns: 1fr !important;
    }
  }

  .secretaires-grid {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    flex-direction: unset !important;
    margin-top: 1.5rem !important;
  }

  .secretaire-card header p {
    color: var(--gris);
    font-size: 0.875rem;
  }
</style>
